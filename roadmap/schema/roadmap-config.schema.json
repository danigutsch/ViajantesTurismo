{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Roadmap configuration",
  "type": "object",
  "required": [
    "schemaVersion",
    "sourceOfTruth",
    "itemIdPrefix",
    "allowed",
    "project",
    "scoring",
    "integrations"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "sourceOfTruth": {
      "const": "repository"
    },
    "itemIdPrefix": {
      "type": "string",
      "minLength": 1
    },
    "allowed": {
      "type": "object",
      "required": [
        "types",
        "statuses"
      ],
      "properties": {
        "types": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "statuses": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "scoring": {
      "type": "object",
      "required": [
        "model",
        "formula"
      ],
      "properties": {
        "model": {
          "const": "RICE"
        },
        "formula": {
          "const": "reach * impact * confidence / effort"
        },
        "ranges": {
          "type": "object",
          "properties": {
            "reach": {
              "type": "string"
            },
            "impact": {
              "type": "string"
            },
            "confidence": {
              "type": "string"
            },
            "effort": {
              "type": "string"
            }
          }
        }
      }
    },
    "project": {
      "type": "object",
      "required": [
        "ordering",
        "blockedBy",
        "closedStatuses"
      ],
      "properties": {
        "ordering": {
          "const": "order"
        },
        "blockedBy": {
          "const": "blockedBy"
        },
        "closedStatuses": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "integrations": {
      "type": "object",
      "properties": {
        "github": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "repository": {
              "type": "string"
            },
            "sourceOfTruth": {
              "const": "projection"
            },
            "projectV2": {
              "type": "object",
              "required": [
                "id",
                "owner",
                "number"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "owner": {
                  "type": "string",
                  "minLength": 1
                },
                "number": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      }
    }
  }
}
