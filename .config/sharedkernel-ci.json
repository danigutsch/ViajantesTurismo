{
  "version": 1,
  "solution": "ViajantesTurismo.slnx",
  "selection": {
    "fullValidation": [
      ".config/*",
      ".github/workflows/*",
      ".github/actions/*",
      ".github/dependabot.yml",
      ".github/actionlint.yaml",
      "*.props",
      "*.targets",
      "*.slnx",
      ".editorconfig",
      ".gitattributes",
      ".markdownlint-cli2.jsonc",
      ".markdownlint.json",
      "global.json",
      "NuGet.Config",
      "opencode.json",
      "scripts/*",
      "setup-dev.ps1",
      "setup-dev.sh",
      "tests/testconfig.json",
      "tests/xunit.runner.json"
    ],
    "documentation": [
      "docs/*.md",
      "docs/*.png",
      "docs/*.jpg",
      "docs/*.svg",
      "README.md",
      "AGENTS.md",
      "CONTRIBUTING.md",
      "SECURITY.md",
      ".github/*.md",
      ".github/ISSUE_TEMPLATE/*",
      ".github/agents/*",
      ".github/instructions/*",
      ".github/prompts/*",
      ".agents/*",
      ".claude/*",
      "roadmap/items/*",
      "roadmap/order.json",
      "roadmap/themes/*",
      "roadmap/README.md",
      "observability/README.md",
      "LICENSE.txt",
      "SUPPORT.md",
      "ViajantesTurismo.code-workspace",
      "ViajantesTurismo.sln.DotSettings",
      ".idea/*",
      ".gitignore",
      ".git-blame-ignore-revs",
      ".gitleaks.toml",
      ".markdownlintignore",
      ".mcp.json",
      ".aspire/settings.json",
      "CODEOWNERS",
      "docs/architecture/*.json",
      "tests/AGENTS.md",
      "tests/ASSEMBLY_FIXTURE_GUIDANCE.md",
      "tests/BDD_GUIDE.md",
      "tests/REQNROLL_GUIDE.md",
      "tests/TEST_FIXTURE_SEAM.md",
      "tests/performance/*"
    ],
    "alwaysSelected": [
      "tests/ViajantesTurismo.ArchitectureTests/ViajantesTurismo.ArchitectureTests.csproj"
    ],
    "requireCoveringTests": true,
    "testPaths": [
      {
        "paths": [
          "roadmap/config.json",
          "roadmap/schema/*",
          "roadmap/reconciliation/*"
        ],
        "tests": [
          "tests/ViajantesTurismo.ArchitectureTests/ViajantesTurismo.ArchitectureTests.csproj"
        ]
      },
      {
        "paths": [
          "observability/*"
        ],
        "tests": [
          "tests/ViajantesTurismo.ArchitectureTests/ViajantesTurismo.ArchitectureTests.csproj",
          "tests/ViajantesTurismo.HostedTests/ViajantesTurismo.HostedTests.csproj"
        ]
      },
      {
        "paths": [
          "tests/fixtures/media-accessibility/*"
        ],
        "tests": [
          "tests/ViajantesTurismo.Catalog.UnitTests/ViajantesTurismo.Catalog.UnitTests.csproj"
        ]
      }
    ]
  },
  "slices": [
    {
      "name": "fast-validation-1",
      "projects": [
        "tests/ViajantesTurismo.Catalog.UnitTests/ViajantesTurismo.Catalog.UnitTests.csproj",
        "tests/ViajantesTurismo.Admin.ApiServiceTests/ViajantesTurismo.Admin.ApiServiceTests.csproj",
        "tests/ViajantesTurismo.Branding.InfrastructureTests/ViajantesTurismo.Branding.InfrastructureTests.csproj",
        "tests/ViajantesTurismo.Admin.UnitTests/ViajantesTurismo.Admin.UnitTests.csproj",
        "tests/ViajantesTurismo.Admin.ContractTests/ViajantesTurismo.Admin.ContractTests.csproj",
        "tests/ViajantesTurismo.Catalog.ContractTests/ViajantesTurismo.Catalog.ContractTests.csproj",
        "tests/ViajantesTurismo.Branding.ContractTests/ViajantesTurismo.Branding.ContractTests.csproj",
        "tests/ViajantesTurismo.ServiceDefaults.Tests/ViajantesTurismo.ServiceDefaults.Tests.csproj",
        "tests/ViajantesTurismo.DatabaseObservability.Tests/ViajantesTurismo.DatabaseObservability.Tests.csproj"
      ],
      "openApi": [
        "admin",
        "branding",
        "catalog"
      ]
    },
    {
      "name": "fast-validation-2",
      "projects": [
        "tests/ViajantesTurismo.Management.WebTests/ViajantesTurismo.Management.WebTests.csproj",
        "tests/ViajantesTurismo.ArchitectureTests/ViajantesTurismo.ArchitectureTests.csproj",
        "tests/ViajantesTurismo.Architecture.Analyzers.Tests/ViajantesTurismo.Architecture.Analyzers.Tests.csproj",
        "tests/ViajantesTurismo.Public.WebTests/ViajantesTurismo.Public.WebTests.csproj",
        "tests/ViajantesTurismo.Catalog.ApiServiceTests/ViajantesTurismo.Catalog.ApiServiceTests.csproj",
        "tests/ViajantesTurismo.Admin.BehaviorTests/ViajantesTurismo.Admin.BehaviorTests.csproj",
        "tests/ViajantesTurismo.Catalog.BehaviorTests/ViajantesTurismo.Catalog.BehaviorTests.csproj",
        "tests/ViajantesTurismo.Admin.UiIntegrationTests/ViajantesTurismo.Admin.UiIntegrationTests.csproj"
      ]
    },
    {
      "name": "hosted-tests",
      "projects": [
        "tests/ViajantesTurismo.HostedTests/ViajantesTurismo.HostedTests.csproj"
      ],
      "playwright": {
        "project": "tests/ViajantesTurismo.HostedTests/ViajantesTurismo.HostedTests.csproj",
        "browsers": [
          "chromium"
        ],
        "onlyShell": true
      }
    }
  ],
  "openApi": [
    {
      "name": "admin",
      "project": "src/ViajantesTurismo.Admin.ApiService/ViajantesTurismo.Admin.ApiService.csproj",
      "generateProperty": "GenerateAdminOpenApiArtifacts",
      "refreshProperty": "RefreshAdminOpenApiArtifacts"
    },
    {
      "name": "branding",
      "project": "src/ViajantesTurismo.Catalog.ApiService/ViajantesTurismo.Catalog.ApiService.csproj",
      "generateProperty": "GenerateBrandingOpenApiArtifacts",
      "refreshProperty": "RefreshBrandingOpenApiArtifacts"
    },
    {
      "name": "catalog",
      "project": "src/ViajantesTurismo.Catalog.ApiService/ViajantesTurismo.Catalog.ApiService.csproj",
      "generateProperty": "GenerateCatalogOpenApiArtifacts",
      "refreshProperty": "RefreshCatalogOpenApiArtifacts"
    }
  ],
  "coverage": {
    "thresholdPercent": 80,
    "include": [
      "src/*.cs",
      "src/*.razor"
    ],
    "exclude": [
      "*/Migrations/*",
      "*/obj/*",
      "*.g.cs",
      "*.generated.cs",
      "src/ViajantesTurismo.AppHost/*"
    ],
    "symbolDirectories": [
      "src"
    ]
  },
  "mutation": {
    "strykerVersion": "5.0.0",
    "configFiles": [
      "tests/ViajantesTurismo.Catalog.UnitTests/stryker-domain-config.json",
      "tests/ViajantesTurismo.Catalog.UnitTests/stryker-application-config.json",
      "tests/ViajantesTurismo.Admin.UnitTests/stryker-application-config.json"
    ]
  }
}
