{
  "openapi": "3.2.0",
  "info": {
    "title": "ViajantesTurismo.Catalog.Api | public-catalog",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/public/catalog/tours": {
      "get": {
        "tags": [
          "CatalogEndpoints"
        ],
        "operationId": "GetPublishedTours",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TourSummaryDto"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/public/catalog/tours/{slug}": {
      "get": {
        "tags": [
          "CatalogEndpoints"
        ],
        "operationId": "GetPublishedTour",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TourDetailsDto"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/v1/public/catalog/gallery": {
      "get": {
        "tags": [
          "CatalogEndpoints"
        ],
        "operationId": "ListPublishedAlbums",
        "parameters": [
          {
            "name": "culture",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogGalleryIndexDto"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/v1/public/catalog/gallery/{slug}": {
      "get": {
        "tags": [
          "CatalogEndpoints"
        ],
        "operationId": "GetPublishedAlbum",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "culture",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogGalleryAlbumDto"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/v1/public/catalog/media/{id}/{width}/{format}": {
      "get": {
        "tags": [
          "CatalogEndpoints"
        ],
        "operationId": "GetPublicMedia",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "width",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "format",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "image/avif": {
                "schema": {
                  "$ref": "#/components/schemas/Stream"
                }
              },
              "image/jpeg": {
                "schema": {
                  "$ref": "#/components/schemas/Stream"
                }
              },
              "image/png": {
                "schema": {
                  "$ref": "#/components/schemas/Stream"
                }
              },
              "image/webp": {
                "schema": {
                  "$ref": "#/components/schemas/Stream"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/v1/public/catalog/content/{key}": {
      "get": {
        "tags": [
          "CatalogEndpoints"
        ],
        "operationId": "GetPublicContent",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "language",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "culture",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicContentVariantDto"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CatalogGalleryAlbumDto": {
        "required": [
          "slug",
          "title",
          "titleLanguage",
          "page",
          "pageSize",
          "photoCount",
          "photos"
        ],
        "type": "object",
        "properties": {
          "slug": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "titleLanguage": {
            "type": "string"
          },
          "page": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "pageSize": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "photoCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "photos": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CatalogTourImageDto"
            }
          }
        }
      },
      "CatalogGalleryIndexDto": {
        "required": [
          "page",
          "pageSize",
          "total",
          "albums"
        ],
        "type": "object",
        "properties": {
          "page": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "pageSize": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "total": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "albums": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CatalogGallerySummaryDto"
            }
          }
        }
      },
      "CatalogGallerySummaryDto": {
        "required": [
          "slug",
          "title",
          "titleLanguage",
          "photoCount",
          "cover"
        ],
        "type": "object",
        "properties": {
          "slug": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "titleLanguage": {
            "type": "string"
          },
          "photoCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "cover": {
            "$ref": "#/components/schemas/CatalogTourImageDto"
          }
        }
      },
      "CatalogMediaImageVariantDto": {
        "required": [
          "width",
          "height",
          "contentType",
          "fileSizeBytes"
        ],
        "type": "object",
        "properties": {
          "width": {
            "maximum": 2147483647,
            "minimum": 1,
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "height": {
            "maximum": 2147483647,
            "minimum": 1,
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "contentType": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "fileSizeBytes": {
            "maximum": 9223372036854776000,
            "minimum": 1,
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          }
        }
      },
      "CatalogTourImageDto": {
        "required": [
          "id",
          "sortOrder",
          "isCover",
          "altText",
          "isDecorative",
          "responsiveVariants"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "sortOrder": {
            "maximum": 2147483647,
            "minimum": 0,
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "isCover": {
            "type": "boolean"
          },
          "altText": {
            "maxLength": 256,
            "minLength": 0,
            "type": "string"
          },
          "isDecorative": {
            "type": "boolean"
          },
          "caption": {
            "maxLength": 256,
            "minLength": 0,
            "type": [
              "null",
              "string"
            ]
          },
          "textLanguage": {
            "maxLength": 64,
            "minLength": 0,
            "type": [
              "null",
              "string"
            ]
          },
          "responsiveVariants": {
            "minItems": 1,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CatalogMediaImageVariantDto"
            }
          }
        }
      },
      "HypermediaLink": {
        "required": [
          "rel",
          "href",
          "method"
        ],
        "type": "object",
        "properties": {
          "rel": {
            "type": "string"
          },
          "href": {
            "type": "string"
          },
          "method": {
            "type": "string"
          }
        }
      },
      "PublicContentVariantDto": {
        "type": "object",
        "properties": {
          "links": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/HypermediaLink"
            }
          },
          "language": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "seoTitle": {
            "type": [
              "null",
              "string"
            ]
          },
          "metaDescription": {
            "type": [
              "null",
              "string"
            ]
          },
          "shareSummary": {
            "type": [
              "null",
              "string"
            ]
          },
          "requiresHumanReview": {
            "type": "boolean"
          }
        }
      },
      "Stream": {
        "type": "string",
        "format": "binary"
      },
      "TourDetailsDto": {
        "required": [
          "title",
          "slug",
          "summary",
          "images",
          "updatedAt"
        ],
        "type": "object",
        "properties": {
          "links": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HypermediaLink"
            }
          },
          "title": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "slug": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "summary": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "description": {
            "maxLength": 4000,
            "minLength": 0,
            "type": "string"
          },
          "itinerary": {
            "maxLength": 4000,
            "minLength": 0,
            "type": "string"
          },
          "seoTitle": {
            "maxLength": 128,
            "minLength": 0,
            "type": "string"
          },
          "seoDescription": {
            "maxLength": 4000,
            "minLength": 0,
            "type": "string"
          },
          "images": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CatalogTourImageDto"
            }
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "TourSummaryDto": {
        "required": [
          "title",
          "slug",
          "summary",
          "images",
          "updatedAt"
        ],
        "type": "object",
        "properties": {
          "links": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HypermediaLink"
            }
          },
          "title": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "slug": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "summary": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "images": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CatalogTourImageDto"
            }
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "CatalogEndpoints"
    }
  ]
}