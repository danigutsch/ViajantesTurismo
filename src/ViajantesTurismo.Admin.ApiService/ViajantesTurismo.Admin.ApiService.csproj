<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
        <OpenApiGenerateDocuments>false</OpenApiGenerateDocuments>
        <OpenApiGenerateDocumentsOnBuild>false</OpenApiGenerateDocumentsOnBuild>
        <GenerateAdminOpenApiArtifacts Condition="'$(RefreshAdminOpenApiArtifacts)' == 'true'">true</GenerateAdminOpenApiArtifacts>
        <OpenApiGenerateDocuments Condition="'$(GenerateAdminOpenApiArtifacts)' == 'true'">true</OpenApiGenerateDocuments>
        <OpenApiGenerateDocumentsOnBuild Condition="'$(GenerateAdminOpenApiArtifacts)' == 'true'">true</OpenApiGenerateDocumentsOnBuild>
        <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/../ViajantesTurismo.Admin.Contracts.Http/OpenApi/.generated</OpenApiDocumentsDirectory>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="ViajantesTurismo.Admin.UnitTests" />
        <InternalsVisibleTo Include="ViajantesTurismo.Admin.ApiServiceTests" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\ViajantesTurismo.Architecture.Analyzers\ViajantesTurismo.Architecture.Analyzers.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"
                          PrivateAssets="all"
                          IsAspireProjectResource="false" />
        <ProjectReference Include="..\ViajantesTurismo.Admin.Application\ViajantesTurismo.Admin.Application.csproj" />
        <ProjectReference Include="..\ViajantesTurismo.Admin.Infrastructure\ViajantesTurismo.Admin.Infrastructure.csproj" />
        <ProjectReference Include="..\ViajantesTurismo.Admin.Contracts.Application\ViajantesTurismo.Admin.Contracts.Application.csproj" />
        <ProjectReference Include="..\ViajantesTurismo.Admin.Contracts.Http\ViajantesTurismo.Admin.Contracts.Http.csproj" />
        <ProjectReference Include="..\ViajantesTurismo.ServiceDefaults\ViajantesTurismo.ServiceDefaults.csproj" />
        <PackageReference Include="PandaBear.SharedKernel.IO" />
        <PackageReference Include="PandaBear.SharedKernel.IO.Analyzers" PrivateAssets="all" />
        <PackageReference Include="PandaBear.SharedKernel.Results" />
        <PackageReference Include="PandaBear.SharedKernel.Results.AspNet" />
        <PackageReference Include="PandaBear.SharedKernel.AspNetCore" />
        <PackageReference Include="PandaBear.SharedKernel.HttpCaching.AspNetCore" />
        <PackageReference Include="PandaBear.SharedKernel.ApiVersioning.AspNetCore" />
        <PackageReference Include="PandaBear.SharedKernel.OpenApi" />
        <PackageReference Include="PandaBear.SharedKernel.HttpClients" />
        <PackageReference Include="PandaBear.SharedKernel.Idempotency.Abstractions" />
        <PackageReference Include="PandaBear.SharedKernel.MalwareScanning" />
        <PackageReference Include="PandaBear.SharedKernel.MalwareScanning.ClamAv" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
        <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" />
    </ItemGroup>

    <Target Name="CopyAdminBoundaryOpenApiArtifacts" AfterTargets="GenerateOpenApiDocuments" Condition="'$(RefreshAdminOpenApiArtifacts)' == 'true'">
        <ItemGroup>
            <AdminOpenApiArtifact Include="tours;customers;bookings;documents;payment-accounts" />
            <GeneratedOpenApiArtifact Include="@(AdminOpenApiArtifact)">
                <SourcePath>$(OpenApiDocumentsDirectory)/$(AssemblyName)_%(Identity).json</SourcePath>
                <TargetPath>$(MSBuildProjectDirectory)/../ViajantesTurismo.Admin.Contracts.Http/OpenApi/%(Identity).openapi.json</TargetPath>
            </GeneratedOpenApiArtifact>
            <GeneratedOpenApiArtifact Include="v1">
                <!-- The ASP.NET Core generator writes the default v1 document to $(AssemblyName).json. -->
                <SourcePath>$(OpenApiDocumentsDirectory)/$(AssemblyName).json</SourcePath>
                <TargetPath>$(MSBuildProjectDirectory)/../ViajantesTurismo.Admin.Contracts.Http/OpenApi/v1.openapi.json</TargetPath>
            </GeneratedOpenApiArtifact>
        </ItemGroup>

        <MakeDir Directories="$(MSBuildProjectDirectory)/../ViajantesTurismo.Admin.Contracts.Http/OpenApi" />
        <Copy SourceFiles="@(GeneratedOpenApiArtifact->'%(SourcePath)')" DestinationFiles="@(GeneratedOpenApiArtifact->'%(TargetPath)')" SkipUnchangedFiles="true" />
    </Target>

</Project>
