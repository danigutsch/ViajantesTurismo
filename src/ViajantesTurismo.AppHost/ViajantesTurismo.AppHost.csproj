<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- Aspire AppHost orchestration is not a Native AOT publish target. -->
        <IsAotCompatible>false</IsAotCompatible>
    </PropertyGroup>

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <AspireCliInvocationMode>DnxPinned</AspireCliInvocationMode>
        <UserSecretsId>542db91b-8b09-47f2-8b7f-84c6eaf48fd4</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
        <!-- Hosted validation follows these build dependencies. AppHost registers each resource by project path. -->
        <ProjectReference Include="..\ViajantesTurismo.Admin.Api\ViajantesTurismo.Admin.Api.csproj"
                          ReferenceOutputAssembly="false" ExcludeAssets="all" Private="false" />
        <ProjectReference Include="..\ViajantesTurismo.Catalog.Api\ViajantesTurismo.Catalog.Api.csproj"
                          ReferenceOutputAssembly="false" ExcludeAssets="all" Private="false" />
        <ProjectReference Include="..\ViajantesTurismo.Admin.IntegrationEventWorker\ViajantesTurismo.Admin.IntegrationEventWorker.csproj"
                          ReferenceOutputAssembly="false" ExcludeAssets="all" Private="false" />
        <ProjectReference Include="..\ViajantesTurismo.Catalog.IntegrationEventWorker\ViajantesTurismo.Catalog.IntegrationEventWorker.csproj"
                          ReferenceOutputAssembly="false" ExcludeAssets="all" Private="false" />
        <ProjectReference Include="..\ViajantesTurismo.MigrationService\ViajantesTurismo.MigrationService.csproj"
                          ReferenceOutputAssembly="false" ExcludeAssets="all" Private="false" />
        <ProjectReference Include="..\ViajantesTurismo.Management.Web\ViajantesTurismo.Management.Web.csproj"
                          ReferenceOutputAssembly="false" ExcludeAssets="all" Private="false" />
        <ProjectReference Include="..\ViajantesTurismo.Public.Web\ViajantesTurismo.Public.Web.csproj"
                          ReferenceOutputAssembly="false" ExcludeAssets="all" Private="false" />
        <ProjectReference Include="..\ViajantesTurismo.DatabaseObservability\ViajantesTurismo.DatabaseObservability.csproj"
                          ReferenceOutputAssembly="false" ExcludeAssets="all" Private="false" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\ViajantesTurismo.Resources\ViajantesTurismo.Resources.csproj"/>
        <PackageReference Include="PandaBear.SharedKernel.Aspire.Hosting" />
        <PackageReference Include="PandaBear.SharedKernel.Aspire.Hosting.Grafana" />
        <PackageReference Include="PandaBear.SharedKernel.Aspire.Hosting.K6" />
        <PackageReference Include="PandaBear.SharedKernel.Aspire.Hosting.ClamAv" />
        <PackageReference Include="PandaBear.SharedKernel.Aspire.Hosting.SeaweedFs" />
        <PackageReference Include="PandaBear.SharedKernel.Aspire.Analyzers" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="ViajantesTurismo.ArchitectureTests" />
        <InternalsVisibleTo Include="ViajantesTurismo.HostedTests" />
        <Content Include="Keycloak\**\*" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Aspire.Hosting.AppHost"/>
        <PackageReference Include="Aspire.Hosting.Dotnet"/>
        <PackageReference Include="Aspire.Hosting.PostgreSQL"/>
        <PackageReference Include="Aspire.Hosting.Redis"/>
    </ItemGroup>

</Project>
