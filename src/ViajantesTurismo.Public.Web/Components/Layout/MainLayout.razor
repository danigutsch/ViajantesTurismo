@inherits LayoutComponentBase

<SkipLink>Skip to content</SkipLink>

<SiteHeader Label="Main navigation" Items="NavItems" CurrentPath="@CurrentPath">
    <Brand>
        <a class="public-brand" href="@Culture.Localize("/")" aria-label="@HomeAriaLabel">
            @if (Logo is not null)
            {
                <img class="public-brand__logo" src="@Logo.Value" alt="" />
            }
            else
            {
                <span class="public-brand__mark" aria-hidden="true">@BrandInitials</span>
            }
            <span>@BrandName</span>
        </a>
    </Brand>
    <Actions>
        <LanguageSwitcher Label="Language" Languages="Languages" />
    </Actions>
</SiteHeader>

<main id="main-content" tabindex="-1">
    @Body
</main>

<SiteFooter>
    <p>@BrandName</p>
</SiteFooter>

@code {
    [CascadingParameter]
    private BrandingSettingsDto? Branding { get; set; }

    [CascadingParameter]
    private PublicPageCulture Culture { get; set; } = PublicPageCulture.FromPath(PathString.Empty);

    private string BrandName => PublicBranding.BrandName(Branding);

    private string HomeAriaLabel => $"{BrandName} home";

    private string BrandInitials => string.Concat(BrandName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(static part => char.ToUpperInvariant(part[0])));

    private LinkTarget? Logo => PublicBranding.Logo(Branding);

    private string CurrentPath => Culture.Switch(Culture.UrlCulture);

    private IReadOnlyList<SiteNavItem> NavItems =>
    [
        new("Home", LinkTarget.FromString(Culture.Localize("/"))),
        new("Bike Tours", LinkTarget.FromString(Culture.Localize("/group-bike-tours"))),
        new("Gallery", LinkTarget.FromString(Culture.Localize("/gallery")))
    ];

    private IReadOnlyList<LanguageLink> Languages => PublicSiteCultures.Supported.Cultures
        .Select(culture => new LanguageLink(
            PublicSiteCultures.ContentLanguage(culture),
            PublicSiteCultures.NativeName(culture),
            LinkTarget.FromString(Culture.Switch(culture)),
            culture.Equals(Culture.UrlCulture)))
        .ToArray();
}
