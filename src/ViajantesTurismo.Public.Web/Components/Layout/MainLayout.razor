@inherits LayoutComponentBase
@inject NavigationManager Navigation

<a href="@MainContentLink" class="site-skip-link">@(Culture.IsPortuguese ? "Ir para o conteúdo" : "Skip to content")</a>

<SiteHeader Label="@(Culture.IsPortuguese ? "Navegação principal" : "Main navigation")" Items="NavItems" CurrentPath="@CurrentPath">
    <Brand>
        <a class="public-brand" href="@Culture.Localize("/")">
            @if (Logo is not null)
            {
                <img class="public-brand__logo" src="@Logo.Value" alt="" />
            }
            else
            {
                <span class="public-brand__mark" aria-hidden="true">@BrandInitials</span>
            }
            <span>@BrandName</span>
        </a>
    </Brand>
    <Actions>
        <LanguageSwitcher Label="@(Culture.IsPortuguese ? "Idioma" : "Language")" Languages="Languages" />
    </Actions>
</SiteHeader>

<main id="main-content" tabindex="-1">
    @Body
</main>

<SiteFooter>
    <p>@BrandName</p>
</SiteFooter>

@code {
    [CascadingParameter]
    private BrandingSettingsDto? Branding { get; set; }

    [CascadingParameter]
    private PublicPageCulture Culture { get; set; } = PublicPageCulture.FromPath(PathString.Empty);

    private string BrandName => PublicBranding.BrandName(Branding);

    private string BrandInitials => string.Concat(BrandName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(static part => char.ToUpperInvariant(part[0])));

    private LinkTarget? Logo => PublicBranding.Logo(Branding);

    private string CurrentPath => Culture.Switch(Culture.UrlCulture);

    private string MainContentLink => new Uri(Navigation.Uri).PathAndQuery + "#main-content";

    private IReadOnlyList<SiteNavItem> NavItems =>
    [
        new(Culture.IsPortuguese ? "Início" : "Home", LinkTarget.FromString(Culture.Localize("/"))),
        new(Culture.IsPortuguese ? "Viagens de bicicleta" : "Bike Tours", LinkTarget.FromString(Culture.Localize("/group-bike-tours"))),
        new(Culture.IsPortuguese ? "Galeria" : "Gallery", LinkTarget.FromString(Culture.Localize("/gallery")))
    ];

    private IReadOnlyList<LanguageLink> Languages => PublicSiteCultures.Supported.Cultures
        .Select(culture => new LanguageLink(
            PublicSiteCultures.ContentLanguage(culture),
            PublicSiteCultures.NativeName(culture),
            LinkTarget.FromString(Culture.Switch(culture)),
            culture.Equals(Culture.UrlCulture)))
        .ToArray();
}
