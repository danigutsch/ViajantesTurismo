@if (GetCoverImage() is { } coverImage)
{
    <picture>
        @foreach (var source in SourceGroups(coverImage))
        {
            <source type="@source.ContentType" srcset="@source.SrcSet" sizes="(min-width: 48rem) 33vw, 100vw" />
        }
        <img src="@ImageSource(coverImage)" alt="@coverImage.AltText" width="@ImageWidth(coverImage)" height="@ImageHeight(coverImage)" loading="lazy" />
    </picture>
}

@if (HeadingLevel == 3)
{
    <h3><a href="@TourUrl(Tour)">@Tour.Title</a></h3>
}
else
{
    <h2><a href="@TourUrl(Tour)">@Tour.Title</a></h2>
}

<p>@Tour.Identifier</p>
<a href="@TourUrl(Tour)">Learn more</a>

@code {
    [Parameter, EditorRequired]
    public required CatalogTourDto Tour { get; set; }

    [Parameter]
    public int HeadingLevel { get; set; } = 2;

    private CatalogTourImageDto? GetCoverImage() => Tour.Images
        .OrderByDescending(image => image.IsCover)
        .ThenBy(image => image.SortOrder)
        .FirstOrDefault();

    private static string TourUrl(CatalogTourDto tour) => $"/group-bike-tours/{Uri.EscapeDataString(tour.Slug)}";

    private static IEnumerable<(string ContentType, string SrcSet)> SourceGroups(CatalogTourImageDto image)
    {
        return image.ResponsiveVariants
            .GroupBy(variant => variant.ContentType, StringComparer.OrdinalIgnoreCase)
            .OrderBy(group => ContentTypeSortOrder(group.Key))
            .Select(group => (ContentType: group.Key, SrcSet: string.Join(", ", group
                .OrderBy(variant => variant.Width)
                .Select(variant => $"{variant.Uri} {variant.Width}w"))));
    }

    private static string ImageSource(CatalogTourImageDto image) => SelectFallbackVariant(image)?.Uri.ToString() ?? image.Uri.ToString();

    private static int? ImageWidth(CatalogTourImageDto image) => SelectFallbackVariant(image)?.Width;

    private static int? ImageHeight(CatalogTourImageDto image) => SelectFallbackVariant(image)?.Height;

    private static MediaImageResponsiveVariantDto? SelectFallbackVariant(CatalogTourImageDto image) => image.ResponsiveVariants
        .Where(variant => string.Equals(variant.ContentType, "image/jpeg", StringComparison.OrdinalIgnoreCase)
            || string.Equals(variant.ContentType, "image/png", StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(variant => variant.Width)
        .FirstOrDefault()
        ?? image.ResponsiveVariants.OrderByDescending(variant => variant.Width).FirstOrDefault();

    private static int ContentTypeSortOrder(string contentType) => contentType.ToLowerInvariant() switch
    {
        "image/avif" => 0,
        "image/webp" => 1,
        "image/jpeg" => 2,
        "image/png" => 3,
        _ => 4
    };
}
