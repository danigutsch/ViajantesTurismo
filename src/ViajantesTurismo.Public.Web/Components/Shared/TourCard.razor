@using Microsoft.AspNetCore.Routing
@inject LinkGenerator LinkGenerator

@{
    var coverImage = TourImageRenditions.Cover(Tour.Images);
    var cardVariant = coverImage is null ? null : TourImageRenditions.Card(coverImage);
}
@if (coverImage is not null && cardVariant is not null)
{
    <Card Title="@Tour.Title"
          HeadingLevel="HeadingLevel"
          Href="@TourLink"
          Image="@ResponsiveImage.Create(LinkTarget.FromString(TourImageRenditions.Path(LinkGenerator, coverImage.Id, cardVariant)), cardVariant.Width, cardVariant.Height, TourImageRenditions.Alternative(coverImage))">
        <p>@Tour.Summary</p>
    </Card>
}
else
{
    <Card Title="@Tour.Title" HeadingLevel="HeadingLevel" Href="@TourLink">
        <p>@Tour.Summary</p>
    </Card>
}

@code {
    [Parameter, EditorRequired]
    public required TourSummaryDto Tour { get; set; }

    [Parameter]
    public int HeadingLevel { get; set; } = 2;

    [CascadingParameter]
    private PublicPageCulture Culture { get; set; } = PublicPageCulture.FromPath(PathString.Empty);

    private LinkTarget TourLink => LinkTarget.FromString(Culture.Localize($"/group-bike-tours/{Uri.EscapeDataString(Tour.Slug)}"));
}
