@using Microsoft.AspNetCore.Routing
@inject LinkGenerator LinkGenerator

<picture>
    @foreach (var source in SourceGroups())
    {
        <source type="@source.ContentType" srcset="@source.SrcSet" sizes="@Sizes" />
    }
    <img src="@ImageSource()" alt="@Image.AltText" width="@ImageWidth()" height="@ImageHeight()" loading="@Loading" fetchpriority="@FetchPriority" />
</picture>

@code {
    [Parameter, EditorRequired]
    public required CatalogTourImageDto Image { get; set; }

    [Parameter, EditorRequired]
    public required string Sizes { get; set; }

    [Parameter]
    public string Loading { get; set; } = "lazy";

    [Parameter]
    public string? FetchPriority { get; set; }

    private IEnumerable<(string ContentType, string SrcSet)> SourceGroups()
    {
        return Image.ResponsiveVariants
            .Where(variant => IsPictureSourceContentType(variant.ContentType))
            .GroupBy(variant => variant.ContentType, StringComparer.OrdinalIgnoreCase)
            .OrderBy(group => ContentTypeSortOrder(group.Key))
            .Select(group => (ContentType: group.Key, SrcSet: string.Join(", ", group
                .OrderBy(variant => variant.Width)
                .Select(variant => $"{GetVariantPath(variant)} {variant.Width}w"))));
    }

    private string ImageSource() => GetVariantPath(SelectFallbackVariant());

    private int ImageWidth() => SelectFallbackVariant().Width;

    private int ImageHeight() => SelectFallbackVariant().Height;

    private CatalogMediaImageVariantDto SelectFallbackVariant() => Image.ResponsiveVariants
        .Where(variant => string.Equals(variant.ContentType, "image/jpeg", StringComparison.OrdinalIgnoreCase)
            || string.Equals(variant.ContentType, "image/png", StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(variant => variant.Width)
        .FirstOrDefault()
        ?? Image.ResponsiveVariants.OrderByDescending(variant => variant.Width).First();

    private string GetVariantPath(CatalogMediaImageVariantDto variant) => LinkGenerator.GetPathByName(
        PublicWebEndpoints.PublicMediaByRenditionEndpointName,
        new { id = Image.Id, width = variant.Width, format = GetMediaFormatSegment(variant.ContentType) })
        ?? throw new InvalidOperationException("The public media rendition route is not available.");

    private static string GetMediaFormatSegment(string contentType) => contentType.Trim().ToUpperInvariant() switch
    {
        "IMAGE/AVIF" => "avif",
        "IMAGE/JPEG" => "jpg",
        "IMAGE/PNG" => "png",
        "IMAGE/WEBP" => "webp",
        _ => throw new ArgumentOutOfRangeException(nameof(contentType), contentType, "Unsupported media content type.")
    };

    private static int ContentTypeSortOrder(string contentType) => contentType.ToUpperInvariant() switch
    {
        "IMAGE/AVIF" => 0,
        "IMAGE/WEBP" => 1,
        "IMAGE/JPEG" => 2,
        "IMAGE/PNG" => 3,
        _ => 4
    };

    private static bool IsPictureSourceContentType(string contentType) => contentType.ToUpperInvariant() switch
    {
        "IMAGE/AVIF" or "IMAGE/WEBP" or "IMAGE/JPEG" or "IMAGE/PNG" => true,
        _ => false
    };
}
