@using Microsoft.AspNetCore.Routing
@inject LinkGenerator LinkGenerator

@*
    Kept local: the package's Hero, Card and ImageGrid render one src per image, while catalog images have AVIF, WebP and JPEG
    renditions in several widths that the browser picks from with <picture>, srcset and sizes.
*@
@{
    var fallbackVariant = TourImageRenditions.Fallback(Image)
        ?? throw new InvalidOperationException("A responsive tour image requires a supported media variant.");
}
<picture>
    @foreach (var source in SourceGroups())
    {
        <source type="@source.ContentType" srcset="@source.SrcSet" sizes="@Sizes" />
    }
    <img src="@TourImageRenditions.Path(LinkGenerator, Image.Id, fallbackVariant)" alt="@Image.AltText" width="@fallbackVariant.Width" height="@fallbackVariant.Height" loading="@Loading" fetchpriority="@FetchPriority" />
</picture>

@code {
    [Parameter, EditorRequired]
    public required CatalogTourImageDto Image { get; set; }

    [Parameter, EditorRequired]
    public required string Sizes { get; set; }

    [Parameter]
    public string Loading { get; set; } = "lazy";

    [Parameter]
    public string? FetchPriority { get; set; }

    private IEnumerable<(string ContentType, string SrcSet)> SourceGroups()
    {
        return Image.ResponsiveVariants
            .Select(static variant => (Variant: variant, ContentType: variant.ContentType.Trim()))
            .Where(static variant => TourImageRenditions.FormatSegment(variant.ContentType) is not null)
            .GroupBy(variant => variant.ContentType, StringComparer.OrdinalIgnoreCase)
            .OrderBy(group => ContentTypeSortOrder(group.Key))
            .Select(group => (ContentType: group.Key, SrcSet: string.Join(", ", group
                .OrderBy(variant => variant.Variant.Width)
                .Select(variant => $"{TourImageRenditions.Path(LinkGenerator, Image.Id, variant.Variant)} {variant.Variant.Width}w"))));
    }

    private static int ContentTypeSortOrder(string contentType) => TourImageRenditions.FormatSegment(contentType) switch
    {
        "avif" => 0,
        "webp" => 1,
        "jpg" => 2,
        _ => 3
    };
}
