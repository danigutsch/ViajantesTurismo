@using Microsoft.AspNetCore.Routing
@inject LinkGenerator LinkGenerator

@{
    var fallbackVariant = SelectFallbackVariant();
}
<picture>
    @foreach (var source in SourceGroups())
    {
        <source type="@source.ContentType" srcset="@source.SrcSet" sizes="@Sizes" />
    }
    <img src="@GetVariantPath(fallbackVariant)" alt="@Image.AltText" width="@fallbackVariant.Width" height="@fallbackVariant.Height" loading="@Loading" fetchpriority="@FetchPriority" />
</picture>

@code {
    [Parameter, EditorRequired]
    public required CatalogTourImageDto Image { get; set; }

    [Parameter, EditorRequired]
    public required string Sizes { get; set; }

    [Parameter]
    public string Loading { get; set; } = "lazy";

    [Parameter]
    public string? FetchPriority { get; set; }

    private IEnumerable<(string ContentType, string SrcSet)> SourceGroups()
    {
        return Image.ResponsiveVariants
            .Select(static variant => (Variant: variant, ContentType: NormalizeContentType(variant.ContentType)))
            .Where(static variant => IsPictureSourceContentType(variant.ContentType))
            .GroupBy(variant => variant.ContentType, StringComparer.OrdinalIgnoreCase)
            .OrderBy(group => ContentTypeSortOrder(group.Key))
            .Select(group => (ContentType: group.Key, SrcSet: string.Join(", ", group
                .OrderBy(variant => variant.Variant.Width)
                .Select(variant => $"{GetVariantPath(variant.Variant)} {variant.Variant.Width}w"))));
    }

    private CatalogMediaImageVariantDto SelectFallbackVariant() => Image.ResponsiveVariants
        .Where(variant => IsPictureSourceContentType(variant.ContentType))
        .OrderByDescending(variant =>
            string.Equals(NormalizeContentType(variant.ContentType), "image/jpeg", StringComparison.OrdinalIgnoreCase)
            || string.Equals(NormalizeContentType(variant.ContentType), "image/png", StringComparison.OrdinalIgnoreCase))
        .ThenByDescending(variant => variant.Width)
        .FirstOrDefault()
        ?? throw new InvalidOperationException("A responsive tour image requires a supported media variant.");

    private string GetVariantPath(CatalogMediaImageVariantDto variant) => LinkGenerator.GetPathByName(
        PublicWebEndpoints.PublicMediaByRenditionEndpointName,
        new { id = Image.Id, width = variant.Width, format = GetMediaFormatSegment(variant.ContentType) })
        ?? throw new InvalidOperationException("The public media rendition route is not available.");

    private static string GetMediaFormatSegment(string contentType) => NormalizeContentType(contentType).ToUpperInvariant() switch
    {
        "IMAGE/AVIF" => "avif",
        "IMAGE/JPEG" => "jpg",
        "IMAGE/PNG" => "png",
        "IMAGE/WEBP" => "webp",
        _ => throw new ArgumentOutOfRangeException(nameof(contentType), contentType, "Unsupported media content type.")
    };

    private static int ContentTypeSortOrder(string contentType) => NormalizeContentType(contentType).ToUpperInvariant() switch
    {
        "IMAGE/AVIF" => 0,
        "IMAGE/WEBP" => 1,
        "IMAGE/JPEG" => 2,
        "IMAGE/PNG" => 3,
        _ => 4
    };

    private static bool IsPictureSourceContentType(string contentType) => NormalizeContentType(contentType).ToUpperInvariant() switch
    {
        "IMAGE/AVIF" or "IMAGE/WEBP" or "IMAGE/JPEG" or "IMAGE/PNG" => true,
        _ => false
    };

    private static string NormalizeContentType(string contentType) => contentType.Trim();
}
