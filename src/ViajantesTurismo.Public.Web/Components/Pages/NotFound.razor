@page "/not-found"
@layout Layout.MainLayout

<PageTitle>@Title - Viajantes Turismo</PageTitle>

<Section Heading="@Title" Level="1">
    <p>@(Culture.IsPortuguese ? "A página solicitada não foi encontrada." : "The page you requested could not be found.")</p>
</Section>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    [CascadingParameter]
    private PublicPageCulture Culture { get; set; } = PublicPageCulture.FromPath(PathString.Empty);

    private string Title => Culture.IsPortuguese ? "Página não encontrada" : "Page not found";

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        if (HttpContext is { Response.HasStarted: false })
        {
            PublicWebHttpCache.SetNoStore(HttpContext);
        }
    }
}
