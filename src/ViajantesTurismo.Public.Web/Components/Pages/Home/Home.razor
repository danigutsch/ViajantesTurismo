@page "/en"
@page "/pt"
@namespace ViajantesTurismo.Public.Web.Components.Pages
@inject IPublicCatalogApiClient CatalogApi

<PublicPageHead Title="@PageTitle" Description="@MetadataDescription" Path="/" />

<Hero Title="@HeroTitle" Subtitle="@HeroBody" />

<Section Title="@(Culture.IsPortuguese ? "Nossas viagens" : "Our tours")" HeadingId="published-tours">
    @if (_loadFailed)
    {
        <p>@(Culture.IsPortuguese ? "Não foi possível carregar as viagens. Tente novamente mais tarde." : "Tours could not be loaded right now. Try again later.")</p>
    }
    else if (_tours is null)
    {
        <p><em>@(Culture.IsPortuguese ? "Carregando viagens..." : "Loading tours...")</em></p>
    }
    else if (_tours.Length == 0)
    {
        <p>@(Culture.IsPortuguese ? "Novas viagens serão publicadas em breve." : "New tours will be published soon.")</p>
    }
    else
    {
        <CardGrid>
            @foreach (var tour in _tours)
            {
                <TourCard Tour="tour" HeadingLevel="3" />
            }
        </CardGrid>
    }
</Section>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    [CascadingParameter]
    private PublicPageCulture Culture { get; set; } = PublicPageCulture.FromPath(PathString.Empty);

    private TourSummaryDto[]? _tours;
    private PublicContentVariantDto? _hero;
    private bool _loadFailed;

    private string PageTitle => string.IsNullOrWhiteSpace(_hero?.SeoTitle) ? HeroTitle : _hero.SeoTitle;

    private string MetadataDescription => string.IsNullOrWhiteSpace(_hero?.MetaDescription) ? HeroBody : _hero.MetaDescription;

    private string HeroTitle => _hero?.Title ?? (Culture.IsPortuguese ? "Cicloturismo pelo mundo!" : "Cycle tourism around the world!");

    private string HeroBody => _hero?.Body ?? (Culture.IsPortuguese
        ? "Viaje de um jeito diferente. ViajantesTurismo é cultura, saúde e diversão."
        : "Travel differently. ViajantesTurismo is culture, health, and fun.");

    /// <inheritdoc />
    /// <remarks>
    /// The public fallback is preserved when an API implementation reports an upstream timeout as cancellation, or
    /// has not materialized transport outcomes and throws <see cref="HttpRequestException" />.
    /// </remarks>
    protected override async Task OnInitializedAsync()
    {
        PublicWebHttpCache.SetNoStore(HttpContext);
        var heroTask = LoadHero();
        var toursTask = LoadTours();

        await Task.WhenAll(heroTask, toursTask);
    }

    private async Task LoadHero()
    {
        try
        {
            var outcome = await CatalogApi.GetPublicContent(
                "home.hero",
                Culture.ContentLanguage.Value,
                CancellationToken.None);
            _hero = outcome is { Kind: HttpOutcomeKind.Succeeded, Value: { } hero }
                ? hero
                : null;
        }
        catch (OperationCanceledException)
        {
            _hero = null;
        }
        catch (HttpRequestException)
        {
            _hero = null;
        }
    }

    private async Task LoadTours()
    {
        var requestAborted = HttpContext?.RequestAborted ?? CancellationToken.None;
        try
        {
            var outcome = await CatalogApi.GetPublishedTours(requestAborted);
            if (outcome is { Kind: HttpOutcomeKind.Succeeded, Value: { } tours })
            {
                _tours = tours;
                return;
            }
        }
        catch (OperationCanceledException) when (!requestAborted.IsCancellationRequested)
        {
        }
        catch (HttpRequestException)
        {
        }

        PublicWebHttpCache.SetServiceUnavailableNoStore(HttpContext);
        _loadFailed = true;
        _tours = [];
    }
}
