@page "/"
@inject IPublicCatalogApiClient CatalogApi
@inject NavigationManager Navigation

<PageTitle>@PageTitle</PageTitle>

<section class="public-hero" aria-labelledby="home-hero-title">
    <h1 id="home-hero-title">@HeroTitle</h1>
    <p>@HeroBody</p>
</section>

<section aria-labelledby="published-tours">
    <div class="public-section-header">
        <h2 id="published-tours">Our tours</h2>
    </div>

    @if (_loadFailed)
    {
        <p>Tours could not be loaded right now. Try again later.</p>
    }
    else if (_tours is null)
    {
        <p><em>Loading tours...</em></p>
    }
    else if (_tours.Length == 0)
    {
        <p>New tours will be published soon.</p>
    }
    else
    {
        <div class="tour-list">
            @foreach (var tour in _tours)
            {
                <article class="tour-card-shell">
                    <TourCard Tour="tour" HeadingLevel="3" />
                </article>
            }
        </div>
    }
</section>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private TourSummaryDto[]? _tours;
    private PublicContentVariantDto? _hero;
    private bool _loadFailed;

    private string PageTitle => _hero?.SeoTitle ?? HeroTitle;

    private string HeroTitle => _hero?.Title ?? "Cycle tourism around the world!";

    private string HeroBody => _hero?.Body ?? "Travel differently. ViajantesTurismo is culture, health, and fun.";

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        var heroTask = LoadHero();
        var toursTask = LoadTours();

        await Task.WhenAll(heroTask, toursTask);
    }

    private async Task LoadHero()
    {
        try
        {
            _hero = await CatalogApi.GetPublicContent("home.hero", PublicCultureQuery.GetRequestedCulture(Navigation.Uri), CancellationToken.None);
        }
        catch (HttpRequestException)
        {
            _hero = null;
        }
    }

    private async Task LoadTours()
    {
        try
        {
            var requestAborted = HttpContext?.RequestAborted ?? CancellationToken.None;
            _tours = await CatalogApi.GetPublishedTours(requestAborted);
        }
        catch (OperationCanceledException) when (HttpContext?.RequestAborted.IsCancellationRequested != true)
        {
            PublicWebHttpCache.SetServiceUnavailableNoStore(HttpContext);
            _loadFailed = true;
            _tours = [];
        }
        catch (HttpRequestException)
        {
            PublicWebHttpCache.SetServiceUnavailableNoStore(HttpContext);
            _loadFailed = true;
            _tours = [];
        }
    }
}
