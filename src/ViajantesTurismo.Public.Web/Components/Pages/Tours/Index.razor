@page "/group-bike-tours"
@inject IPublicCatalogApiClient CatalogApi

<PageTitle>Group Bike Tours - Viajantes Turismo</PageTitle>

<h1>Group Bike Tours</h1>

@if (_loadFailed)
{
    <p>Tours could not be loaded right now. Try again later.</p>
}
else if (_tours is null)
{
    <p><em>Loading tours...</em></p>
}
else if (_tours.Length == 0)
{
    <p>New tours will be published soon.</p>
}
else
{
    <div class="tour-list">
        @foreach (var tour in _tours)
        {
            <article class="tour-card-shell">
                <TourCard Tour="tour" />
            </article>
        }
    </div>
}

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private TourSummaryDto[]? _tours;
    private bool _loadFailed;

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var requestAborted = HttpContext?.RequestAborted ?? CancellationToken.None;
            _tours = await CatalogApi.GetPublishedTours(requestAborted);
        }
        catch (OperationCanceledException) when (HttpContext?.RequestAborted.IsCancellationRequested != true)
        {
            PublicWebHttpCache.SetServiceUnavailableNoStore(HttpContext);
            _loadFailed = true;
            _tours = [];
        }
        catch (HttpRequestException)
        {
            PublicWebHttpCache.SetServiceUnavailableNoStore(HttpContext);
            _loadFailed = true;
            _tours = [];
        }
    }
}
