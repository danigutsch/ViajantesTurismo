@page "/en/group-bike-tours"
@page "/pt/group-bike-tours"
@inject IPublicCatalogApiClient CatalogApi

<PublicPageHead Title="@DocumentTitle" Description="@MetadataDescription" Path="/group-bike-tours" />

<Section Title="@Heading" Level="1">
    @if (_loadFailed)
    {
        <p>@(Culture.IsPortuguese ? "Não foi possível carregar as viagens. Tente novamente mais tarde." : "Tours could not be loaded right now. Try again later.")</p>
    }
    else if (_tours is null)
    {
        <p><em>@(Culture.IsPortuguese ? "Carregando viagens..." : "Loading tours...")</em></p>
    }
    else if (_tours.Length == 0)
    {
        <p>@(Culture.IsPortuguese ? "Novas viagens serão publicadas em breve." : "New tours will be published soon.")</p>
    }
    else
    {
        <CardGrid>
            @foreach (var tour in _tours)
            {
                <TourCard Tour="tour" />
            }
        </CardGrid>
    }
</Section>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    [CascadingParameter]
    private PublicPageCulture Culture { get; set; } = PublicPageCulture.FromPath(PathString.Empty);

    private TourSummaryDto[]? _tours;
    private bool _loadFailed;

    private string DocumentTitle => $"{Heading} - Viajantes Turismo";

    private string Heading => Culture.IsPortuguese ? "Viagens de bicicleta em grupo" : "Group Bike Tours";

    private string MetadataDescription => Culture.IsPortuguese
        ? "Conheça nossas viagens de bicicleta em grupo."
        : "Explore our published group cycling tours.";

    /// <inheritdoc />
    /// <remarks>
    /// The public fallback is preserved when an API implementation reports an upstream timeout as cancellation, or
    /// has not materialized transport outcomes and throws <see cref="HttpRequestException" />.
    /// </remarks>
    protected override async Task OnInitializedAsync()
    {
        var requestAborted = HttpContext?.RequestAborted ?? CancellationToken.None;
        try
        {
            var outcome = await CatalogApi.GetPublishedTours(requestAborted);
            if (outcome is { Kind: HttpOutcomeKind.Succeeded, Value: { } tours })
            {
                _tours = tours;
                return;
            }
        }
        catch (OperationCanceledException) when (!requestAborted.IsCancellationRequested)
        {
        }
        catch (HttpRequestException)
        {
        }

        PublicWebHttpCache.SetServiceUnavailableNoStore(HttpContext);
        _loadFailed = true;
        _tours = [];
    }
}
