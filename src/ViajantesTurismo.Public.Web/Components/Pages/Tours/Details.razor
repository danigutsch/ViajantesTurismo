@page "/en/group-bike-tours/{Slug}"
@page "/pt/group-bike-tours/{Slug}"
@using Microsoft.AspNetCore.Routing
@using Microsoft.Extensions.Options
@inject IPublicCatalogApiClient CatalogApi
@inject LinkGenerator LinkGenerator
@inject NavigationManager Navigation
@inject IOptions<PublicWebSitemapOptions> SitemapOptions

@if (_loadFailed)
{
    <PageTitle>Tour unavailable - Viajantes Turismo</PageTitle>
    <Section Title="Tour unavailable" Level="1">
        <p>This tour could not be loaded right now. Try again later.</p>
    </Section>
}
else if (_tour is null)
{
    <PageTitle>Tour not found - Viajantes Turismo</PageTitle>
    <Section Title="Tour not found" Level="1">
        <p>The requested tour is not published.</p>
    </Section>
}
else
{
    var coverImage = TourImageRenditions.Cover(_tour.Images);
    var galleryImages = GetGalleryImages(coverImage);

    <PublicPageHead Title="@GetDocumentTitle()"
                    Description="@GetMetadataDescription()"
                    Path="@TourPath"
                    ImageUrl="@GetSocialImageUrl(coverImage)" />

    <article>
        <Hero Title="@_tour.Title" Subtitle="@_tour.Summary">
            <Actions>
                <ButtonLink Href="@LinkTarget.FromString(Culture.Localize("/group-bike-tours"))" Variant="ButtonVariant.Outline">All tours</ButtonLink>
            </Actions>
        </Hero>

        @if (coverImage is not null)
        {
            <div class="tour-hero">
                <ResponsiveTourImage Image="coverImage" Sizes="100vw" Loading="eager" FetchPriority="high" />
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(_tour.Description))
        {
            <Section Title="About this tour" HeadingId="tour-description">
                <p>@_tour.Description</p>
            </Section>
        }

        @if (!string.IsNullOrWhiteSpace(_tour.Itinerary))
        {
            <Section Title="Itinerary" HeadingId="tour-itinerary">
                <p>@_tour.Itinerary</p>
            </Section>
        }

        @if (galleryImages.Count > 0)
        {
            <Section Title="Gallery" HeadingId="tour-gallery">
                <div class="tour-gallery">
                    <TourGallery Images="galleryImages" />
                </div>
            </Section>
        }
    </article>
}

@code {
    [Parameter]
    public string Slug { get; set; } = string.Empty;

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    [CascadingParameter]
    private PublicPageCulture Culture { get; set; } = PublicPageCulture.FromPath(PathString.Empty);

    private TourDetailsDto? _tour;
    private bool _loadFailed;

    private string TourPath => $"/group-bike-tours/{Uri.EscapeDataString(_tour?.Slug ?? Slug)}";

    private string GetDocumentTitle()
    {
        return string.IsNullOrWhiteSpace(_tour?.SeoTitle)
            ? $"{_tour?.Title} - Viajantes Turismo"
            : _tour.SeoTitle;
    }

    private string GetMetadataDescription()
    {
        return string.IsNullOrWhiteSpace(_tour?.SeoDescription)
            ? _tour?.Summary ?? string.Empty
            : _tour.SeoDescription;
    }

    private Uri? GetSocialImageUrl(CatalogTourImageDto? coverImage)
    {
        var variant = coverImage is null ? null : TourImageRenditions.Largest(coverImage);
        return coverImage is null || variant is null
            ? null
            : new PublicSiteLinks(SitemapOptions.Value).Absolute(TourImageRenditions.Path(LinkGenerator, coverImage.Id, variant));
    }

    private IReadOnlyList<CatalogTourImageDto> GetGalleryImages(CatalogTourImageDto? coverImage)
    {
        return _tour?.Images
            .Where(image => image.Id != coverImage?.Id)
            .ToArray()
            ?? [];
    }

    /// <inheritdoc />
    /// <remarks>
    /// The public fallback is preserved when an API implementation reports an upstream timeout as cancellation, or
    /// has not materialized transport outcomes and throws <see cref="HttpRequestException" />.
    /// </remarks>
    protected override async Task OnParametersSetAsync()
    {
        _loadFailed = false;
        _tour = null;

        var requestAborted = HttpContext?.RequestAborted ?? CancellationToken.None;
        try
        {
            var outcome = await CatalogApi.GetPublishedTourBySlug(Slug, requestAborted);
            if (outcome is { Kind: HttpOutcomeKind.Succeeded, Value: { } tour })
            {
                _tour = tour;
                return;
            }

            if (outcome.Kind == HttpOutcomeKind.NotFound)
            {
                Navigation.NotFound();
                return;
            }
        }
        catch (OperationCanceledException) when (!requestAborted.IsCancellationRequested)
        {
        }
        catch (HttpRequestException)
        {
        }

        PublicWebHttpCache.SetServiceUnavailableNoStore(HttpContext);
        _loadFailed = true;
    }
}
