@page "/en/group-bike-tours/{Slug}"
@page "/pt/group-bike-tours/{Slug}"
@using SharedKernel.BuildingBlocks
@using System.Text.Json
@using Microsoft.AspNetCore.Routing
@using Microsoft.Extensions.Options
@using SharedKernel.AspNetCore.Seo
@inject IPublicCatalogApiClient CatalogApi
@inject LinkGenerator LinkGenerator
@inject NavigationManager Navigation
@inject IOptions<CanonicalOriginOptions> SitemapOptions

@if (_loadFailed)
{
    <PageTitle>@UnavailableTitle - Viajantes Turismo</PageTitle>
    <Section Heading="@UnavailableTitle" Level="1">
        <p>@(Culture.IsPortuguese ? "Não foi possível carregar esta viagem. Tente novamente mais tarde." : "This tour could not be loaded right now. Try again later.")</p>
    </Section>
}
else if (_tour is null)
{
    <PageTitle>@NotFoundTitle - Viajantes Turismo</PageTitle>
    <Section Heading="@NotFoundTitle" Level="1">
        <p>@(Culture.IsPortuguese ? "A viagem solicitada não foi publicada." : "The requested tour is not published.")</p>
    </Section>
}
else
{
    var coverImage = TourImageRenditions.Cover(_tour.Images);
    var galleryImages = GetGalleryImages(coverImage);

    <PublicPageHead Title="@GetDocumentTitle()"
                    Description="@GetMetadataDescription()"
                    Path="@PublicSiteLinks.PagePath(TourPath, _photoWindow.Page)"
                    ImageUrl="@GetSocialImageUrl(coverImage)" />
    <script type="application/ld+json">@DescribeTour(_tour)</script>

    <article>
        <Hero Heading="@_tour.Title" Subtitle="@_tour.Summary"
              Image="@(coverImage is null ? null : TourImageRenditions.Responsive(LinkGenerator, coverImage, TourImageRenditions.HalfWidthSizes))">
            <Actions>
                <ButtonLink Href="@LinkTarget.FromString(Culture.Localize("/group-bike-tours"))" Variant="ButtonVariant.Outline">
                    @(Culture.IsPortuguese ? "Todas as viagens" : "All tours")
                </ButtonLink>
            </Actions>
        </Hero>

        @if (!string.IsNullOrWhiteSpace(_tour.Description))
        {
            <Section Heading="@(Culture.IsPortuguese ? "Sobre esta viagem" : "About this tour")" HeadingId="tour-description">
                <p>@_tour.Description</p>
            </Section>
        }

        @if (!string.IsNullOrWhiteSpace(_tour.Itinerary))
        {
            <Section Heading="@(Culture.IsPortuguese ? "Roteiro" : "Itinerary")" HeadingId="tour-itinerary">
                <p>@_tour.Itinerary</p>
            </Section>
        }

        @if (galleryImages.Count > 0)
        {
            <Section Heading="@(Culture.IsPortuguese ? "Galeria" : "Gallery")" HeadingId="tour-gallery">
                <ImageGrid Images="@TourImageRenditions.Gallery(LinkGenerator, galleryImages)" />
                <Pager Window="@_photoWindow" PageHref="@PhotoLink"
                       Label="@(Culture.IsPortuguese ? "Páginas de fotos" : "Tour photo pages")"
                       PreviousText="@(Culture.IsPortuguese ? "Anterior" : "Previous")"
                       NextText="@(Culture.IsPortuguese ? "Próxima" : "Next")"
                       PageLabelFormat="@(Culture.IsPortuguese ? "Página {0}" : "Page {0}")" />
            </Section>
        }
    </article>
}

@code {
    [Parameter]
    public string Slug { get; set; } = string.Empty;

    [SupplyParameterFromQuery(Name = "page")]
    private string? Page { get; set; }

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    [CascadingParameter]
    private PublicPageCulture Culture { get; set; } = PublicPageCulture.FromPath(PathString.Empty);

    private TourDetailsDto? _tour;
    private PageWindow _photoWindow;
    private bool _loadFailed;

    private string UnavailableTitle => Culture.IsPortuguese ? "Viagem indisponível" : "Tour unavailable";

    private string NotFoundTitle => Culture.IsPortuguese ? "Viagem não encontrada" : "Tour not found";

    private string TourPath => $"/group-bike-tours/{Uri.EscapeDataString(_tour?.Slug ?? Slug)}";

    private LinkTarget PhotoLink(int page) => LinkTarget.FromString(Culture.Localize(PublicSiteLinks.PagePath(TourPath, page)));

    private MarkupString DescribeTour(TourDetailsDto tour)
    {
        var canonical = new PublicSiteLinks(SitemapOptions.Value).Canonical(Culture.UrlCulture, TourPath);
        // The default JSON encoder escapes HTML-significant characters in the data block.
        return (MarkupString)JsonSerializer.Serialize(new Dictionary<string, string>(StringComparer.Ordinal)
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "TouristTrip",
            ["name"] = tour.Title,
            ["description"] = tour.Summary,
            ["url"] = canonical.AbsoluteUri
        });
    }

    private string GetDocumentTitle()
    {
        return string.IsNullOrWhiteSpace(_tour?.SeoTitle)
            ? $"{_tour?.Title} - Viajantes Turismo"
            : _tour.SeoTitle;
    }

    private string GetMetadataDescription()
    {
        return string.IsNullOrWhiteSpace(_tour?.SeoDescription)
            ? _tour?.Summary ?? string.Empty
            : _tour.SeoDescription;
    }

    private Uri? GetSocialImageUrl(CatalogTourImageDto? coverImage)
    {
        var variant = coverImage is null ? null : TourImageRenditions.Largest(coverImage);
        return coverImage is null || variant is null
            ? null
            : new PublicSiteLinks(SitemapOptions.Value).Absolute(TourImageRenditions.Path(LinkGenerator, coverImage.Id, variant));
    }

    private IReadOnlyList<CatalogTourImageDto> GetGalleryImages(CatalogTourImageDto? coverImage)
    {
        return _tour?.Images
            .Where(image => image.Id != coverImage?.Id)
            .ToArray()
            ?? [];
    }

    /// <inheritdoc />
    /// <remarks>
    /// The public fallback is preserved when an API implementation reports an upstream timeout as cancellation, or
    /// has not materialized transport outcomes and throws <see cref="HttpRequestException" />.
    /// </remarks>
    protected override async Task OnParametersSetAsync()
    {
        PublicWebHttpCache.SetNoStore(HttpContext);
        _loadFailed = false;
        _tour = null;

        var requestAborted = HttpContext?.RequestAborted ?? CancellationToken.None;
        try
        {
            var outcome = await CatalogApi.GetPublishedTourDetailsPage(Slug, Page, requestAborted);
            if (outcome is { Kind: HttpOutcomeKind.Succeeded, Value: { } detail })
            {
                _tour = detail.Tour;
                _photoWindow = PageWindow.Create(detail.Page, detail.PageSize, detail.Total);
                return;
            }

            if (outcome.Kind == HttpOutcomeKind.NotFound)
            {
                Navigation.NotFound();
                return;
            }
        }
        catch (OperationCanceledException) when (!requestAborted.IsCancellationRequested)
        {
        }
        catch (HttpRequestException)
        {
        }

        PublicWebHttpCache.SetServiceUnavailableNoStore(HttpContext);
        _loadFailed = true;
    }
}
