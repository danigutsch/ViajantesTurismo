@page "/en/gallery"
@page "/pt/gallery"
@namespace ViajantesTurismo.Public.Web.Components.Pages
@using Microsoft.AspNetCore.Routing
@using PandaBear.BuildingBlocks
@inject IPublicCatalogApiClient CatalogApi
@inject LinkGenerator LinkGenerator
@inject NavigationManager Navigation

<PublicPageHead Title="@DocumentTitle" Description="@Description" Path="@CanonicalPath" />

<Section Title="@Links.Heading" Level="1" Intro="@Description">
    @if (_loadFailed)
    {
        <p>@(Culture.IsPortuguese ? "Não foi possível carregar a galeria. Tente novamente mais tarde." : "The gallery could not be loaded right now. Try again later.")</p>
    }
    else if (_gallery is { Albums.Count: 0 })
    {
        <p>@(Culture.IsPortuguese ? "Novas fotos serão publicadas em breve." : "New photos will be published soon.")</p>
    }
    else if (_gallery is { } gallery)
    {
        <AlbumIndex Albums="@gallery.Albums.Select(MapSummary).ToArray()" HeadingLevel="2" />
        <Pager Window="@PageWindow.Create(gallery.Page, gallery.PageSize, gallery.Total)"
               PageHref="@IndexLink" Label="@Links.PagerLabel" PreviousText="@Links.Previous"
               NextText="@Links.Next" PageLabelFormat="@Links.PageLabel" />
    }
</Section>

@code {
    [SupplyParameterFromQuery(Name = "page")]
    private string? Page { get; set; }

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    [CascadingParameter]
    private PublicPageCulture Culture { get; set; } = PublicPageCulture.FromPath(PathString.Empty);

    private CatalogGalleryIndexDto? _gallery;
    private bool _loadFailed;

    private GalleryPageLinks Links => new(Culture);

    private string CanonicalPath => GalleryPageLinks.PagePath(GalleryPageLinks.IndexPath, _gallery?.Page ?? 1);

    private string DocumentTitle => $"{Links.Heading} - Viajantes Turismo";

    private string Description => Culture.IsPortuguese
        ? "Momentos das viagens de bicicleta da Viajantes Turismo."
        : "Moments from Viajantes Turismo cycle tours.";

    /// <inheritdoc />
    protected override async Task OnParametersSetAsync()
    {
        PublicWebHttpCache.SetNoStore(HttpContext);
        _gallery = null;
        _loadFailed = false;
        var requestAborted = HttpContext?.RequestAborted ?? CancellationToken.None;
        try
        {
            var outcome = await CatalogApi.ListPublishedAlbums(Culture.ContentLanguage.Value, Page, requestAborted);
            if (outcome.Kind == HttpOutcomeKind.NotFound)
            {
                Navigation.NotFound();
                return;
            }

            if (outcome is { Kind: HttpOutcomeKind.Succeeded, Value: { } gallery })
            {
                _gallery = gallery;
                return;
            }
        }
        catch (OperationCanceledException) when (!requestAborted.IsCancellationRequested)
        {
        }
        catch (HttpRequestException)
        {
        }

        PublicWebHttpCache.SetServiceUnavailableNoStore(HttpContext);
        _loadFailed = true;
    }

    private LinkTarget IndexLink(int page) => Links.Link(GalleryPageLinks.IndexPath, page);

    private AlbumSummary MapSummary(CatalogGallerySummaryDto album)
    {
        var cover = TourImageRenditions.Responsive(LinkGenerator,
            album.Cover with { AltText = string.Empty, IsDecorative = true }, TourImageRenditions.HalfWidthSizes);
        return new AlbumSummary(album.Title, Links.Link(GalleryPageLinks.AlbumPath(album.Slug)), cover,
            Links.PhotoCount(album.PhotoCount), Links.TitleLanguage(album.TitleLanguage));
    }
}
