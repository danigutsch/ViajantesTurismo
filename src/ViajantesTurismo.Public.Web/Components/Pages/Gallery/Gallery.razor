@page "/en/gallery"
@page "/pt/gallery"
@namespace ViajantesTurismo.Public.Web.Components.Pages
@using Microsoft.AspNetCore.Routing
@inject IPublicCatalogApiClient CatalogApi
@inject LinkGenerator LinkGenerator

<PublicPageHead Title="@DocumentTitle" Description="@Description" Path="/gallery" />

<Section Title="@Heading" Level="1" Intro="@Description">
    @if (_loadFailed)
    {
        <p>@(Culture.IsPortuguese ? "Não foi possível carregar a galeria. Tente novamente mais tarde." : "The gallery could not be loaded right now. Try again later.")</p>
    }
    else if (_tours is null)
    {
        <p><em>@(Culture.IsPortuguese ? "Carregando galeria..." : "Loading gallery...")</em></p>
    }
    else if (!_tours.Any(tour => tour.Images.Count > 0))
    {
        <p>@(Culture.IsPortuguese ? "Novas fotos serão publicadas em breve." : "New photos will be published soon.")</p>
    }
</Section>

@if (_tours is not null)
{
    @foreach (var tour in _tours.Where(tour => tour.Images.Count > 0))
    {
        <Section Title="@tour.Title" HeadingId="@GalleryHeadingId(tour)">
            <ImageGrid Images="@TourImageRenditions.Gallery(LinkGenerator, tour.Images)" />
        </Section>
    }
}

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    [CascadingParameter]
    private PublicPageCulture Culture { get; set; } = PublicPageCulture.FromPath(PathString.Empty);

    private TourSummaryDto[]? _tours;
    private bool _loadFailed;

    private string DocumentTitle => $"{Heading} - Viajantes Turismo";

    private string Heading => Culture.IsPortuguese ? "Galeria" : "Gallery";

    private string Description => Culture.IsPortuguese
        ? "Momentos das viagens de bicicleta da Viajantes Turismo."
        : "Moments from Viajantes Turismo cycle tours.";

    /// <inheritdoc />
    /// <remarks>
    /// The public fallback is preserved when an API implementation reports an upstream timeout as cancellation, or
    /// has not materialized transport outcomes and throws <see cref="HttpRequestException" />.
    /// </remarks>
    protected override async Task OnInitializedAsync()
    {
        PublicWebHttpCache.SetNoStore(HttpContext);
        var requestAborted = HttpContext?.RequestAborted ?? CancellationToken.None;
        try
        {
            var outcome = await CatalogApi.GetPublishedTours(requestAborted);
            if (outcome is { Kind: HttpOutcomeKind.Succeeded, Value: { } tours })
            {
                _tours = tours;
                return;
            }
        }
        catch (OperationCanceledException) when (!requestAborted.IsCancellationRequested)
        {
        }
        catch (HttpRequestException)
        {
        }

        PublicWebHttpCache.SetServiceUnavailableNoStore(HttpContext);
        _loadFailed = true;
        _tours = [];
    }

    private static string GalleryHeadingId(TourSummaryDto tour) => $"gallery-{tour.Slug}";
}
