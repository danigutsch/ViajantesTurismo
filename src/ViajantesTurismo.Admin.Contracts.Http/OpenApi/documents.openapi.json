  "components": {
    "schemas": {
      "DocumentStatusDto": {
        "type": "integer"
      },
      "GetDocumentDto": {
        "required": [
          "id",
          "bookingId",
          "revision",
          "templateId",
          "templateVersion",
          "sourceVersion",
          "status",
          "fields",
          "createdAt",
          "updatedAt",
          "hasFinalizedArtifact"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "bookingId": {
            "type": "string",
            "format": "uuid"
          },
          "revision": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "templateId": {
            "type": "string"
          },
          "templateVersion": {
            "type": "string"
          },
          "sourceVersion": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/DocumentStatusDto"
          },
          "fields": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GetDocumentFieldDto"
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "finalizedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "replacesDocumentId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "hasFinalizedArtifact": {
            "type": "boolean"
          }
        }
      },
      "GetDocumentFieldDto": {
        "required": [
          "fieldId",
          "label",
          "renderedValue",
          "isEditable"
        ],
        "type": "object",
        "properties": {
          "fieldId": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "renderedValue": {
            "type": "string"
          },
          "isEditable": {
            "type": "boolean"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "UpdateDocumentFieldDto": {
        "required": [
          "value"
        ],
        "type": "object",
        "properties": {
          "value": {
            "maxLength": 4000,
            "minLength": 0,
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
