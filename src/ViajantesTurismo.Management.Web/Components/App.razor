<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["components.css"]" />
    <link rel="stylesheet" href="@Assets["ViajantesTurismo.Management.Web.styles.css"]"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/lipis/flag-icons@7.0.0/css/flag-icons.min.css"/>
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <div class="app-startup-status" role="status" aria-live="polite">
        <div class="spinner-border" aria-hidden="true"></div>
        <span>Loading ViajantesTurismo Admin Portal...</span>
    </div>
    <noscript>
        <link rel="stylesheet" href="@Assets["app-noscript.css"]" />
        <p class="app-startup-error" role="alert">JavaScript is required to use the ViajantesTurismo Admin Portal.</p>
    </noscript>
    <Routes @rendermode="InteractiveServer" />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
