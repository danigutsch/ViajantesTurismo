@page "/customers"
@using Microsoft.AspNetCore.Components.QuickGrid
@using ViajantesTurismo.Admin.Contracts.Application

@inject ICustomersApiClient CustomersApi

<PageTitle>Customers</PageTitle>

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <h1 class="mb-0"><i class="bi bi-people-fill"></i> Customers</h1>
    <div class="d-flex gap-2">
        <NavLink href="/customers/import" class="btn btn-outline-secondary">
            <i class="bi bi-upload"></i> Import from CSV
        </NavLink>
        <NavLink href="/customers/create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Create New Customer
        </NavLink>
    </div>
</div>

<p>Manage customer information and profiles.</p>

@if (_errorMessage is not null)
{
    <div class="alert alert-danger" role="alert">@_errorMessage</div>
}
else if (_total is null)
{
    <p><em>Loading...</em></p>
}
else if (_total == 0)
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i> No customers found.
        <NavLink href="/customers/create" class="btn btn-link">Create your first customer</NavLink>
        .
    </div>
}
else
{
    <div class="table-responsive-wrapper">
        <QuickGrid TGridItem="GetCustomerListItemDto" ItemsProvider="@_loadCustomers" Class="table table-hover" Pagination="@_pagination">
            <TemplateColumn Title="Name" Sortable="true" SortBy="GridSort<GetCustomerListItemDto>.ByAscending(c => c.FirstName).ThenAscending(c => c.LastName)">
                @context.FirstName @context.LastName
            </TemplateColumn>

            <PropertyColumn Property="@(c => c.Email)" Title="Email" Sortable="true" />
            <PropertyColumn Property="@(c => c.Mobile)" Title="Mobile" />
            <PropertyColumn Property="@(c => c.Nationality)" Title="Nationality" Sortable="true" />

            <TemplateColumn Title="Actions">
                <div class="btn-group" role="group">
                    <NavLink href="@GetCustomerDetailsUrl(context.Id)" class="btn btn-sm btn-info">
                        <i class="bi bi-eye"></i> View
                    </NavLink>
                    <NavLink href="@GetCustomerEditUrl(context.Id)" class="btn btn-sm btn-primary">
                        <i class="bi bi-pencil"></i> Edit
                    </NavLink>
                </div>
            </TemplateColumn>
        </QuickGrid>
    </div>

    @if (_total > ContractConstants.CustomerListPageSize)
    {
        <Paginator State="@_pagination" />
    }

    <div class="mt-3">
        <p class="text-muted">Total customers: @_total</p>
    </div>
}

@code {
    private GridItemsProvider<GetCustomerListItemDto>? _loadCustomers;
    private GetCustomerPageDto? _initialPage;
    private int? _total;
    private string? _errorMessage;
    private readonly PaginationState _pagination = new() { ItemsPerPage = ContractConstants.CustomerListPageSize };

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        _loadCustomers = LoadCustomers;
        _initialPage = await FetchCustomers(1, CustomerPageSort.Name, descending: false, CancellationToken.None);
    }

    private async ValueTask<GridItemsProviderResult<GetCustomerListItemDto>> LoadCustomers(
        GridItemsProviderRequest<GetCustomerListItemDto> request)
    {
        var sort = request.GetSortByProperties().FirstOrDefault().PropertyName switch
        {
            nameof(GetCustomerListItemDto.Email) => CustomerPageSort.Email,
            nameof(GetCustomerListItemDto.Nationality) => CustomerPageSort.Nationality,
            _ => CustomerPageSort.Name
        };
        var pageNumber = (request.StartIndex / ContractConstants.CustomerListPageSize) + 1;
        var descending = request.SortByColumn is not null && !request.SortByAscending;
        var initialPage = _initialPage;
        _initialPage = null;
        if (initialPage is not null && pageNumber == 1 && sort == CustomerPageSort.Name && !descending)
        {
            return GridItemsProviderResult.From(initialPage.Items.ToArray(), initialPage.Total);
        }

        var previousTotal = _total;
        var page = await FetchCustomers(pageNumber, sort, descending, request.CancellationToken);
        if (_total != previousTotal)
        {
            await InvokeAsync(StateHasChanged);
        }

        return page is not null
            ? GridItemsProviderResult.From(page.Items.ToArray(), page.Total)
            : GridItemsProviderResult.From(Array.Empty<GetCustomerListItemDto>(), 0);
    }

    private async ValueTask<GetCustomerPageDto?> FetchCustomers(int page, CustomerPageSort sort, bool descending, CancellationToken ct)
    {
        _errorMessage = null;
        var outcome = await CustomersApi.GetCustomerPage(page, sort, descending, ct);
        ct.ThrowIfCancellationRequested();
        if (outcome is { Kind: HttpOutcomeKind.Succeeded, Value: { } result })
        {
            _total = result.Total;
            return result;
        }

        _errorMessage = new HttpOutcomeMessages("Customers could not be loaded. Try again later.").For(outcome.Kind);
        _total = 0;
        return null;
    }

    private static string GetCustomerDetailsUrl(Guid customerId) => $"/customers/{customerId}";

    private static string GetCustomerEditUrl(Guid customerId) => $"/customers/{customerId}/edit";
}
