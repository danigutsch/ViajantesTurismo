@page "/customers/create/accommodation"
@using ViajantesTurismo.Admin.Contracts.Application
@using ViajantesTurismo.Management.Web.Models

@inject CustomerCreationState State
@inject NavigationManager Navigation
@inject ICustomersApiClient CustomersApi

<PageTitle>Create Customer - Accommodation Preferences</PageTitle>

<div class="container mt-4">
    <h2>Create New Customer</h2>
    <WizardProgress/>

    @if (_errorMessage is not null)
    {
        <div class="alert alert-danger" role="alert">@_errorMessage</div>
    }

    <div class="card">
        <div class="card-header">
            <h4>Step 6 of 8: Accommodation Preferences</h4>
        </div>
        <div class="card-body">
            <EditForm Model="@_model" OnValidSubmit="@HandleValidSubmit" FormName="createCustomerAccommodation">
                <DataAnnotationsValidator/>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="roomType" class="form-label">Room Type <span class="text-danger">*</span></label>
                        <InputSelect id="roomType" @bind-Value="_model.RoomType" class="form-select">
                            <option value="">-- Select --</option>
                            <option value="@RoomTypeDto.DoubleOccupancy">Double Room</option>
                            <option value="@RoomTypeDto.SingleOccupancy">Single Room</option>
                        </InputSelect>
                        <ValidationMessage For="@(() => _model.RoomType)"/>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label for="bedType" class="form-label">Bed Type <span class="text-danger">*</span></label>
                        <InputSelect id="bedType" @bind-Value="_model.BedType" class="form-select">
                            <option value="">-- Select --</option>
                            <option value="@BedTypeDto.SingleBed">Single Bed</option>
                            <option value="@BedTypeDto.DoubleBed">Double Bed</option>
                        </InputSelect>
                        <ValidationMessage For="@(() => _model.BedType)"/>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-12 mb-3">
                        <label class="form-label">Companion (Optional)</label>
                        @if (_customers == null)
                        {
                            <div class="form-control">
                                <span class="spinner-border spinner-border-sm me-2"></span>
                                Loading customers...
                            </div>
                        }
                        else
                        {
                            <InputSelect @bind-Value="_model.CompanionId" class="form-select">
                                <option value="">-- No Companion --</option>
                                @foreach (var customer in _customers)
                                {
                                    <option
                                        value="@customer.Id">@customer.FirstName @customer.LastName (@customer.Email)
                                    </option>
                                }
                            </InputSelect>
                        }
                        <ValidationMessage For="@(() => _model.CompanionId)"/>
                        <small class="form-text text-muted">Select another customer traveling with this person</small>
                    </div>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <button type="button" class="btn btn-secondary" @onclick="GoBack">
                        <i class="bi bi-arrow-left"></i> Back
                    </button>
                    <button type="submit" class="btn btn-primary">
                        Next <i class="bi bi-arrow-right"></i>
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    private AccommodationPreferencesFormModel _model = new();
    private IReadOnlyList<GetCustomerDto>? _customers;
    private string? _errorMessage;

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        if (State.AccommodationPreferences is not null)
        {
            _model = State.AccommodationPreferences;
        }

        State.NavigateToStep(6);

        _errorMessage = null;
        var outcome = await CustomersApi.GetCustomers(CancellationToken.None);
        if (outcome is { Kind: ContractCommandOutcomeKind.Succeeded, Value: { } customers })
        {
            _customers = customers;
            return;
        }

        _customers = [];
        _errorMessage = HttpOutcomeUserMessage.For(outcome.Kind, "Customers could not be loaded for companion selection.");
    }

    private void HandleValidSubmit()
    {
        State.SetAccommodationPreferences(_model);
        Navigation.NavigateTo("/customers/create/emergency-contact");
    }

    private void GoBack()
    {
        State.NavigateToStep(5);
        Navigation.NavigateTo("/customers/create/physical");
    }

}
