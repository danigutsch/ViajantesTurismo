@namespace ViajantesTurismo.Management.Web.Components.Pages.Customers
@page "/customers/import"
@implements IAsyncDisposable
@using System.Text
@using ViajantesTurismo.Admin.Contracts.Application
@using ViajantesTurismo.Management.Web.Components.Shared
@using ViajantesTurismo.Management.Web.Helpers
@using ViajantesTurismo.Management.Web.Components.Pages.Customers.Import

@inject IUiFailureReporter Failures
@inject ICustomersApiClient CustomersApi

<PageTitle>Import Customers</PageTitle>

<div class="container mt-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <h1 class="mb-0"><i class="bi bi-upload"></i> Import Customers</h1>
        <NavLink href="/customers" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to Customers
        </NavLink>
    </div>

    <p class="text-muted">Upload a CSV file to bulk-import customers. The file must include the required columns.</p>

    @if (_state.Upload.Status is not UploadOperationStatus.None)
    {
        <UploadStatus State="@_state.Upload"
                      Label="Customer import upload status"
                      class="alert alert-light border"
                      OnCancel="CancelUpload"
                      CancelClass="btn btn-sm btn-outline-danger mt-2"
                      CancelLabelFormat="Cancel upload of {0}"
                      ProgressClass="w-100 mt-2"
                      ProgressLabelFormat="Upload progress for {0}"
                      IndeterminateProgressLabelFormat="Indeterminate server progress for {0}"
                      ProgressTextFormat="{0} of {1} bytes"
                      StatusClass="visually-hidden"
                      RenderFailureInStatus="false">
            <Detail><div data-upload-status>@GetUploadStatusText()</div></Detail>
        </UploadStatus>
    }

    @if (_state.Result is not null)
    {
        var summary = ImportCustomersCsvProcessor.BuildImportSummary(_state.Result, _state.ConflictStates);
        var successRows = _state.Result.SuccessRows ?? [];
        var errorRows = _state.Result.ErrorRows ?? [];
        var errorReportDataUri = ImportCustomersCsvProcessor.BuildErrorReportDataUri(errorRows);

        <div class="alert @(_state.Result.ErrorCount == 0 ? "alert-success" : "alert-warning") d-flex align-items-start gap-3">
            <i class="bi @(_state.Result.ErrorCount == 0 ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill") fs-4"></i>
            <div>
                <strong>Import complete.</strong>
                <ul class="mb-0 mt-1">
                    <li>@_state.Result.SuccessCount customer(s) imported successfully.</li>
                    @if (_state.Result.ErrorCount > 0)
                    {
                        <li>@_state.Result.ErrorCount row(s) could not be imported due to errors.</li>
                    }
                </ul>
                <ul class="mb-0 mt-2" data-testid="import-summary-counts">
                    <li>Created: @summary.CreatedCount</li>
                    <li>Updated: @summary.UpdatedCount</li>
                    <li>Skipped: @summary.SkippedCount</li>
                    <li>Failed: @summary.FailedCount</li>
                </ul>

                @if (successRows.Count > 0)
                {
                    <div class="mt-3" data-testid="summary-success-rows">
                        <div class="fw-semibold mb-2">Successful rows</div>
                        <table class="table table-sm mb-0">
                            <thead>
                                <tr>
                                    <th>Email</th>
                                    <th>Outcome</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in successRows)
                                {
                                    <tr>
                                        <td>@row.Email</td>
                                        <td>@row.Outcome</td>
                                        <td>
                                            @if (row.CustomerId.HasValue)
                                            {
                                                <NavLink href="@($"/customers/{row.CustomerId.Value}")"
                                                         data-action="view-customer"
                                                         class="btn btn-sm btn-outline-primary">
                                                    View customer
                                                </NavLink>
                                            }
                                            else
                                            {
                                                <span class="text-muted" data-action="customer-id-unavailable">ID unavailable</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                @if (errorRows.Count > 0)
                {
                    <div class="mt-3" data-testid="summary-error-rows">
                        <div class="fw-semibold mb-2">Failed rows</div>
                        <table class="table table-sm mb-0">
                            <thead>
                                <tr>
                                    <th>Line</th>
                                    <th>Field</th>
                                    <th>Message</th>
                                    <th>Email</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in errorRows)
                                {
                                    <tr>
                                        <td>@row.LineNumber</td>
                                        <td>@(row.Field ?? "-")</td>
                                        <td>@row.Message</td>
                                        <td>@(row.Email ?? "-")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        @if (errorReportDataUri is not null)
                        {
                            <a href="@errorReportDataUri"
                               download="import-errors.csv"
                               class="btn btn-sm btn-outline-danger mt-2"
                               data-action="download-error-report">
                                Download error report
                            </a>
                        }
                    </div>
                }

                <div class="mt-2 d-flex gap-2">
                    <button class="btn btn-sm btn-outline-secondary" @onclick="Reset">Import another file</button>
                    @if (_state.PendingFileBytes.Length > 0)
                    {
                        <button class="btn btn-sm btn-outline-secondary"
                                data-action="retry-current-file"
                                @onclick="RetryWithCurrentFile">
                            Retry with current file
                        </button>
                    }
                    <NavLink href="/customers" class="btn btn-sm btn-primary">View customers</NavLink>
                </div>
            </div>
        </div>
    }
    else if (_state.Step == ImportCustomersWorkflowStep.HeaderMapping)
    {
        var unmatchedRequired = _state.FieldMappings.Count(IsMissingRequiredMapping);
        var duplicateAssignment = HasDuplicateColumnAssignments();
        var unresolvedChoices = HasUnresolvedColumnChoices();

        <div class="card">
            <div class="card-header d-flex align-items-center gap-2">
                <i class="bi bi-file-earmark-text"></i>
                <strong>@_state.PendingFileName</strong>
                <span class="badge bg-secondary">@_state.CsvHeaders.Count column(s) detected</span>
            </div>
            <div class="card-body">
                @if (unmatchedRequired == 0 && !unresolvedChoices && !duplicateAssignment)
                {
                    <div class="alert alert-success d-flex align-items-center gap-2 mb-3">
                        <i class="bi bi-check-circle-fill fs-5"></i>
                        <span>@(_state.UserMappings.Count == 0 ? "All required columns were automatically matched." : "All required columns are mapped.")</span>
                    </div>
                }
                else if (unmatchedRequired > 0)
                {
                    <div class="alert alert-warning d-flex align-items-center gap-2 mb-3">
                        <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                        <span>@unmatchedRequired required column(s) could not be matched. Please assign them below.</span>
                    </div>
                }

                @if (duplicateAssignment)
                {
                    <div class="alert alert-warning" role="alert">Use each source column only once.</div>
                }

                <table class="table table-sm align-middle">
                    <thead>
                        <tr>
                            <th>Field</th>
                            <th></th>
                            <th>Source Column (CSV)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var mapping in _state.FieldMappings)
                        {
                            var fieldName = mapping.Field.Name;
                            var effective = GetEffectiveMappingValue(fieldName, mapping.MatchedCsvHeader);
                            var suggestions = _state.HeaderSuggestions.GetValueOrDefault(fieldName);
                            var helpId = $"{fieldName}-mapping-help";
                            <tr>
                                <td>@mapping.Field.DisplayName</td>
                                <td>
                                    @if (mapping.Field.IsRequired)
                                    {
                                        <span class="badge bg-danger">Required</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Optional</span>
                                    }
                                </td>
                                <td>
                                    <select class="form-select form-select-sm"
                                            data-field="@fieldName"
                                            aria-label="@mapping.Field.DisplayName"
                                            aria-describedby="@(suggestions is not null || IsMissingRequiredMapping(mapping) ? helpId : null)"
                                            @onchange="@(e => OnFieldMapped(fieldName, e.Value?.ToString()))">
                                        <option value="">(none)</option>
                                        @foreach (var header in _state.CsvHeaders)
                                        {
                                            <option value="@header" selected="@(header == effective)">@header</option>
                                        }
                                    </select>
                                    @if (suggestions is { Count: 1 })
                                    {
                                        <p id="@helpId" class="small text-muted mb-0">Suggested column <strong>@suggestions[0].Header</strong>. @suggestions[0].Reason</p>
                                    }
                                    else if (suggestions is { Count: > 1 })
                                    {
                                        <div id="@helpId" class="small">
                                            <p class="mb-1">Multiple possible columns. Choose one.</p>
                                            <ul class="mb-1">
                                                @foreach (var suggestion in suggestions)
                                                {
                                                    <li>@(suggestion.Header). @suggestion.Reason</li>
                                                }
                                            </ul>
                                            @if (!mapping.Field.IsRequired && !_state.UserMappings.ContainsKey(fieldName))
                                            {
                                                <button type="button" class="btn btn-link btn-sm p-0" @onclick="@(() => OnFieldMapped(fieldName, null))">Leave unmapped</button>
                                            }
                                        </div>
                                    }
                                    else if (IsMissingRequiredMapping(mapping))
                                    {
                                        <p id="@helpId" class="small text-muted mb-0" data-missing-required-field="@fieldName">
                                            No suggested source. Choose a column if this data is in the file.
                                        </p>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                @if (_state.ValidationError is not null)
                {
                    <div class="alert alert-danger mt-3 mb-0">
                        <i class="bi bi-exclamation-circle"></i> @_state.ValidationError
                    </div>
                }

                <div class="d-flex gap-2 mt-3">
                    <button class="btn btn-primary"
                            @onclick="ShowPreview"
                            disabled="@(unmatchedRequired > 0 || duplicateAssignment || unresolvedChoices || _state.Uploading)">
                        <i class="bi bi-eye"></i> Preview
                    </button>
                    <button class="btn btn-outline-secondary" @onclick="Reset" disabled="@_state.Uploading">
                        <i class="bi bi-arrow-left"></i> Choose different file
                    </button>
                </div>
            </div>
        </div>
    }
    else if (_state.Step == ImportCustomersWorkflowStep.Preview)
    {
        var mappedFields = _state.FieldMappings
            .Where(mapping => GetEffectiveMappingValue(mapping.Field.Name, mapping.MatchedCsvHeader) is not null)
            .Select(mapping => mapping.Field)
            .ToList();

        <div class="card">
            <div class="card-header d-flex align-items-center gap-2">
                <i class="bi bi-table"></i>
                <strong>@_state.PendingFileName</strong>
                <span class="badge bg-secondary">@_state.PreviewRows.Count of max @MaxPreviewRows row(s) shown</span>
            </div>
            <div class="card-body">
                <p class="text-muted small">Review the extracted data below. Rows with missing required values are highlighted.</p>

                <div class="table-responsive">
                    <table class="table table-sm preview-table">
                        <thead>
                            <tr>
                                @foreach (var field in mappedFields)
                                {
                                    <th>
                                        @field.DisplayName
                                        @if (field.IsRequired)
                                        {
                                            <span class="text-danger ms-1">*</span>
                                        }
                                    </th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in _state.PreviewRows)
                            {
                                var hasWarning = mappedFields
                                    .Where(field => field.IsRequired)
                                    .Any(field => !row.TryGetValue(field.Name, out var value) || string.IsNullOrEmpty(value));
                                <tr class="@(hasWarning ? "table-warning" : "")">
                                    @foreach (var mapping in mappedFields)
                                    {
                                        <td>@row.GetValueOrDefault(mapping.Name, "")</td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (_state.ValidationError is not null)
                {
                    <div class="alert alert-danger mt-3 mb-0">
                        <i class="bi bi-exclamation-circle"></i> @_state.ValidationError
                    </div>
                }

                <div class="d-flex gap-2 mt-3">
                    <button class="btn btn-primary"
                            @onclick="HandleImport"
                            disabled="@_state.Uploading">
                        @if (_state.Uploading)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        <i class="bi bi-check-lg"></i> @GetImportButtonLabel()
                    </button>
                    <button class="btn btn-outline-secondary"
                            @onclick="@(() => _state.Step = ImportCustomersWorkflowStep.HeaderMapping)"
                            disabled="@_state.Uploading">
                        <i class="bi bi-arrow-left"></i> Back to Mapping
                    </button>
                </div>
            </div>
        </div>
    }
    else if (_state.Step == ImportCustomersWorkflowStep.DuplicateResolution)
    {
        <ImportCustomersDuplicateResolution
            Items="@GetDuplicateResolutionItems()"
            VisibleFieldMappings="@GetVisibleConflictFieldMappings()"
            Uploading="@_state.Uploading"
            DecisionChanged="OnConflictDecisionChanged"
            FieldSourceChanged="OnConflictFieldSourceChanged"
            Confirm="HandleCommitWithResolutions"
            Back="BackToPreview" />
    }
    else
    {
        <div class="card">
            <div class="card-body">
                <div class="border border-2 border-dashed rounded-3 p-5 text-center position-relative @(_state.Dragging > 0 ? "border-primary bg-primary bg-opacity-10" : "border-secondary")"
                    @ondragenter="@(() => _state.Dragging++)"
                    @ondragleave="@(() => _state.Dragging--)">
                    <i class="bi bi-file-earmark-arrow-up fs-1 text-muted d-block mb-2"></i>
                    <p class="mb-1 fw-semibold">Drop a CSV file here</p>
                    <p class="text-muted small mb-0">or click to browse &mdash; max @MaxFileSizeInMebibytes MiB</p>
                    <InputFile OnChange="OnFileSelected"
                               accept=".csv"
                               class="position-absolute top-0 start-0 w-100 h-100 opacity-0 cursor-pointer" />
                </div>

                @if (_state.ValidationError is not null)
                {
                    <div class="alert alert-danger mt-3 mb-0">
                        <i class="bi bi-exclamation-circle"></i> @_state.ValidationError
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private const long MaxFileSizeBytes = ContractConstants.CustomerImportMaxFileBytes;
    private const long BytesPerMebibyte = 1024 * 1024;
    private const long MaxFileSizeInMebibytes = MaxFileSizeBytes / BytesPerMebibyte;
    private const int MaxPreviewRows = 5;
    private readonly ImportCustomersWorkflowState _state = new();
    private CancellationTokenSource? _activeUploadCancellation;

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        _state.Dragging = 0;
        _state.ValidationError = null;

        var file = e.File;
        if (!ValidateSelectedFile(file))
        {
            return;
        }

        ReadOnlyMemory<byte> fileBytes;
        try
        {
            fileBytes = await ReadFileBytes(file);
        }
        catch (IOException exception)
        {
            Failures.Report(exception, "customers.import.read");
            _state.ValidationError = "The file could not be read. Please try again.";
            return;
        }

        SetPendingFile(file.Name, fileBytes);
    }

    private void OnFieldMapped(string fieldName, string? csvHeader) =>
        _state.UserMappings[fieldName] = _state.CsvHeaders.Contains(csvHeader, StringComparer.Ordinal) ? csvHeader : null;

    private string? GetEffectiveMappingValue(string fieldName, string? autoMatchedHeader)
    {
        return _state.UserMappings.GetValueOrDefault(fieldName, autoMatchedHeader);
    }

    private bool IsMissingRequiredMapping(CustomerImportFieldMapping mapping) =>
        mapping.Field.IsRequired && GetEffectiveMappingValue(mapping.Field.Name, mapping.MatchedCsvHeader) is null;

    private bool HasDuplicateColumnAssignments() =>
        _state.FieldMappings.Select(mapping => GetEffectiveMappingValue(mapping.Field.Name, mapping.MatchedCsvHeader))
            .OfType<string>()
            .GroupBy(header => header, StringComparer.OrdinalIgnoreCase)
            .Any(assignments => assignments.Skip(1).Any());

    private bool HasUnresolvedColumnChoices() =>
        _state.HeaderSuggestions.Any(suggestion => suggestion.Value.Count > 1 && !_state.UserMappings.ContainsKey(suggestion.Key));

    private bool CanUseMappings() =>
        !_state.FieldMappings.Any(IsMissingRequiredMapping) && !HasDuplicateColumnAssignments() && !HasUnresolvedColumnChoices();

    private void ShowPreview()
    {
        if (!CanUseMappings())
        {
            return;
        }

        _state.PreviewRows = ImportCustomersCsvProcessor.BuildPreviewRows(
            _state.PendingFileBytes,
            _state.CsvHeaders,
            _state.FieldMappings,
            _state.UserMappings,
            MaxPreviewRows);
        _state.Step = ImportCustomersWorkflowStep.Preview;
    }

    private async Task HandleImport()
    {
        if (!CanUseMappings())
        {
            _state.ValidationError = "Review the column mappings before importing.";
            return;
        }

        var payload = CreateImportPayload();
        var (fileBytes, _) = payload.Prepare(_state.PendingFileBytes, []);
        var (operationId, uploadCancellation, progress) = BeginUpload(fileBytes.Length);

        try
        {
            var outcome = await CustomersApi.ImportCustomers(fileBytes, _state.PendingFileName, progress, uploadCancellation.Token);
            if (!_state.Upload.IsCurrentActive(operationId))
            {
                return;
            }

            if (outcome is not { Kind: HttpOutcomeKind.Succeeded, Value: { } result })
            {
                _state.Upload.Fail(operationId, new HttpOutcomeMessages(UserFacingErrorMessage.ForOperation("import the customers")).For(outcome.Kind));
                return;
            }

            if (result.Conflicts is { Count: > 0 } conflicts)
            {
                var conflictStates = await LoadConflictStates(conflicts, fileBytes, uploadCancellation.Token);
                if (!_state.Upload.IsCurrentActive(operationId))
                {
                    return;
                }

                _state.ConflictPayload = payload;
                _state.ConflictStates = conflictStates;
                _state.Step = ImportCustomersWorkflowStep.DuplicateResolution;

                _state.Upload.Reset();
                return;
            }

            _state.Result = result;
            _state.ConflictPayload = null;
            _state.Upload.ReportBytes(operationId, fileBytes.Length);
            _state.Upload.Complete(operationId);
        }
        catch (OperationCanceledException) when (uploadCancellation.IsCancellationRequested)
        {
            _state.Upload.Cancel(operationId);
        }
        catch (Exception exception)
        {
            Failures.Report(exception, "customers.import.upload");
            _state.Upload.Fail(operationId, UserFacingErrorMessage.ForOperation("import the customers"));
        }
        finally
        {
            ReleaseUploadCancellation(uploadCancellation);
        }
    }

    private async Task HandleCommitWithResolutions()
    {
        var (fileBytes, payload) = (_state.ConflictPayload ?? CreateImportPayload()).Prepare(
            _state.PendingFileBytes, _state.ConflictStates);

        var (operationId, uploadCancellation, progress) = BeginUpload(fileBytes.Length);

        try
        {
            var conflictDecisions = BuildConflictDecisions();
            var outcome = await CustomersApi.CommitImportWithResolutions(
                fileBytes,
                _state.PendingFileName,
                conflictDecisions,
                progress,
                uploadCancellation.Token);
            if (!_state.Upload.IsCurrentActive(operationId))
            {
                return;
            }

            if (outcome is not { Kind: HttpOutcomeKind.Succeeded, Value: { } result })
            {
                _state.Upload.Fail(operationId, new HttpOutcomeMessages(UserFacingErrorMessage.ForOperation("import the customers")).For(outcome.Kind));
                return;
            }

            if (result.Conflicts is { Count: > 0 } conflicts)
            {
                var conflictStates = await LoadConflictStates(conflicts, fileBytes, uploadCancellation.Token);
                if (!_state.Upload.IsCurrentActive(operationId))
                {
                    return;
                }

                _state.ConflictPayload = payload;
                _state.ConflictStates = conflictStates;
                _state.Step = ImportCustomersWorkflowStep.DuplicateResolution;

                _state.Upload.Reset();
                return;
            }

            _state.Result = result;
            _state.ConflictPayload = null;
            _state.Upload.ReportBytes(operationId, fileBytes.Length);
            _state.Upload.Complete(operationId);
        }
        catch (OperationCanceledException) when (uploadCancellation.IsCancellationRequested)
        {
            _state.Upload.Cancel(operationId);
        }
        catch (Exception exception)
        {
            Failures.Report(exception, "customers.import.complete");
            _state.Upload.Fail(operationId, UserFacingErrorMessage.ForOperation("complete the customer import"));
        }
        finally
        {
            ReleaseUploadCancellation(uploadCancellation);
        }
    }

    private void Reset()
    {
        _state.ResetToFileSelection();
    }

    private void RetryWithCurrentFile()
    {
        _state.RetryCurrentFile();
    }

    private bool ValidateSelectedFile(IBrowserFile file)
    {
        if (!file.Name.EndsWith(".csv", StringComparison.OrdinalIgnoreCase))
        {
            _state.ValidationError = "Only CSV files are supported (.csv).";
            return false;
        }

        if (file.Size > MaxFileSizeBytes)
        {
            _state.ValidationError = $"File is too large ({file.Size / BytesPerMebibyte} MiB). Maximum allowed size is {MaxFileSizeInMebibytes} MiB.";
            return false;
        }

        return true;
    }

    private static async Task<ReadOnlyMemory<byte>> ReadFileBytes(IBrowserFile file)
    {
        await using var stream = file.OpenReadStream(MaxFileSizeBytes);
        var fileBytes = new byte[file.Size];
        await stream.ReadExactlyAsync(fileBytes);
        await EnsureNoBytesRemain(stream);

        return fileBytes;
    }

    /// <summary>The browser stream is capped at the declared size, so any extra byte means the declared size was wrong.</summary>
    private static async Task EnsureNoBytesRemain(Stream stream)
    {
        if (await stream.ReadAsync(new byte[1]) > 0)
        {
            throw new IOException("The file stream is longer than the declared file size.");
        }
    }

    private void SetPendingFile(string fileName, ReadOnlyMemory<byte> fileBytes)
    {
        var parsed = ImportCustomersCsvProcessor.ReadForMapping(fileBytes);
        if (!parsed.IsSuccess)
        {
            _state.ValidationError = parsed.ErrorDetails.Detail;
            return;
        }

        var document = parsed.Value;
        var suggestions = CustomerImportHeaderAdvisor.Suggest(document, MaxPreviewRows);
        var fieldMappings = CustomerImportHeaderMatcher.AutoMatch(document.Headers)
            .Select(mapping => suggestions.ContainsKey(mapping.Field.Name) ? mapping with { MatchedCsvHeader = null } : mapping)
            .ToArray();
        _state.SetPendingFile(fileName, fileBytes, document.Headers, fieldMappings, suggestions);
    }

    private ImportCustomersCsvPayload CreateImportPayload() =>
        new(CustomerImportHeaderMatcher.GetMappedHeaders(
            _state.CsvHeaders,
            _state.FieldMappings,
            _state.UserMappings));

    private Dictionary<string, string> BuildConflictDecisions() => _state.BuildConflictDecisions();

    private (long OperationId, CancellationTokenSource Cancellation, IProgress<long> Progress) BeginUpload(long totalBytes)
    {
        var operationId = _state.Upload.Begin(_state.PendingFileName, totalBytes, _state.Upload.CanRetry);
        var uploadCancellation = new CancellationTokenSource();
        _activeUploadCancellation = uploadCancellation;
        _state.ValidationError = null;

        var progress = new Progress<long>(bytesTransferred =>
        {
            if (_state.Upload.ReportBytes(operationId, bytesTransferred))
            {
                StateHasChanged();
            }
        });

        return (operationId, uploadCancellation, progress);
    }

    private void ReleaseUploadCancellation(CancellationTokenSource uploadCancellation)
    {
        if (ReferenceEquals(_activeUploadCancellation, uploadCancellation))
        {
            _activeUploadCancellation = null;
        }

        uploadCancellation.Dispose();
    }

    private async Task CancelUpload()
    {
        var uploadCancellation = _activeUploadCancellation;
        if (uploadCancellation is null || !_state.Upload.Cancel(_state.Upload.OperationId))
        {
            return;
        }

        await uploadCancellation.CancelAsync();
    }

    private string GetImportButtonLabel()
    {
        if (_state.Uploading)
        {
            return "Importing...";
        }

        return _state.Upload.CanRetry ? "Retry Import" : "Confirm Import";
    }

    private string GetUploadStatusText() => _state.Upload.Status switch
    {
        UploadOperationStatus.Queued => $"Queued: {_state.Upload.FileName}",
        UploadOperationStatus.Retrying => $"Retrying: {_state.Upload.FileName}",
        UploadOperationStatus.Uploading => $"Uploading {_state.Upload.FileName}: {_state.Upload.BytesTransferred} of {_state.Upload.TotalBytes} bytes.",
        UploadOperationStatus.Processing => $"Server processing {_state.Upload.FileName}: scanning, validating, parsing, and committing eligible rows. Progress is indeterminate.",
        UploadOperationStatus.Complete => $"Complete: {_state.Upload.FileName}",
        UploadOperationStatus.Canceled => $"Canceled: {_state.Upload.FileName}. Confirm the import to retry.",
        UploadOperationStatus.Failed => $"Failed: {_state.Upload.FailureMessage}",
        _ => string.Empty,
    };

    private void SetConflictDecision(ImportCustomerConflictState conflictState, string decision)
    {
        conflictState.SetDecision(decision, _state.FieldMappings);
    }

    private IReadOnlyList<CustomerImportFieldMapping> GetVisibleConflictFieldMappings() =>
        _state.FieldMappings
            .Where(mapping => mapping.MatchedCsvHeader is not null || GetEffectiveMappingValue(mapping.Field.Name, mapping.MatchedCsvHeader) is not null)
            .ToList()
            .AsReadOnly();

    private IReadOnlyList<ImportCustomersDuplicateResolutionItem> GetDuplicateResolutionItems() =>
        _state.ConflictStates
            .Select(conflictState => new ImportCustomersDuplicateResolutionItem
            {
                Email = conflictState.Email,
                Decision = conflictState.Decision,
                IsResolved = conflictState.IsResolved,
                UseExistingFieldSelections = conflictState.FieldSelections.ToDictionary(
                    selection => selection.Key,
                    selection => selection.Value == ImportConflictFieldSource.Existing,
                    StringComparer.OrdinalIgnoreCase),
                ExistingValues = new Dictionary<string, string>(conflictState.ExistingValues, StringComparer.OrdinalIgnoreCase),
                IncomingValues = new Dictionary<string, string>(conflictState.IncomingValues, StringComparer.OrdinalIgnoreCase),
            })
            .ToList()
            .AsReadOnly();

    private Task OnConflictDecisionChanged((int ConflictIndex, string Decision) args)
    {
        SetConflictDecision(_state.ConflictStates[args.ConflictIndex], args.Decision);
        return Task.CompletedTask;
    }

    private Task OnConflictFieldSourceChanged((int ConflictIndex, string FieldName, bool UseExisting) args)
    {
        SetFieldSource(
            _state.ConflictStates[args.ConflictIndex],
            args.FieldName,
            args.UseExisting ? ImportConflictFieldSource.Existing : ImportConflictFieldSource.Incoming);
        return Task.CompletedTask;
    }

    private Task BackToPreview()
    {
        _state.Step = ImportCustomersWorkflowStep.Preview;
        return Task.CompletedTask;
    }

    private static void SetFieldSource(ImportCustomerConflictState conflictState, string fieldName, ImportConflictFieldSource source)
    {
        conflictState.SetFieldSource(fieldName, source);
    }

    private Task<IReadOnlyList<ImportCustomerConflictState>> LoadConflictStates(
        IReadOnlyList<ImportConflictDto> conflicts,
        ReadOnlyMemory<byte> mappedFileBytes,
        CancellationToken ct)
    {
        return ImportCustomersConflictLoader.LoadConflictStates(
            CustomersApi,
            conflicts,
            mappedFileBytes,
            ct);
    }

    public async ValueTask DisposeAsync()
    {
        var uploadCancellation = _activeUploadCancellation;
        if (uploadCancellation is null)
        {
            return;
        }

        _activeUploadCancellation = null;
        _state.Upload.Cancel(_state.Upload.OperationId);
        await uploadCancellation.CancelAsync();
        uploadCancellation.Dispose();
    }
}
