@if (Window is { PageCount: > 1 } window)
{
    <nav aria-label="@Label">
        <button type="button" disabled="@(Disabled || window.Page <= 1)" @onclick="() => Changed.InvokeAsync(window.Page - 1)">Previous page</button>
        <span>Page @window.Page of @window.PageCount (@window.TotalCount records)</span>
        <button type="button" disabled="@(Disabled || window.Page >= window.PageCount)" @onclick="() => Changed.InvokeAsync(window.Page + 1)">Next page</button>
    </nav>
}

@code {
    [Parameter, EditorRequired] public required string Label { get; set; }
    [Parameter] public BookingFinancialPageWindowDto? Window { get; set; }
    [Parameter] public EventCallback<int> Changed { get; set; }
    [Parameter] public bool Disabled { get; set; }
}
