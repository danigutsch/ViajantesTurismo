@inject IUiFailureReporter Failures
@inject TimeProvider TimeProvider
@page "/bookings/{id:guid}/edit"
@implements IAsyncDisposable
@using PandaBear.HttpClients
@using ViajantesTurismo.Admin.Contracts.Application
@using ViajantesTurismo.Management.Web.Helpers
@inject IBookingsApiClient BookingsApi
@inject ICustomersApiClient CustomersApi
@inject NavigationManager Navigation

<PageTitle>Edit Booking</PageTitle>

<h1>Edit Booking</h1>

<ConfirmDialog @ref="_confirmDialog" />
<ToastNotification @ref="_toast" />

@if (_loading)
{
    <p><em>Loading...</em></p>
}
else if (_notFound)
{
    <div class="alert alert-danger" role="alert">
        Booking not found.
    </div>
    <NavLink href="/bookings" class="btn btn-secondary">Back to Bookings</NavLink>
}
else if (!string.IsNullOrEmpty(_loadErrorMessage))
{
    <div class="alert alert-danger" role="alert">
        @_loadErrorMessage
    </div>
    <NavLink href="/bookings" class="btn btn-secondary">Back to Bookings</NavLink>
}
else if (_booking is not null)
{
    @if (_success)
    {
        <div class="alert alert-success" role="alert">
            Booking updated successfully!
        </div>
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger" role="alert">
            @_errorMessage
        </div>
    }

    @if (!string.IsNullOrEmpty(_refreshWarningMessage))
    {
        <div class="alert alert-warning" role="alert">
            @_refreshWarningMessage
        </div>
    }

    <div class="card mb-4">
        <div class="card-header">
            <h5 class="card-title mb-0">Booking Information</h5>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Tour:</dt>
                <dd class="col-sm-9">
                    <a href="/tours/@_booking.TourId">@_booking.TourName</a>
                    <br/>
                    <small class="text-muted">@_booking.TourIdentifier</small>
                </dd>

                <dt class="col-sm-3">Customer:</dt>
                <dd class="col-sm-9">
                    <a href="/customers/@_booking.CustomerId">@_booking.CustomerName</a>
                </dd>

                @if (_booking.CompanionId.HasValue)
                {
                    <dt class="col-sm-3">Companion:</dt>
                    <dd class="col-sm-9">
                        <a href="/customers/@_booking.CompanionId">@_booking.CompanionName</a>
                    </dd>
                }

                <dt class="col-sm-3">Booking Date:</dt>
                <dd class="col-sm-9">@DateFormatter.FormatDateTime(_booking.BookingDate)</dd>

                <dt class="col-sm-3">Status:</dt>
                <dd class="col-sm-9"><BookingStatusBadge Status="@_booking.Status" /></dd>

                <dt class="col-sm-3">Payment Status:</dt>
                <dd class="col-sm-9"><PaymentStatusBadge Status="@_booking.PaymentStatus" /></dd>
            </dl>
        </div>
    </div>

    <EditForm Model="@_model" OnValidSubmit="@HandleSubmit" FormName="editBooking">
        <DataAnnotationsValidator/>
        <ValidationSummary/>

        <div class="card mb-4">
            <div class="card-header">
                <h5 class="card-title mb-0">Edit Details</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="totalPrice" class="form-label">Total Price (Calculated)</label>
                        <input type="text" id="totalPrice" class="form-control"
                               value="@CurrencyFormatter.Format(_booking.TotalPrice, _booking.Currency)" readonly/>
                        <div class="form-text">Price is automatically calculated from room type and bikes</div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label for="roomType" class="form-label">Room Type <span class="text-danger">*</span></label>
                        <InputSelect id="roomType" class="form-select" @bind-Value="_model.RoomType"
                                     @bind-Value:after="OnRoomTypeChanged" disabled="@AreEditControlsDisabled">
                            <option value="@RoomTypeDto.DoubleOccupancy">Double Room</option>
                            <option value="@RoomTypeDto.SingleOccupancy">Single Room</option>
                        </InputSelect>
                        <ValidationMessage For="@(() => _model.RoomType)"/>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="principalBikeType" class="form-label">Principal Bike <span class="text-danger">*</span></label>
                        <InputSelect id="principalBikeType" class="form-select" @bind-Value="_model.PrincipalBikeType" disabled="@AreEditControlsDisabled">
                            <option value="@BikeTypeDto.None">-- Select Bike Type --</option>
                            <option value="@BikeTypeDto.Regular">Regular Bike</option>
                            <option value="@BikeTypeDto.EBike">E-Bike</option>
                        </InputSelect>
                        <ValidationMessage For="@(() => _model.PrincipalBikeType)"/>
                    </div>

                    @if (_model.RoomType == RoomTypeDto.DoubleOccupancy)
                    {
                        <div class="col-md-6 mb-3">
                            <label for="companionId" class="form-label">Companion (Optional)</label>
                             <InputSelect id="companionId" class="form-select" @bind-Value="_model.CompanionId"
                                          @bind-Value:after="OnCompanionChanged" disabled="@AreEditControlsDisabled">
                                 <option value="">-- No Companion --</option>
                                 @if (_booking.CompanionId.HasValue &&
                                      _customers.All(customer => customer.Id != _booking.CompanionId.Value))
                                 {
                                     <option value="@_booking.CompanionId">@_booking.CompanionName</option>
                                 }
                                 @foreach (var customer in _customers.Where(customer => customer.Id != _booking.CustomerId))
                                 {
                                     <option value="@customer.Id">@customer.FirstName @customer.LastName</option>
                                 }
                             </InputSelect>
                             <ValidationMessage For="@(() => _model.CompanionId)"/>
                             @if (_companionChoicesUnavailable)
                             {
                                 <div class="form-text text-warning" role="status">
                                     Other companion choices are unavailable. The current companion can still be kept or removed.
                                 </div>
                             }
                        </div>
                    }
                </div>

                @if (_model is { RoomType: RoomTypeDto.DoubleOccupancy, CompanionId: not null })
                {
                    <div class="mb-3">
                        <label for="companionBikeType" class="form-label">Companion Bike <span class="text-danger">*</span></label>
                        <InputSelect id="companionBikeType" class="form-select" @bind-Value="_model.CompanionBikeType" disabled="@AreEditControlsDisabled">
                            <option value="">-- Select Bike Type --</option>
                            <option value="@BikeTypeDto.Regular">Regular Bike</option>
                            <option value="@BikeTypeDto.EBike">E-Bike</option>
                        </InputSelect>
                        <ValidationMessage For="@(() => _model.CompanionBikeType)"/>
                    </div>
                }

                <div class="mb-3">
                    <label for="notes" class="form-label">Notes</label>
                    <InputTextArea id="notes" class="form-control" @bind-Value="_model.Notes" rows="4" placeholder="Additional notes or comments..."
                                   disabled="@AreMutationsBlocked"/>
                    <ValidationMessage For="@(() => _model.Notes)"/>
                </div>

                <div class="card mb-3">
                    <div class="card-header">
                        <h5 class="card-title mb-0"><i class="bi bi-percent"></i> Discount</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label for="discountType" class="form-label">Discount Type</label>
                            <InputSelect id="discountType" class="form-select" @bind-Value="_model.DiscountType"
                                         disabled="@AreEditControlsDisabled">
                                <option value="@DiscountTypeDto.None">No Discount</option>
                                <option value="@DiscountTypeDto.Percentage">Percentage (0-100%)</option>
                                <option value="@DiscountTypeDto.Absolute">Absolute Amount</option>
                            </InputSelect>
                            <ValidationMessage For="@(() => _model.DiscountType)"/>
                        </div>

                        @if (_model.DiscountType != DiscountTypeDto.None)
                        {
                            <div class="mb-3">
                                <label for="discountAmount" class="form-label">
                                    @if (_model.DiscountType == DiscountTypeDto.Percentage)
                                    {
                                        <text>Discount Percentage <span class="text-danger">*</span></text>
                                    }
                                    else
                                    {
                                        <text>Discount Amount <span class="text-danger">*</span></text>
                                    }
                                </label>
                                <InputNumber id="discountAmount" class="form-control" @bind-Value="_model.DiscountAmount"
                                             step="0.01"
                                             disabled="@AreEditControlsDisabled"/>
                                <ValidationMessage For="@(() => _model.DiscountAmount)"/>
                                @if (_model.DiscountType == DiscountTypeDto.Percentage)
                                {
                                    <div class="form-text">Enter a value between 0 and 100</div>
                                }
                            </div>

                            <div class="mb-3">
                                <label for="discountReason" class="form-label">Discount Reason <span class="text-danger">*</span></label>
                                <InputTextArea id="discountReason" class="form-control" @bind-Value="_model.DiscountReason"
                                               rows="2" placeholder="e.g., Early bird discount, Loyalty customer, Group discount"
                                               disabled="@AreEditControlsDisabled"/>
                                <ValidationMessage For="@(() => _model.DiscountReason)"/>
                                <div class="form-text">Required for audit purposes (10-500 characters)</div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary"
                    disabled="@(_redirectState.IsPending || AreMutationsBlocked)">
                @if (_isSubmitting)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                    <text>Updating...</text>
                }
                else
                {
                    <text>Update Booking</text>
                }
            </button>
            <NavLink href="/bookings"
                     class="@($"btn btn-secondary {(IsMutationInFlight || _redirectState.IsPending ? "disabled" : "")}")">
                Cancel
            </NavLink>
        </div>
    </EditForm>

    <div class="card mt-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0"><i class="bi bi-cash-stack"></i> Payments</h5>
            <a class="btn btn-sm btn-success" href="@($"/bookings/{_booking.Id}/finances")">Record and allocate receipts</a>
        </div>
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-4">
                    <div class="card bg-light">
                        <div class="card-body py-2 text-center">
                            <div class="text-muted small">Total Price</div>
                            <div class="h5 mb-0">@CurrencyFormatter.Format(_booking.TotalPrice, _booking.Currency)</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card bg-light">
                        <div class="card-body py-2 text-center">
                            <div class="text-muted small">Amount Paid</div>
                            <div class="h5 mb-0 text-success">@CurrencyFormatter.Format(_booking.AmountPaid, CurrencyDto.Euro)</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card bg-light">
                        <div class="card-body py-2 text-center">
                            <div class="text-muted small">Remaining Balance</div>
                            <div class="h5 mb-0 text-danger">@CurrencyFormatter.Format(_booking.RemainingBalance, CurrencyDto.Euro)</div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <BookingEditActionPanel
        Booking="@_booking"
        IsSubmitting="@AreMutationsBlocked"
        Confirm="HandleConfirm"
        Complete="HandleComplete"
        Cancel="HandleCancel"
        Delete="HandleDelete" />

    @if (_redirectState.IsPending)
    {
        <div class="alert alert-info d-flex align-items-center justify-content-between mt-4" role="alert">
            <span>
                Redirecting to bookings page in 3 seconds...
            </span>
            <button class="btn btn-sm btn-outline-danger ms-3" @onclick="CancelRedirect">Cancel</button>
        </div>
    }
    else if (_redirectState.IsCancelled)
    {
        <div class="alert alert-success d-flex align-items-center justify-content-between mt-4" role="alert">
            <span>Booking updated successfully!</span>
            <button class="btn btn-sm btn-primary ms-3" @onclick="GoToBookings">Go to Bookings</button>
        </div>
    }
}

@code {
    private const int MaxCompanionChoices = 500;

    /// <summary>
    /// The ID of the booking to edit.
    /// </summary>
    [Parameter]
    public Guid Id { get; set; }

    private GetBookingDto? _booking;
    private readonly BookingFormModel _model = new();
    private IReadOnlyList<GetCustomerDto> _customers = [];
    private bool _loading = true;
    private bool _notFound;
    private bool _isSubmitting;
    private bool _success;
    private bool _companionChoicesUnavailable;
    private readonly BookingEditRedirectState _redirectState = new();
    private string? _loadErrorMessage;
    private string? _errorMessage;
    private string? _refreshWarningMessage;


    private ConfirmDialog? _confirmDialog;
    private ToastNotification? _toast;

    private bool IsMutationInFlight => _isSubmitting;

    private bool AreMutationsBlocked => RequiresReload || IsMutationInFlight;

    private bool AreEditControlsDisabled => AreMutationsBlocked || _booking?.CanModifyBookedServices is false;

    private bool RequiresReload => !string.IsNullOrEmpty(_refreshWarningMessage);

    protected override async Task OnInitializedAsync()
    {
        _loadErrorMessage = null;
        _notFound = false;
        try
        {
            var outcome = await BookingsApi.GetBookingById(Id, CancellationToken.None);
            if (outcome is { Kind: HttpOutcomeKind.Succeeded, Value: { } booking })
            {
                _booking = booking;
                SyncModelFromBooking();
                await LoadCompanionChoices();
            }
            else if (outcome.Kind == HttpOutcomeKind.NotFound)
            {
                _notFound = true;
            }
            else
            {
                _loadErrorMessage = new HttpOutcomeMessages(UserFacingErrorMessage.ForOperation("load the booking")).For(outcome.Kind);
            }
        }
        catch (Exception exception)
        {
            Failures.Report(exception, "bookings.edit.load");
            _loadErrorMessage = UserFacingErrorMessage.ForOperation("load the booking");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task HandleSubmit()
    {
        if (_booking is null || AreMutationsBlocked)
        {
            return;
        }

        _isSubmitting = true;
        _success = false;
        _errorMessage = null;
        _refreshWarningMessage = null;
        await _redirectState.Reset();
        var mutationAttempted = false;

        try
        {
            var normalizedDiscountReason = string.IsNullOrWhiteSpace(_model.DiscountReason)
                ? null
                : _model.DiscountReason;

            if (_model.RoomType != _booking.RoomType ||
                _model.PrincipalBikeType != _booking.PrincipalBikeType ||
                _model.CompanionId != _booking.CompanionId ||
                _model.CompanionBikeType != _booking.CompanionBikeType)
            {
                var detailsDto = new UpdateBookingDetailsDto
                {
                    RoomType = _model.RoomType,
                    PrincipalBikeType = _model.PrincipalBikeType,
                    CompanionCustomerId = _model.CompanionId,
                    CompanionBikeType = _model.CompanionBikeType
                };
                mutationAttempted = true;
                var outcome = await BookingsApi.UpdateBookingDetails(Id, detailsDto, CancellationToken.None);
                if (!EnsureSucceeded(outcome, "update the booking"))
                {
                    await ReconcileAfterFailedMutation();
                    return;
                }

                var companionName = _model.CompanionId == _booking.CompanionId
                    ? _booking.CompanionName
                    : _customers
                        .Where(customer => customer.Id == _model.CompanionId)
                        .Select(customer => $"{customer.FirstName} {customer.LastName}")
                        .FirstOrDefault();
                _booking = _booking with
                {
                    RoomType = _model.RoomType,
                    PrincipalBikeType = _model.PrincipalBikeType,
                    CompanionId = _model.CompanionId,
                    CompanionName = companionName,
                    CompanionBikeType = _model.CompanionBikeType
                };
            }

            // Update discount if changed
            if (_model.DiscountType != _booking.DiscountType ||
                _model.DiscountAmount != _booking.DiscountAmount ||
                normalizedDiscountReason != _booking.DiscountReason)
            {
                var discountDto = new UpdateBookingDiscountDto
                {
                    DiscountType = _model.DiscountType,
                    DiscountAmount = _model.DiscountAmount,
                    DiscountReason = normalizedDiscountReason
                };
                mutationAttempted = true;
                var outcome = await BookingsApi.UpdateBookingDiscount(Id, discountDto, CancellationToken.None);
                if (!EnsureSucceeded(outcome, "update the booking"))
                {
                    await ReconcileAfterFailedMutation();
                    return;
                }

                _booking = _booking with
                {
                    DiscountType = _model.DiscountType,
                    DiscountAmount = _model.DiscountAmount,
                    DiscountReason = normalizedDiscountReason
                };
            }

            // Update notes if changed
            if (_model.Notes != _booking.Notes)
            {
                var notesDto = new UpdateBookingNotesDto { Notes = _model.Notes };
                mutationAttempted = true;
                var outcome = await BookingsApi.UpdateBookingNotes(Id, notesDto, CancellationToken.None);
                if (!EnsureSucceeded(outcome, "update the booking"))
                {
                    await ReconcileAfterFailedMutation();
                    return;
                }

                _booking = _booking with { Notes = _model.Notes };
            }

            await TryRefreshBookingAndSyncModel();
            _success = true;
            var token = _redirectState.BeginPendingRedirect();
            StateHasChanged();

            try
            {
                await Task.Delay(3000, token);
                if (_redirectState.CanNavigate(token))
                {
                    Navigation.NavigateTo("/bookings");
                }
            }
            catch (TaskCanceledException)
            {
                /* Cancelled by the user */
            }
            finally
            {
                await _redirectState.DisposeCancellation();
            }
        }
        catch (Exception exception)
        {
            Failures.Report(exception, "bookings.edit.update");
            _errorMessage = UserFacingErrorMessage.ForOperation("update the booking");
            if (mutationAttempted)
            {
                await ReconcileAfterFailedMutation();
            }
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task CancelRedirect()
    {
        await _redirectState.CancelPendingRedirect();
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        await _redirectState.DisposeAsync();
    }

    private void GoToBookings()
    {
        Navigation.NavigateTo("/bookings");
    }

    private async Task HandleConfirm()
    {
        await ExecuteBookingAction(
            cancellationToken => BookingsApi.ConfirmBooking(Id, cancellationToken),
            "Booking confirmed successfully.",
            "confirm the booking");
    }

    private async Task HandleCancel()
    {
        if (!await ConfirmBookingAction(
                "Are you sure you want to cancel this booking?",
                "Cancel Booking",
                "Yes, Cancel",
                "btn-warning"))
        {
            return;
        }

        await ExecuteBookingAction(
            cancellationToken => BookingsApi.CancelBooking(Id, cancellationToken),
            "Booking cancelled successfully.",
            "cancel the booking");
    }

    private async Task HandleComplete()
    {
        await ExecuteBookingAction(
            cancellationToken => BookingsApi.CompleteBooking(Id, cancellationToken),
            "Booking completed successfully.",
            "complete the booking");
    }

    private async Task HandleDelete()
    {
        if (!await ConfirmBookingAction(
                "Are you sure you want to delete this booking? This action cannot be undone.",
                "Delete Booking",
                "Yes, Delete",
                "btn-danger"))
        {
            return;
        }

        await ExecuteBookingAction(
            cancellationToken => BookingsApi.DeleteBooking(Id, cancellationToken),
            "Booking deleted successfully.",
            "delete the booking",
            refreshBooking: false,
            onSuccess: () => Navigation.NavigateTo("/bookings"));
    }

    private void SyncModelFromBooking()
    {
        if (_booking is null)
        {
            return;
        }

        _model.RoomType = _booking.RoomType;
        _model.PrincipalBikeType = _booking.PrincipalBikeType;
        _model.TourId = _booking.TourId;
        _model.CustomerId = _booking.CustomerId;
        _model.CompanionId = _booking.CompanionId;
        _model.CompanionBikeType = _booking.CompanionBikeType;
        _model.Notes = _booking.Notes;
        _model.DiscountType = _booking.DiscountType;
        _model.DiscountAmount = _booking.DiscountAmount;
        _model.DiscountReason = _booking.DiscountReason ?? string.Empty;
    }

    private void OnRoomTypeChanged()
    {
        if (_model.RoomType != RoomTypeDto.SingleOccupancy)
        {
            return;
        }

        _model.CompanionId = null;
        _model.CompanionBikeType = null;
    }

    private void OnCompanionChanged()
    {
        if (!_model.CompanionId.HasValue)
        {
            _model.CompanionBikeType = null;
            return;
        }

        var companion = _customers.FirstOrDefault(customer => customer.Id == _model.CompanionId.Value);
        if (companion is not null)
        {
            _model.CompanionBikeType = companion.BikeType;
        }
    }

    private async Task LoadCompanionChoices()
    {
        try
        {
            var outcome = await CustomersApi.GetCustomers(CancellationToken.None, maxItems: MaxCompanionChoices);
            if (outcome is { Kind: HttpOutcomeKind.Succeeded, Value: { } customers })
            {
                _customers = customers;
                _companionChoicesUnavailable = false;
                return;
            }

            _customers = [];
            _companionChoicesUnavailable = true;
        }
        catch (Exception exception)
        {
            Failures.Report(exception, "bookings.edit.load-companions");
            _customers = [];
            _companionChoicesUnavailable = true;
        }
    }

    private async Task<bool> TryRefreshBookingAndSyncModel()
    {
        try
        {
            var outcome = await BookingsApi.GetBookingById(Id, CancellationToken.None);
            if (outcome is not { Kind: HttpOutcomeKind.Succeeded, Value: { } refreshedBooking })
            {
                _refreshWarningMessage = "The change was saved, but we couldn't refresh the booking. Reload the page to see the latest calculated values.";
                return false;
            }

            _booking = refreshedBooking;
            SyncModelFromBooking();
            return true;
        }
        catch (Exception exception)
        {
            Failures.Report(exception, "bookings.edit.refresh-after-save");
            _refreshWarningMessage = "The change was saved, but we couldn't refresh the booking. Reload the page to see the latest calculated values.";
            return false;
        }
    }

    private async Task ReconcileAfterFailedMutation()
    {
        try
        {
            var outcome = await BookingsApi.GetBookingById(Id, CancellationToken.None);
            if (outcome is not { Kind: HttpOutcomeKind.Succeeded, Value: { } refreshedBooking })
            {
                _refreshWarningMessage = "Some changes may have been saved, but we couldn't refresh the booking. Reload the page before making another change.";
                return;
            }

            _booking = refreshedBooking;
        }
        catch (Exception exception)
        {
            Failures.Report(exception, "bookings.edit.reconcile");
            _refreshWarningMessage = "Some changes may have been saved, but we couldn't refresh the booking. Reload the page before making another change.";
        }
    }

    private async Task ExecuteBookingAction(
        Func<CancellationToken, Task<HttpOutcome>> action,
        string successMessage,
        string operationDescription,
        bool refreshBooking = true,
        Action? onSuccess = null)
    {
        if (AreMutationsBlocked)
        {
            return;
        }

        _isSubmitting = true;
        StateHasChanged();
        try
        {
            var outcome = await action(CancellationToken.None);
            if (outcome.Kind != HttpOutcomeKind.Succeeded)
            {
                _toast?.ShowError(new HttpOutcomeMessages(UserFacingErrorMessage.ForOperation(operationDescription)).For(outcome.Kind));
                return;
            }

            if (refreshBooking)
            {
                await TryRefreshBookingAndSyncModel();
            }

            _toast?.ShowSuccess(successMessage);
            onSuccess?.Invoke();
        }
        catch (Exception exception)
        {
            Failures.Report(exception, "bookings.edit.action");
            _toast?.ShowError(UserFacingErrorMessage.ForOperation(operationDescription));
        }
        finally
        {
            _isSubmitting = false;
            StateHasChanged();
        }
    }

    private bool EnsureSucceeded(HttpOutcome outcome, string operationDescription)
    {
        if (outcome.Kind == HttpOutcomeKind.Succeeded)
        {
            return true;
        }

        _errorMessage = new HttpOutcomeMessages(UserFacingErrorMessage.ForOperation(operationDescription)).For(outcome.Kind);
        return false;
    }

    private Task<bool> ConfirmBookingAction(
        string message,
        string title,
        string confirmText,
        string confirmButtonCssClass)
    {
        return _confirmDialog?.ShowAsync(message, title, confirmText, "No", confirmButtonCssClass)
            ?? Task.FromResult(false);
    }

}
