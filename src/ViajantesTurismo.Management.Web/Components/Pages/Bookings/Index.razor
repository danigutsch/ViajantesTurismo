@page "/bookings"
@using Microsoft.AspNetCore.Components.QuickGrid
@using ViajantesTurismo.Admin.Contracts.Application
@using ViajantesTurismo.Management.Web.Helpers

@inject IUiFailureReporter Failures
@inject IBookingsApiClient BookingsApi

<PageTitle>Bookings</PageTitle>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="bi bi-calendar-check"></i> All Bookings</h1>
    </div>

    @if (_errorMessage is not null)
    {
        <div class="alert alert-danger" role="alert">@_errorMessage</div>
    }
    else if (_counts is null)
    {
        <p><em>Loading bookings...</em></p>
    }
    else
    {
        <div class="card">
            <div class="card-header">
                <div class="row align-items-center">
                    <div class="col-md-6">
                        <h5 class="mb-0">Bookings Overview</h5>
                    </div>
                    <div class="col-md-6 text-end">
                        <span class="badge bg-secondary me-2">Total: @_counts.Total</span>
                        <span class="badge bg-warning text-dark me-2">Pending: @_counts.Pending</span>
                        <span class="badge bg-success me-2">Confirmed: @_counts.Confirmed</span>
                        <span class="badge bg-info me-2">Completed: @_counts.Completed</span>
                        <span class="badge bg-danger">Cancelled: @_counts.Cancelled</span>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <BookingsList ItemsProvider="_loadBookings" TotalBookings="_counts.Total" />
            </div>
        </div>
    }
</div>

@code {
    private GridItemsProvider<GetBookingDto>? _loadBookings;
    private GetBookingPageDto? _initialPage;
    private BookingOverviewCountsDto? _counts;
    private string? _errorMessage;

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        _loadBookings = LoadBookings;
        _initialPage = await FetchBookings(1, BookingPageSort.Default, descending: false, CancellationToken.None);
    }

    private async ValueTask<GridItemsProviderResult<GetBookingDto>> LoadBookings(GridItemsProviderRequest<GetBookingDto> request)
    {
        var (pageNumber, sort, descending) = BookingsList.GetPageRequest(request);
        var initialPage = _initialPage;
        _initialPage = null;
        if (initialPage is not null && pageNumber == 1 && sort == BookingPageSort.Default && !descending)
        {
            return GridItemsProviderResult.From(initialPage.Items.ToArray(), initialPage.Counts.Total);
        }

        var previousCounts = _counts;
        var page = await FetchBookings(pageNumber, sort, descending, request.CancellationToken);
        if (_counts != previousCounts)
        {
            await InvokeAsync(StateHasChanged);
        }

        return page is not null
            ? GridItemsProviderResult.From(page.Items.ToArray(), page.Counts.Total)
            : GridItemsProviderResult.From(Array.Empty<GetBookingDto>(), 0);
    }

    private async ValueTask<GetBookingPageDto?> FetchBookings(int pageNumber, BookingPageSort sort, bool descending, CancellationToken ct)
    {
        try
        {
            var outcome = await BookingsApi.GetBookingPage(pageNumber, sort, descending, ct);
            ct.ThrowIfCancellationRequested();
            if (outcome is { Kind: HttpOutcomeKind.Succeeded, Value: { } page })
            {
                _counts = page.Counts;
                _errorMessage = null;
                return page;
            }

            _errorMessage = new HttpOutcomeMessages(UserFacingErrorMessage.ForOperation("load bookings")).For(outcome.Kind);
        }
        catch (Exception exception) when (!ct.IsCancellationRequested)
        {
            Failures.Report(exception, "bookings.index.load");
            _errorMessage = UserFacingErrorMessage.ForOperation("load bookings");
        }

        _counts = null;
        return null;
    }
}
