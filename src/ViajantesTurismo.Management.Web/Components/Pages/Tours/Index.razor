@page "/tours"
@using Microsoft.AspNetCore.Components.QuickGrid
@using ViajantesTurismo.Admin.Contracts.Application
@using ViajantesTurismo.Management.Web.Helpers

@inject IToursApiClient ToursApi

<PageTitle>Tours</PageTitle>

<h1><i class="bi bi-list-nested"></i> Tours</h1>

@if (_errorMessage is not null)
{
    <div class="alert alert-danger" role="alert">@_errorMessage</div>
}
else if (_total is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="table-responsive-wrapper">
    <QuickGrid TGridItem="GetTourListItemDto" ItemsProvider="@_loadTours" Class="table table-hover" Pagination="@_pagination">
        <PropertyColumn Property="@(t => t.Identifier)" Title="Identifier" Sortable="true" />
        <PropertyColumn Property="@(t => t.Name)" Title="Name" Sortable="true" />
        <PropertyColumn Property="@(t => t.StartDate)" Title="Start Date" Format="@DateFormatter.DateFormat"
                        Sortable="true"/>
        <PropertyColumn Property="@(t => t.EndDate)" Title="End Date" Format="@DateFormatter.DateFormat"
                        Sortable="true"/>

        <TemplateColumn Title="Price" Sortable="true" SortBy="GridSort<GetTourListItemDto>.ByAscending(t => t.Price)">
            @FormatPrice(context.Price, context.Currency)
        </TemplateColumn>

        <TemplateColumn Title="Single Room Supplement">
            @FormatPrice(context.SingleRoomSupplementPrice, context.Currency)
        </TemplateColumn>

        <TemplateColumn Title="Regular Bike">
            @FormatPrice(context.RegularBikePrice, context.Currency)
        </TemplateColumn>

        <TemplateColumn Title="E-Bike">
            @FormatPrice(context.EBikePrice, context.Currency)
        </TemplateColumn>

        <TemplateColumn Title="Capacity" Sortable="true"
                        SortBy="GridSort<GetTourListItemDto>.ByAscending(t => t.CurrentCustomerCount)">
            <div class="d-flex align-items-center gap-2">
                <span class="text-nowrap">@context.CurrentCustomerCount / @context.MaxCustomers</span>
                @if (context.IsFullyBooked)
                {
                    <span class="badge bg-danger" title="Tour is fully booked">
                        <i class="bi bi-exclamation-circle"></i> Full
                    </span>
                }
                else if (!context.IsAtMinimumCapacity)
                {
                    <span class="badge bg-warning text-dark"
                          title="Below minimum capacity (@context.MinCustomers customers)">
                        <i class="bi bi-exclamation-triangle"></i> Below Min
                    </span>
                }
                else
                {
                    <span class="badge bg-success" title="@context.AvailableSpots spots available">
                        <i class="bi bi-check-circle"></i> @context.AvailableSpots spots
                    </span>
                }
            </div>
        </TemplateColumn>

        <TemplateColumn Title="Actions">
            <div class="btn-group" role="group">
                <NavLink href="@GetTourDetailsUrl(context.Id)" class="btn btn-sm btn-info">
                    <i class="bi bi-eye"></i> View
                </NavLink>
                <NavLink href="@GetTourEditUrl(context.Id)" class="btn btn-sm btn-primary">
                    <i class="bi bi-pencil"></i> Edit
                </NavLink>
            </div>
        </TemplateColumn>
    </QuickGrid>
    </div>

    @if (_total > ContractConstants.TourListPageSize)
    {
        <Paginator State="@_pagination" />
    }

    <div class="mt-3">
        <p class="text-muted">Total tours: @_total</p>
    </div>
}

@code {
    private GridItemsProvider<GetTourListItemDto>? _loadTours;
    private GetTourPageDto? _initialPage;
    private int? _total;
    private string? _errorMessage;
    private readonly PaginationState _pagination = new() { ItemsPerPage = ContractConstants.TourListPageSize };

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        _loadTours = LoadTours;
        _initialPage = await FetchTours(1, TourPageSort.Default, descending: false, CancellationToken.None);
    }

    private async ValueTask<GridItemsProviderResult<GetTourListItemDto>> LoadTours(
        GridItemsProviderRequest<GetTourListItemDto> request)
    {
        var sort = request.GetSortByProperties().FirstOrDefault().PropertyName switch
        {
            nameof(GetTourListItemDto.Identifier) => TourPageSort.Identifier,
            nameof(GetTourListItemDto.Name) => TourPageSort.Name,
            nameof(GetTourListItemDto.StartDate) => TourPageSort.StartDate,
            nameof(GetTourListItemDto.EndDate) => TourPageSort.EndDate,
            nameof(GetTourListItemDto.Price) => TourPageSort.Price,
            nameof(GetTourListItemDto.CurrentCustomerCount) => TourPageSort.CurrentCustomerCount,
            _ => TourPageSort.Default
        };
        var pageNumber = (request.StartIndex / ContractConstants.TourListPageSize) + 1;
        var descending = request.SortByColumn is not null && !request.SortByAscending;
        var first = _initialPage;
        _initialPage = null;
        if (first is not null && pageNumber == 1 && sort == TourPageSort.Default && !descending)
        {
            return GridItemsProviderResult.From(first.Items.ToArray(), first.Total);
        }

        var previousTotal = _total;
        var page = await FetchTours(pageNumber, sort, descending, request.CancellationToken);
        if (_total != previousTotal)
        {
            await InvokeAsync(StateHasChanged);
        }

        return page is not null
            ? GridItemsProviderResult.From(page.Items.ToArray(), page.Total)
            : GridItemsProviderResult.From(Array.Empty<GetTourListItemDto>(), 0);
    }

    private async Task<GetTourPageDto?> FetchTours(int page, TourPageSort sort, bool descending, CancellationToken ct)
    {
        _errorMessage = null;
        var outcome = await ToursApi.GetTourPage(page, sort, descending, ct);
        ct.ThrowIfCancellationRequested();
        if (outcome is { Kind: HttpOutcomeKind.Succeeded, Value: { } tours })
        {
            _total = tours.Total;
            return tours;
        }

        _total = null;
        _errorMessage = new HttpOutcomeMessages("Tours could not be loaded. Try again later.").For(outcome.Kind);
        return null;
    }

    private static string FormatPrice(decimal price, string currency) => Money.Restore(price, Currency.Restore(currency)).ToString("C", CultureInfo.CurrentUICulture);

    private static string GetTourDetailsUrl(Guid tourId) => $"/tours/{tourId}";

    private static string GetTourEditUrl(Guid tourId) => $"/edittour/{tourId}";
}
