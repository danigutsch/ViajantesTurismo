@using ViajantesTurismo.Catalog.Contracts.Application
@page "/catalog/tours"
@using Microsoft.AspNetCore.Components.QuickGrid

@inject ICatalogToursApiClient CatalogToursApi

<PageTitle>Catalog Tours</PageTitle>

<h1><i class="bi bi-card-list"></i> Catalog Tours</h1>

<p class="text-muted">Manage customer-facing tour presentation separately from Admin tour operations.</p>

@if (_errorMessage is not null)
{
    <div class="alert alert-danger" role="alert">@_errorMessage</div>
}
else if (_total is null)
{
    <p><em>Loading...</em></p>
}
else if (_total == 0)
{
    <div class="alert alert-info" role="status">
        No Catalog tours are available yet. Catalog drafts are created after Admin tour events are ingested.
    </div>
}
else
{
    <div class="table-responsive-wrapper">
        <QuickGrid TGridItem="CatalogTourListItemDto" ItemsProvider="@_loadTours" Class="table table-hover" Pagination="@_pagination">
            <PropertyColumn Property="@(tour => tour.Identifier)" Title="Identifier" Sortable="true" />
            <PropertyColumn Property="@(tour => tour.Title)" Title="Public Title" Sortable="true" IsDefaultSortColumn="true" />
            <PropertyColumn Property="@(tour => tour.Slug)" Title="Slug" Sortable="true" />

            <TemplateColumn Title="Status" Sortable="true" SortBy="GridSort<CatalogTourListItemDto>.ByAscending(tour => tour.IsPublished)">
                @if (context.IsPublished)
                {
                    <span class="badge bg-success">Published</span>
                }
                else
                {
                    <span class="badge bg-secondary">Draft</span>
                }
            </TemplateColumn>

            <TemplateColumn Title="Updated">
                <span>@context.UpdatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
            </TemplateColumn>

            <TemplateColumn Title="Actions">
                <a class="btn btn-sm btn-outline-primary" href="@($"/catalog/tours/{context.Id}/presentation")">Edit presentation</a>
                <a class="btn btn-sm btn-outline-secondary ms-1" href="@($"/catalog/tours/{context.Id}/gallery-editor")">Edit gallery</a>
                <a class="btn btn-sm btn-outline-secondary ms-1" href="@($"/catalog/tours/{context.Id}/images/upload")">Upload image</a>
                <a class="btn btn-sm btn-outline-secondary ms-1" href="@($"/catalog/tours/{context.Id}/images/review")">Review images</a>
            </TemplateColumn>
        </QuickGrid>
    </div>

    @if (_total > CatalogTourPageDto.ItemsPerPage)
    {
        <Paginator State="@_pagination" />
    }
}

@code {
    private GridItemsProvider<CatalogTourListItemDto>? _loadTours;
    private CatalogTourPageDto? _initialPage;
    private int? _total;
    private string? _errorMessage;
    private readonly PaginationState _pagination = new() { ItemsPerPage = CatalogTourPageDto.ItemsPerPage };

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        _loadTours = LoadTours;
        _initialPage = await FetchTours(1, CatalogTourListSort.Title, descending: false, CancellationToken.None);
    }

    private async ValueTask<GridItemsProviderResult<CatalogTourListItemDto>> LoadTours(
        GridItemsProviderRequest<CatalogTourListItemDto> request)
    {
        var sort = request.GetSortByProperties().FirstOrDefault().PropertyName switch
        {
            nameof(CatalogTourListItemDto.Identifier) => CatalogTourListSort.Identifier,
            nameof(CatalogTourListItemDto.Slug) => CatalogTourListSort.Slug,
            nameof(CatalogTourListItemDto.IsPublished) => CatalogTourListSort.IsPublished,
            _ => CatalogTourListSort.Title,
        };
        var pageNumber = (request.StartIndex / CatalogTourPageDto.ItemsPerPage) + 1;
        var descending = request.SortByColumn is not null && !request.SortByAscending;
        var initialPage = _initialPage;
        _initialPage = null;
        if (initialPage is not null && pageNumber == 1 && sort == CatalogTourListSort.Title && !descending)
        {
            return GridItemsProviderResult.From(initialPage.Items.ToArray(), initialPage.Total);
        }

        var previousTotal = _total;
        var page = await FetchTours(pageNumber, sort, descending, request.CancellationToken);
        if (_total != previousTotal)
        {
            await InvokeAsync(StateHasChanged);
        }

        return page is not null
            ? GridItemsProviderResult.From(page.Items.ToArray(), page.Total)
            : GridItemsProviderResult.From(Array.Empty<CatalogTourListItemDto>(), 0);
    }

    private async ValueTask<CatalogTourPageDto?> FetchTours(int pageNumber, CatalogTourListSort sort, bool descending, CancellationToken ct)
    {
        _errorMessage = null;
        var outcome = await CatalogToursApi.GetTourPage(pageNumber, sort, descending, ct);
        ct.ThrowIfCancellationRequested();
        if (outcome is { Kind: HttpOutcomeKind.Succeeded, Value: { } page })
        {
            _total = page.Total;
            return page;
        }

        _errorMessage = new HttpOutcomeMessages("Catalog tours could not be loaded. Try again later.").For(outcome.Kind);
        _total = 0;
        return null;
    }
}
