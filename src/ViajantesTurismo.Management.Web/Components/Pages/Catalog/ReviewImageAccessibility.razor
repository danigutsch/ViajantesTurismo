@page "/catalog/tours/{Id:guid}/images/review"
@using System.ComponentModel
@using CatalogContractConstants = ViajantesTurismo.Catalog.Contracts.Application.ContractConstants
@using ViajantesTurismo.Management.Web.Services
@using Microsoft.AspNetCore.Routing
@using PandaBear.HttpClients
@using ViajantesTurismo.Catalog.Contracts.Application
@inject ICatalogToursApiClient CatalogToursApi
@inject LinkGenerator LinkGenerator
@inject MediaLanguageGuidance LanguageGuidance

<PageTitle>Review Image Accessibility</PageTitle>

<h1>Review Image Accessibility</h1>

@if (_loading)
{
    <p><em>Loading images...</em></p>
}
else
{
    @if (_success)
    {
        <div class="alert alert-success" role="status">Accessibility text approved for publication.</div>
    }
    @if (_errorMessage is not null)
    {
        <div class="alert alert-danger" role="alert">@_errorMessage</div>
    }
    @if (_image is null)
    {
        @if (_errorMessage is null)
        {
            <div class="alert alert-info" role="status">No images require accessibility review.</div>
        }
    }
    else
    {
        <div class="mb-3">
            <label for="language" class="form-label">Declared language (BCP 47)</label>
            <select id="language" class="form-select" @bind="_language" @bind:after="SelectLanguage" disabled="@_saving">
                <option value="@PublicContentLanguageDto.EnUs">English (en-US)</option>
                <option value="@PublicContentLanguageDto.PtBr">Português (pt-BR)</option>
            </select>
        </div>
        <p><strong>AI draft:</strong> @(_isAiGenerated ? "Unapproved — Review required" : "Editor-provided")</p>
    @if (_image.ResponsiveVariants.FirstOrDefault() is { } preview && GetPreviewPath(_image.Id, preview) is { } previewPath)
    {
        <img src="@previewPath" alt="Preview for accessibility review" class="img-fluid mb-3" />
    }
    <div class="mb-3">
        <label for="altText" class="form-label">Image description</label>
        <textarea id="altText" class="form-control" @bind="_altText" @bind:after="ResetGuidance" disabled="@_saving" rows="4" maxlength="@CatalogContractConstants.MaxAltTextLength"></textarea>
    </div>
    <div class="mb-3">
        <label for="caption" class="form-label">Caption (optional)</label>
        <textarea id="caption" class="form-control" @bind="_caption" maxlength="@CatalogContractConstants.MaxCaptionLength"></textarea>
    </div>
    <p role="status">@GuidanceMessage</p>
    <button class="btn btn-outline-secondary mb-3" @onclick="CheckLanguage" disabled="@_saving">Check language (optional)</button>
    <div class="form-check mb-3">
        <InputCheckbox id="isDecorative" class="form-check-input" @bind-Value="_isDecorative" />
        <label for="isDecorative" class="form-check-label">This image is decorative</label>
    </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-primary" @onclick="GenerateDraft" disabled="@_saving">Generate AI draft</button>
            <button class="btn btn-primary" @onclick="Approve" disabled="@(_saving || (!_isDecorative && string.IsNullOrWhiteSpace(_altText)))">Approve description</button>
        </div>
    }
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private CatalogMediaImageDto? _image;
    private string _altText = string.Empty;
    private bool _isDecorative;
    private bool _isAiGenerated;
    private string? _caption;
    private PublicContentLanguageDto _language = PublicContentLanguageDto.EnUs;
    private string _guidance = "indeterminate";
    private string LanguageTag => _language == PublicContentLanguageDto.PtBr ? "pt-BR" : "en-US";
    private string GuidanceMessage => _guidance switch
    {
        "match" => "Detected primary language matches the declaration. You remain responsible for approval.",
        "mismatch" => "Detected primary language differs from the declaration. Check your selection; you can still approve your text.",
        _ => "Language is indeterminate or the local checker is unavailable. You can still approve your text."
    };

    private void ResetGuidance() => _guidance = "indeterminate";

    private async Task CheckLanguage()
    {
        _saving = true;
        _errorMessage = null;
        try
        {
            _guidance = await LanguageGuidance.Evaluate(_altText, LanguageTag, CancellationToken.None);
        }
        catch (Exception exception) when (exception is InvalidOperationException or IOException or UnauthorizedAccessException or Win32Exception)
        {
            _guidance = "indeterminate";
            _errorMessage = "The local language checker could not run. Ask an administrator to check its configuration. You can still approve your text.";
        }
        finally
        {
            _saving = false;
        }
    }

    private void SelectLanguage()
    {
        var text = _image?.AccessibilityTexts.FirstOrDefault(value => value.Language == _language);
        _altText = text?.AltText ?? (_language == PublicContentLanguageDto.EnUs ? _image?.AltText : null) ?? string.Empty;
        _caption = text?.Caption ?? (_language == PublicContentLanguageDto.EnUs ? _image?.Caption : null);
        _isDecorative = text?.IsDecorative ?? (_language == PublicContentLanguageDto.EnUs && _image?.IsDecorative == true);
        _isAiGenerated = text?.IsAiGenerated ?? (_language == PublicContentLanguageDto.EnUs && _image?.IsAiGenerated == true);
        ResetGuidance();
    }

    private void SelectPendingImage(CatalogMediaImageDto[] images)
    {
        _image = images.FirstOrDefault(image => image.RequiresHumanReview || image.AccessibilityTexts.Any(text => text.RequiresHumanReview));
        _language = _image?.AccessibilityTexts.FirstOrDefault(text => text.RequiresHumanReview)?.Language ?? PublicContentLanguageDto.EnUs;
        SelectLanguage();
    }
    private bool _loading = true;
    private bool _saving;
    private bool _success;
    private string? _errorMessage;

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        var outcome = await CatalogToursApi.GetTourImages(Id, CancellationToken.None);
        if (outcome is { Kind: HttpOutcomeKind.Succeeded, Value: { } images })
        {
            SelectPendingImage(images);
        }
        else
        {
            _errorMessage = HttpOutcomeUserMessage.For(outcome.Kind, "Images could not be loaded. Try again later.");
        }

        _loading = false;
    }

    private async Task GenerateDraft()
    {
        if (_image is null)
        {
            return;
        }

        _saving = true;
        _success = false;
        _errorMessage = null;
        try
        {
            var outcome = await CatalogToursApi.GenerateMediaImageAccessibilityDraft(
                _image.Id,
                new PublicMediaImageAccessibilityDraftRequest { Language = _language },
                CancellationToken.None);
            if (outcome is not { Kind: HttpOutcomeKind.Succeeded, Value: { } draft })
            {
                _errorMessage = HttpOutcomeUserMessage.For(
                    outcome.Kind,
                    "Accessibility draft could not be generated. Try again later.",
                    "Image was not found.");
                return;
            }

            _image = draft;
            SelectLanguage();
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task Approve()
    {
        if (_image is null)
        {
            return;
        }

        _saving = true;
        _success = false;
        _errorMessage = null;
        try
        {
            var outcome = await CatalogToursApi.ReviewMediaImageAccessibility(
                _image.Id,
                new PublicMediaImageAccessibilityReviewRequest
                {
                    Language = _language,
                    AltText = _isDecorative ? null : _altText,
                    Caption = _caption,
                    IsDecorative = _isDecorative
                },
                CancellationToken.None);
            if (outcome.Kind == HttpOutcomeKind.ValidationProblem)
            {
                _errorMessage = outcome.ValidationErrors is null or { Count: 0 }
                    ? "Accessibility text could not be saved. Try again later."
                    : string.Join(" ", outcome.ValidationErrors.SelectMany(error => error.Value));
                return;
            }

            if (outcome is not { Kind: HttpOutcomeKind.Succeeded, Value: { } updated })
            {
                _errorMessage = HttpOutcomeUserMessage.For(
                    outcome.Kind,
                    "Accessibility text could not be saved. Try again later.",
                    "Image was not found.");
                return;
            }

            _image = updated;
            _altText = updated.AltText;
            _success = true;
            await LoadNextImage();
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task LoadNextImage()
    {
        var outcome = await CatalogToursApi.GetTourImages(Id, CancellationToken.None);
        if (outcome is { Kind: HttpOutcomeKind.Succeeded, Value: { } images })
        {
            SelectPendingImage(images);
        }
        else
        {
            _errorMessage = HttpOutcomeUserMessage.For(outcome.Kind, "The next image could not be loaded. Refresh the page and try again.");
        }
    }

    private string? GetPreviewPath(Guid imageId, CatalogMediaImageVariantDto variant)
    {
        var format = variant.ContentType.Trim().ToUpperInvariant() switch
        {
            "IMAGE/AVIF" => "avif",
            "IMAGE/JPEG" => "jpg",
            "IMAGE/PNG" => "png",
            "IMAGE/WEBP" => "webp",
            _ => null
        };

        if (format is null)
        {
            return null;
        }

        return LinkGenerator.GetPathByName(
            ManagementWebEndpoints.MediaPreviewByRenditionEndpointName,
            new { id = imageId, width = variant.Width, format });
    }
}
