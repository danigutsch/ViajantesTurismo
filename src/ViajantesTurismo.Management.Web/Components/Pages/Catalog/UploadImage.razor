@page "/catalog/tours/{Id:guid}/images/upload"
@implements IAsyncDisposable
@using Microsoft.AspNetCore.Components.Forms
@using PandaBear.HttpClients
@using ViajantesTurismo.Catalog.Contracts.Application
@using ViajantesTurismo.Catalog.Contracts.Http
@using ViajantesTurismo.Management.Web.Components.Shared
@inject ICatalogToursApiClient CatalogToursApi
@inject IUiFailureReporter Failures

<PageTitle>Upload Catalog Tour Images</PageTitle>

<h1>Upload Catalog Tour Images</h1>

@if (_selectionError is not null)
{
    <div class="alert alert-danger" role="alert">@_selectionError</div>
}

<EditForm Model="@_entries" OnSubmit="@HandleSubmit" FormName="uploadCatalogTourImage">
    <div class="catalog-image-drop-zone mb-3 rounded p-3" data-catalog-image-drop-zone>
        <label for="imageFile" class="form-label">Image files</label>
        <InputFile id="imageFile" class="form-control" OnChange="HandleFileSelection" multiple
                   accept="@AcceptedImageTypes" aria-describedby="imageFileHelp" disabled="@IsUploading" />
        <div id="imageFileHelp" class="form-text">
            Drop images here or use the file picker.
            JPEG, PNG, WebP, or AVIF. Maximum size: @MaximumFileSizeInMebibytes MiB.
            Select up to @MaximumSelectionCount images. A new selection replaces this list.
        </div>
        <div class="catalog-image-drop-feedback" role="status" data-catalog-image-drop-feedback
             data-release-message="Release to select images"></div>
    </div>

    @if (_entries.Count > 0)
    {
        <ol class="list-unstyled" aria-label="Selected images">
            @foreach (var entry in _entries)
            {
                <li @key="entry" class="border rounded p-3 mb-3">
                    <fieldset>
                        <legend class="h6 text-break">@entry.File.Name</legend>
                        <div class="mb-2">@entry.File.Size.ToString("N0", System.Globalization.CultureInfo.CurrentCulture) bytes</div>

                        @if (entry.FileError is not null || entry.Error is not null)
                        {
                            <div class="alert alert-danger" role="alert">@(entry.FileError ?? entry.Error)</div>
                        }

                        @if (entry.Operation.Status == UploadOperationStatus.Complete)
                        {
                            <div class="alert alert-success" role="status">Image uploaded and awaiting processing.</div>
                        }
                        else if (entry.Operation.Status != UploadOperationStatus.None)
                        {
                            <UploadStatus State="@entry.Operation"
                                          Label="Catalog image upload status"
                                          class="alert alert-light border"
                                          OnCancel="CancelUpload"
                                          CancelClass="btn btn-sm btn-outline-danger mt-2"
                                          CancelLabelFormat="Cancel upload of {0}"
                                          ProgressClass="w-100 mt-2"
                                          ProgressLabelFormat="Upload progress for {0}"
                                          IndeterminateProgressLabelFormat="Indeterminate server progress for {0}"
                                          ProgressTextFormat="{0} of {1} bytes"
                                          StatusClass="visually-hidden"
                                          RenderFailureInStatus="false">
                                <Detail Context="upload"><div data-upload-status>@GetUploadStatusText(upload)</div></Detail>
                            </UploadStatus>
                        }
                        else if (entry.FileError is null)
                        {
                            <div class="mb-2">Queued</div>
                        }

                        @if (entry.FileError is null)
                        {
                            <div class="mb-3">
                                <label for="@entry.DescriptionId" class="form-label">Image description</label>
                                <input id="@entry.DescriptionId" name="imageDescription" class="form-control"
                                       @bind="entry.AltText" maxlength="@MaximumDescriptionLength"
                                       aria-required="true" disabled="@(IsUploading || entry.Operation.Status == UploadOperationStatus.Complete)" />
                            </div>

                            <div class="mb-3">
                                <label for="@entry.CaptionId" class="form-label">Caption (optional)</label>
                                <input id="@entry.CaptionId" name="imageCaption" class="form-control"
                                       @bind="entry.Caption" maxlength="@MaximumCaptionLength"
                                       disabled="@(IsUploading || entry.Operation.Status == UploadOperationStatus.Complete)" />
                            </div>
                        }

                        @if (entry.Operation.CanRetry && _entries.Count > 1)
                        {
                            <button type="button" class="btn btn-sm btn-outline-primary me-2" disabled="@IsUploading"
                                    aria-label="@($"Retry upload of {entry.File.Name}")" @onclick="() => UploadEntries([entry])">Retry upload</button>
                        }
                        @if (entry.Operation.Status != UploadOperationStatus.Complete)
                        {
                            <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@IsUploading"
                                    aria-label="@($"Remove {entry.File.Name}")" @onclick="() => _entries.Remove(entry)">Remove</button>
                        }
                    </fieldset>
                </li>
            }
        </ol>
    }

    <button type="submit" class="btn btn-primary" disabled="@(IsUploading || !CanSubmit)">
        @GetSubmitButtonLabel()
    </button>
    <NavLink href="@($"/catalog/tours/{Id}/presentation")" class="btn btn-secondary ms-2">Cancel</NavLink>
</EditForm>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private const int MaximumSelectionCount = 10;
    private const long BytesPerMebibyte = 1024 * 1024;
    private const long MaximumFileSize = ViajantesTurismo.Catalog.Contracts.Application.ContractConstants.MaxMediaUploadBytes;
    private const long MaximumFileSizeInMebibytes = MaximumFileSize / BytesPerMebibyte;
    private const int MaximumDescriptionLength = ViajantesTurismo.Catalog.Contracts.Application.ContractConstants.MaxAltTextLength;
    private const int MaximumCaptionLength = ViajantesTurismo.Catalog.Contracts.Application.ContractConstants.MaxCaptionLength;
    private const string AcceptedImageTypes = "image/jpeg,image/png,image/webp,image/avif";
    private const string ValidationFailureMessage = "Image could not be uploaded. Check the file and try again.";
    private static readonly HashSet<string> AcceptedImageTypeSet = new(AcceptedImageTypes.Split(','), StringComparer.OrdinalIgnoreCase);
    private readonly List<CatalogImageUploadEntry> _entries = [];
    private string? _selectionError;
    private CatalogImageUploadEntry? _activeEntry;
    private CancellationTokenSource? _activeBatch;

    private bool IsUploading => _activeBatch is not null;
    private bool HasSingleRetry => _entries.Count == 1 && _entries[0].Operation.CanRetry;
    private bool CanSubmit => HasSingleRetry || _entries.Any(entry => entry.IsQueued);

    private void HandleFileSelection(InputFileChangeEventArgs args)
    {
        if (IsUploading)
        {
            return;
        }

        _selectionError = null;
        // Blazor invalidates old browser-file handles when the same picker changes again.
        _entries.Clear();
        if (args.FileCount > MaximumSelectionCount)
        {
            _selectionError = $"Select up to {MaximumSelectionCount} images at a time.";
            return;
        }

        foreach (var file in args.GetMultipleFiles(MaximumSelectionCount))
        {
            _entries.Add(new CatalogImageUploadEntry(file, _entries.Count, GetFileError(file)));
        }
    }

    private static string? GetFileError(IBrowserFile file)
    {
        if (string.IsNullOrWhiteSpace(file.Name))
        {
            return "Select an image file with a name.";
        }

        if (file.Size <= 0)
        {
            return "Select a non-empty image file before uploading.";
        }

        if (file.Size > MaximumFileSize)
        {
            return $"Select an image no larger than {MaximumFileSizeInMebibytes} MiB.";
        }

        return AcceptedImageTypeSet.Contains(file.ContentType) ? null : "Select a JPEG, PNG, WebP, or AVIF image.";
    }

    private async Task HandleSubmit()
    {
        if (_entries.Count == 0)
        {
            _selectionError = "Select an image file before uploading.";
            return;
        }

        var pending = HasSingleRetry ? _entries.ToArray() : _entries.Where(entry => entry.IsQueued).ToArray();
        await UploadEntries(pending);
    }

    private async Task UploadEntries(IReadOnlyCollection<CatalogImageUploadEntry> entries)
    {
        if (IsUploading || entries.Count == 0)
        {
            return;
        }

        _selectionError = null;
        using var batch = new CancellationTokenSource();
        _activeBatch = batch;
        try
        {
            foreach (var entry in entries)
            {
                if (batch.IsCancellationRequested)
                {
                    break;
                }

                _activeEntry = entry;
                await UploadEntry(entry, batch.Token);
                if (!batch.IsCancellationRequested)
                {
                    StateHasChanged();
                }
            }
        }
        finally
        {
            if (ReferenceEquals(_activeBatch, batch))
            {
                _activeEntry = null;
                _activeBatch = null;
            }
        }
    }

    private async Task UploadEntry(CatalogImageUploadEntry entry, CancellationToken ct)
    {
        if (string.IsNullOrWhiteSpace(entry.AltText) || entry.AltText.Length > MaximumDescriptionLength)
        {
            entry.Error = "Enter an image description before uploading.";
            return;
        }

        entry.Error = null;
        var file = entry.File;
        var operation = entry.Operation;
        var operationId = operation.Begin(file.Name, file.Size, operation.CanRetry);
        var progress = new Progress<long>(bytesTransferred =>
        {
            if (operation.ReportBytes(operationId, bytesTransferred))
            {
                StateHasChanged();
            }
        });

        try
        {
            await using var content = CatalogImageUploadFileReader.Open(file, ct);
            var outcome = await CatalogToursApi.UploadTourImage(
                Id,
                new CatalogTourImageUploadRequest(content, file.Size, file.Name, file.ContentType, entry.AltText, entry.Caption),
                progress,
                ct);
            if (!operation.IsCurrentActive(operationId))
            {
                return;
            }

            if (outcome.Kind != HttpOutcomeKind.Succeeded)
            {
                SetError(entry, operationId, new HttpOutcomeMessages("Image could not be uploaded. Try again later.")
                    .With(HttpOutcomeKind.NotFound, "Catalog tour not found.")
                    .With(HttpOutcomeKind.ValidationProblem, ValidationFailureMessage)
                    .For(outcome.Kind));
                return;
            }

            operation.ReportBytes(operationId, operation.TotalBytes);
            operation.Complete(operationId);
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            operation.Cancel(operationId);
        }
        catch (ContractValidationException)
        {
            SetError(entry, operationId, ValidationFailureMessage);
        }
        catch (HttpRequestException exception)
        {
            Failures.Report(exception, "catalog.upload-image.send");
            SetError(entry, operationId, "Image could not be uploaded. Try again later.");
        }
        catch (IOException exception)
        {
            Failures.Report(exception, "catalog.upload-image.read");
            SetError(entry, operationId, $"Image could not be read. Check that it is no larger than {MaximumFileSizeInMebibytes} MiB and try again.");
        }
    }

    private static void SetError(CatalogImageUploadEntry entry, long operationId, string message)
    {
        if (entry.Operation.Fail(operationId, message))
        {
            entry.Error = message;
        }
    }

    private async Task CancelUpload()
    {
        var batch = _activeBatch;
        var operation = _activeEntry?.Operation;
        if (batch is null || operation is null || !operation.Cancel(operation.OperationId))
        {
            return;
        }

        _activeBatch = null;
        _activeEntry = null;
        await batch.CancelAsync();
    }

    private string GetSubmitButtonLabel()
    {
        if (IsUploading)
        {
            return "Uploading...";
        }

        return HasSingleRetry ? "Retry upload" : _entries.Count > 1 ? "Upload queued images" : "Upload image";
    }

    private static string GetUploadStatusText(UploadOperationState operation) => operation.Status switch
    {
        UploadOperationStatus.Queued => $"Queued: {operation.FileName}",
        UploadOperationStatus.Retrying => $"Retrying: {operation.FileName}",
        UploadOperationStatus.Uploading => $"Uploading {operation.FileName}: {operation.BytesTransferred} of {operation.TotalBytes} bytes.",
        UploadOperationStatus.Processing => $"Server processing {operation.FileName}: scanning, validating, decoding, and storing the image. Progress is indeterminate.",
        UploadOperationStatus.Canceled => $"Canceled: {operation.FileName}. Retry when ready.",
        UploadOperationStatus.Failed => $"Failed: {operation.FailureMessage}",
        _ => string.Empty,
    };

    public async ValueTask DisposeAsync()
    {
        await CancelUpload();
    }
}
