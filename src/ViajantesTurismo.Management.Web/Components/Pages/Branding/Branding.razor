@page "/catalog/theme"
@page "/branding"
@implements IDisposable
@using System.ComponentModel.DataAnnotations
@using System.Net
@using PandaBear.HttpClients
@using ViajantesTurismo.Branding.Contracts.Http
@using ViajantesTurismo.Management.Web.Helpers

@inject IBrandingManagementClient BrandingApi

<PageTitle>Branding</PageTitle>

<h1><i class="bi bi-palette" aria-hidden="true"></i> Branding</h1>

<p class="text-muted">Edit customer-facing website brand name, logo, colors, and typography.</p>

@if (_errorMessage is not null)
{
    <div class="alert alert-danger" role="alert">@_errorMessage</div>
}

@if (_successMessage is not null)
{
    <div class="alert alert-success" role="status">@_successMessage</div>
}

@if (_loading)
{
    <p><em>Loading...</em></p>
}
else
{
    <EditForm EditContext="@FormContext" OnValidSubmit="@SaveBranding" OnInvalidSubmit="@ShowSummary" FormName="brandingEditor">
        <DataAnnotationsValidator />
        <ErrorSummary Title="There is a problem" Items="_summaryItems" id="error-summary" class="border border-danger rounded p-3 mb-3" />

        <fieldset class="border rounded p-3 mb-3">
            <legend class="float-none w-auto px-2 h5">Brand</legend>
            <div class="mb-3">
                <label for="branding-brand-name" class="form-label">Brand name</label>
                <InputText id="branding-brand-name" class="form-control" @bind-Value="_model.BrandName" />
                <ValidationMessage For="() => _model.BrandName" />
            </div>
            <div class="mb-3">
                <label for="branding-logo-file" class="form-label">Logo image</label>
                <InputFile id="branding-logo-file" class="form-control" accept="image/png,image/jpeg,image/webp"
                           aria-describedby="@LogoDescribedBy" aria-invalid="@(_logoError is null ? null : "true")" disabled="@(_uploading || _saving)"
                           OnChange="UploadLogo" />
                <div id="branding-logo-help" class="form-text">
                    Optional. A still PNG, JPEG or WebP image (animated images are rejected), up to 1 MiB and 2048 x 2048 pixels. The image is converted to a small WebP logo.
                </div>
                <div id="branding-logo-status" class="form-text" role="status" aria-live="polite">@LogoStatus</div>
                @if (_logoError is not null)
                {
                    <div id="branding-logo-error" class="text-danger" role="alert">@_logoError</div>
                }
                @if (HasLogo)
                {
                    <button type="button" class="btn btn-outline-secondary btn-sm mt-2" disabled="@(_uploading || _saving)"
                            @onclick="RemoveLogo">Remove logo</button>
                }
            </div>
        </fieldset>

        <fieldset class="border rounded p-3 mb-3">
            <legend class="float-none w-auto px-2 h5">Colors</legend>
            <div class="mb-3">
                <label for="branding-primary-color" class="form-label">Primary color</label>
                <InputText id="branding-primary-color" class="form-control" @bind-Value="_model.PrimaryColor" />
                <ValidationMessage For="() => _model.PrimaryColor" />
            </div>
            <div class="mb-3">
                <label for="branding-accent-color" class="form-label">Accent color</label>
                <InputText id="branding-accent-color" class="form-control" @bind-Value="_model.AccentColor" />
                <ValidationMessage For="() => _model.AccentColor" />
            </div>
            <div class="mb-3">
                <label for="branding-background-color" class="form-label">Background color</label>
                <InputText id="branding-background-color" class="form-control" @bind-Value="_model.BackgroundColor" />
                <ValidationMessage For="() => _model.BackgroundColor" />
            </div>
            <div class="mb-3">
                <label for="branding-text-color" class="form-label">Text color</label>
                <InputText id="branding-text-color" class="form-control" @bind-Value="_model.TextColor" />
                <ValidationMessage For="() => _model.TextColor" />
            </div>
            <div class="form-text">Colors must use safe #RRGGBB hex values.</div>
        </fieldset>

        <fieldset class="border rounded p-3 mb-3">
            <legend class="float-none w-auto px-2 h5">Typography</legend>
            <div class="mb-3">
                <label for="branding-heading-font" class="form-label">Heading font</label>
                <InputSelect id="branding-heading-font" class="form-select" @bind-Value="_model.HeadingFontFamily">
                    @foreach (var font in AllowedFontFamilies)
                    {
                        <option value="@font">@font</option>
                    }
                </InputSelect>
                <ValidationMessage For="() => _model.HeadingFontFamily" />
            </div>
            <div class="mb-3">
                <label for="branding-body-font" class="form-label">Body font</label>
                <InputSelect id="branding-body-font" class="form-select" @bind-Value="_model.BodyFontFamily">
                    @foreach (var font in AllowedFontFamilies)
                    {
                        <option value="@font">@font</option>
                    }
                </InputSelect>
                <ValidationMessage For="() => _model.BodyFontFamily" />
            </div>
        </fieldset>

        <button type="submit" class="btn btn-primary" disabled="@_saving">@(_saving ? "Saving..." : "Save branding")</button>
    </EditForm>
}

@code {
    private const int MaxLogoUploadBytes = 1024 * 1024;
    private const string LogoTooLargeMessage = "The logo is larger than 1 MiB. Choose a smaller image.";

    private static readonly IReadOnlyList<string> AllowedFontFamilies = BrandingFontFamilies.All;

    private BrandingFormModel _model = BrandingFormModel.Default();
    private IReadOnlyList<ErrorSummaryItem> _summaryItems = [];
    private ServerValidationBinder? _binder;
    private EditContext? _editContext;

    private static readonly IReadOnlyList<KeyValuePair<string, string>> FieldIds =
    [
        new("BrandName", "branding-brand-name"),
        new("LogoUri", "branding-logo-file"),
        new("PrimaryColor", "branding-primary-color"),
        new("AccentColor", "branding-accent-color"),
        new("BackgroundColor", "branding-background-color"),
        new("TextColor", "branding-text-color"),
        new("HeadingFontFamily", "branding-heading-font"),
        new("BodyFontFamily", "branding-body-font")
    ];

    private static readonly string[] FieldNames = [.. FieldIds.Select(field => field.Key)];

    private static readonly ServerValidationOptions ServerValidation = new(FieldNames, UserFacingErrorMessage.InvalidFieldValue);

    private EditContext FormContext
    {
        get
        {
            if (_editContext is null || !ReferenceEquals(_editContext.Model, _model))
            {
                _binder?.Dispose();
                _editContext = new EditContext(_model);
                _binder = new ServerValidationBinder(_editContext, ServerValidation);
            }

            return _editContext;
        }
    }

    private void ShowSummary() => _summaryItems = ValidationSummaryItems.From(FormContext, FieldIds);

    /// <inheritdoc />
    public void Dispose() => _binder?.Dispose();

    private string? _entityTag;
    private bool _loading = true;
    private bool _saving;
    private bool _uploading;
    private string? _logoError;
    private string? _errorMessage;
    private string? _successMessage;

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        var outcome = await BrandingApi.GetSettings(CancellationToken.None);
        if (outcome is { Kind: HttpOutcomeKind.Succeeded, Value: { } document })
        {
            ApplyDocument(document);
        }
        else
        {
            _errorMessage = UserFacingErrorMessage.ForOperation("load branding");
        }

        _loading = false;
    }

    private string LogoDescribedBy => _logoError is null
        ? "branding-logo-help branding-logo-status"
        : "branding-logo-help branding-logo-status branding-logo-error";

    private bool HasLogo => !string.IsNullOrEmpty(_model.LogoUri);

    private string LogoStatus => _uploading ? "Uploading logo..." : HasLogo ? "A logo is set." : "No logo is set.";

    private async Task UploadLogo(InputFileChangeEventArgs args)
    {
        if (args.FileCount != 1)
        {
            return;
        }

        BeginLogoOperation();
        if (_entityTag is null)
        {
            _errorMessage = UserFacingErrorMessage.ForOperation("upload the logo");
            return;
        }

        _uploading = true;
        try
        {
            var file = args.File;
            await using var content = file.OpenReadStream(MaxLogoUploadBytes);
            var uploaded = await BrandingApi.UploadLogo(content, file.ContentType, _entityTag, CancellationToken.None);
            await ApplyLogoOutcome(uploaded, "Logo uploaded.");
        }
        catch (IOException)
        {
            _logoError = LogoTooLargeMessage;
        }
        catch (InvalidOperationException)
        {
            _logoError = UserFacingErrorMessage.ForOperation("upload the logo");
        }
        finally
        {
            _uploading = false;
        }
    }

    /// <summary>Removes only the logo; unsaved edits to the other fields stay in the form.</summary>
    private async Task RemoveLogo()
    {
        BeginLogoOperation();
        if (_entityTag is null)
        {
            _errorMessage = UserFacingErrorMessage.ForOperation("remove the logo");
            return;
        }

        _uploading = true;
        try
        {
            var removed = await BrandingApi.RemoveLogo(_entityTag, CancellationToken.None);
            await ApplyLogoOutcome(removed, "Logo removed.");
        }
        finally
        {
            _uploading = false;
        }
    }

    private void BeginLogoOperation()
    {
        _logoError = null;
        _errorMessage = null;
        _successMessage = null;
    }

    /// <summary>
    /// Takes only the logo address and the new entity tag from the logo response, so unsaved edits to the other
    /// fields survive. The response carries no validator, so one read supplies the tag.
    /// </summary>
    private async Task ApplyLogoOutcome(HttpOutcome<BrandingManagementSettingsDto> outcome, string successMessage)
    {
        if (outcome.Kind != HttpOutcomeKind.Succeeded)
        {
            _logoError = LogoErrorMessage(outcome);
            return;
        }

        var reloaded = await BrandingApi.GetSettings(CancellationToken.None);
        if (reloaded is { Kind: HttpOutcomeKind.Succeeded, Value: { } document })
        {
            _model.LogoUri = document.Settings.LogoUri?.OriginalString ?? string.Empty;
            _entityTag = document.EntityTag;
            _successMessage = successMessage;
        }
        else
        {
            _errorMessage = UserFacingErrorMessage.ForOperation("update the logo");
        }
    }

    private static string LogoErrorMessage(HttpOutcome<BrandingManagementSettingsDto> outcome) => outcome switch
    {
        { StatusCode: HttpStatusCode.PreconditionFailed } => SaveErrorMessage(outcome),
        { StatusCode: HttpStatusCode.BadRequest } or { Kind: HttpOutcomeKind.ValidationProblem } =>
            "The logo could not be used. Choose a still PNG, JPEG or WebP image (not animated) up to 1 MiB and 2048 x 2048 pixels.",
        { StatusCode: HttpStatusCode.ServiceUnavailable } => "The logo scanner is unavailable. Try again later.",
        _ => UserFacingErrorMessage.ForOperation("upload the logo")
    };

    private async Task SaveBranding()
    {
        _summaryItems = [];
        _saving = true;
        _errorMessage = null;
        _successMessage = null;

        if (_entityTag is null)
        {
            _errorMessage = UserFacingErrorMessage.ForOperation("save branding");
            _saving = false;
            return;
        }

        var saved = await BrandingApi.SaveSettings(_model.ToDto(), _entityTag, CancellationToken.None);
        if (saved.Kind != HttpOutcomeKind.Succeeded)
        {
            if (saved.Kind != HttpOutcomeKind.ValidationProblem || !ShowServerFieldErrors(saved.ValidationErrors))
            {
                _errorMessage = SaveErrorMessage(saved);
            }

            _saving = false;
            return;
        }

        await ReloadDocumentAndEntityTag();

        _saving = false;
    }

    /// <summary>The write response carries no validator; one fresh read replaces the document and its entity tag together.</summary>
    private async Task ReloadDocumentAndEntityTag(string successMessage = "Branding saved.")
    {
        var reloaded = await BrandingApi.GetSettings(CancellationToken.None);
        if (reloaded is { Kind: HttpOutcomeKind.Succeeded, Value: { } document })
        {
            ApplyDocument(document);
            _successMessage = successMessage;
        }
        else
        {
            _errorMessage = UserFacingErrorMessage.ForOperation("save branding");
        }
    }

    /// <summary>False when nothing could be shown on a field or some server text was withheld; the caller then shows fixed copy.</summary>
    private bool ShowServerFieldErrors(IReadOnlyDictionary<string, string[]>? validationErrors)
    {
        _ = FormContext;
        var result = _binder!.Apply(validationErrors);
        _summaryItems = ValidationSummaryItems.From(FormContext, FieldIds);
        return result is { HasUnplacedErrors: false, Issues.Count: > 0 };
    }

    private static string SaveErrorMessage(HttpOutcome<BrandingManagementSettingsDto> outcome)
    {
        if (outcome.StatusCode == HttpStatusCode.PreconditionFailed)
        {
            return "Branding was changed by someone else after you opened this page. Reload the page to see the latest settings, then reapply your changes.";
        }

        return UserFacingErrorMessage.ForOperation("save branding");
    }

    private void ApplyDocument(BrandingManagementDocument document)
    {
        _model = BrandingFormModel.FromSettings(document.Settings);
        _entityTag = document.EntityTag;
    }

    private sealed class BrandingFormModel
    {
        [Required]
        [StringLength(BrandingContractConstants.MaxBrandNameLength)]
        public string BrandName { get; set; } = string.Empty;

        [StringLength(BrandingContractConstants.MaxLogoUriLength)]
        public string LogoUri { get; set; } = string.Empty;

        [Required]
        [RegularExpression("^#[0-9A-Fa-f]{6}$", ErrorMessage = "Use a safe #RRGGBB hex color.")]
        public string PrimaryColor { get; set; } = string.Empty;

        [Required]
        [RegularExpression("^#[0-9A-Fa-f]{6}$", ErrorMessage = "Use a safe #RRGGBB hex color.")]
        public string AccentColor { get; set; } = string.Empty;

        [Required]
        [RegularExpression("^#[0-9A-Fa-f]{6}$", ErrorMessage = "Use a safe #RRGGBB hex color.")]
        public string BackgroundColor { get; set; } = string.Empty;

        [Required]
        [RegularExpression("^#[0-9A-Fa-f]{6}$", ErrorMessage = "Use a safe #RRGGBB hex color.")]
        public string TextColor { get; set; } = string.Empty;

        [Required]
        [StringLength(BrandingContractConstants.MaxFontFamilyLength)]
        public string HeadingFontFamily { get; set; } = BrandingFontFamilies.DefaultHeading;

        [Required]
        [StringLength(BrandingContractConstants.MaxFontFamilyLength)]
        public string BodyFontFamily { get; set; } = BrandingFontFamilies.DefaultBody;

        public static BrandingFormModel Default()
        {
            var branding = DefaultBranding();
            return new BrandingFormModel
            {
                BrandName = branding.BrandName,
                LogoUri = branding.LogoUri ?? string.Empty,
                PrimaryColor = branding.PrimaryColor,
                AccentColor = branding.AccentColor,
                BackgroundColor = branding.BackgroundColor,
                TextColor = branding.TextColor,
                HeadingFontFamily = branding.HeadingFontFamily,
                BodyFontFamily = branding.BodyFontFamily
            };
        }

        public static BrandingFormModel FromSettings(BrandingManagementSettingsDto branding)
        {
            return new BrandingFormModel
            {
                BrandName = branding.BrandName,
                LogoUri = branding.LogoUri?.OriginalString ?? string.Empty,
                PrimaryColor = branding.PrimaryColor,
                AccentColor = branding.AccentColor,
                BackgroundColor = branding.BackgroundColor,
                TextColor = branding.TextColor,
                HeadingFontFamily = branding.HeadingFontFamily,
                BodyFontFamily = branding.BodyFontFamily
            };
        }

        public BrandingSettingsDto ToDto()
        {
            var logoUri = LogoUri.Trim();

            return new BrandingSettingsDto
            {
                BrandName = BrandName,
                LogoUri = string.IsNullOrWhiteSpace(logoUri) ? null : logoUri,
                PrimaryColor = PrimaryColor,
                AccentColor = AccentColor,
                BackgroundColor = BackgroundColor,
                TextColor = TextColor,
                HeadingFontFamily = HeadingFontFamily,
                BodyFontFamily = BodyFontFamily
            };
        }

        private static BrandingSettingsDto DefaultBranding()
        {
            return new BrandingSettingsDto
            {
                BrandName = "Viajantes Turismo",
                LogoUri = string.Empty,
                PrimaryColor = "#0F766E",
                AccentColor = "#F97316",
                BackgroundColor = "#FFFBF5",
                TextColor = "#1F2937",
                HeadingFontFamily = BrandingFontFamilies.DefaultHeading,
                BodyFontFamily = BrandingFontFamilies.DefaultBody
            };
        }
    }
}
