<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">ViajantesTurismo</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" @bind="_expanded" />

@* A Blazor handler, not an onclick attribute: the strict script-src policy blocks inline event handlers. *@
<div class="nav-scrollable" @onclick="Collapse">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="payment-accounts" Match="NavLinkMatch.Prefix">
                <span class="bi bi-bank" aria-hidden="true"></span> Payment accounts
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="addtour" Match="NavLinkMatch.All">
                <span class="bi bi-plus-square-fill" aria-hidden="true"></span> Add Tour
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="tours" Match="NavLinkMatch.Prefix">
                <span class="bi bi-list-nested" aria-hidden="true"></span> Tours
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="catalog/tours" Match="NavLinkMatch.Prefix">
                <span class="bi bi-card-list" aria-hidden="true"></span> Catalog
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="catalog/content" Match="NavLinkMatch.Prefix">
                <span class="bi bi-translate" aria-hidden="true"></span> Public Content
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="branding" Match="NavLinkMatch.Prefix">
                <span class="bi bi-palette" aria-hidden="true"></span> Branding
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="bookings" Match="NavLinkMatch.Prefix">
                <span class="bi bi-calendar-check" aria-hidden="true"></span> Bookings
            </NavLink>
        </div>

        <AuthorizeView Roles="Admin">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="documents/holds" Match="NavLinkMatch.Prefix">
                    <span class="bi bi-lock" aria-hidden="true"></span> Document holds
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="operations" Match="NavLinkMatch.Prefix">
                    <span class="bi bi-clock-history" aria-hidden="true"></span> Operations
                </NavLink>
            </div>
        </AuthorizeView>

        <AuthorizeView Roles="@DocumentMaintenanceAccess.ControlRole" Context="scheduleController">
            @if (!scheduleController.User.IsInRole("Admin"))
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="operations/document-maintenance" Match="NavLinkMatch.Prefix">
                        <span class="bi bi-clock-history" aria-hidden="true"></span> Document maintenance
                    </NavLink>
                </div>
            }
        </AuthorizeView>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="customers/create" Match="NavLinkMatch.Prefix">
                <span class="bi bi-person-plus-fill" aria-hidden="true"></span> Add Customer
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="customers" Match="NavLinkMatch.All">
                <span class="bi bi-people-fill" aria-hidden="true"></span> Customers
            </NavLink>
        </div>
    </nav>
</div>

@code {
    private bool _expanded;

    // Choosing an entry closes the narrow-screen menu; on wide screens the menu ignores the toggle.
    private void Collapse() => _expanded = false;
}
