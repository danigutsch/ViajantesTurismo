@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation

<div class="page"
     inert="@(!RendererInfo.IsInteractive ? "inert" : null)"
     aria-busy="@(!RendererInfo.IsInteractive ? "true" : "false")"
     data-interactive="@RendererInfo.IsInteractive.ToString().ToLowerInvariant()">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex justify-content-between align-items-center">
            <span class="text-muted">
                <strong>ViajantesTurismo</strong> Admin Portal
            </span>
            <div class="text-muted small">
                <span>v1.0.0</span>
                <span class="mx-2">•</span>
                <span>© @DateTime.Now.Year</span>
                <span class="mx-2">•</span>
                <NavLink href="/about" class="text-decoration-none">About</NavLink>
            </div>
        </div>

        <article class="content px-4">
            <RecoveryErrorBoundary @ref="_boundary"
                                   OperationName="management.layout.content"
                                   RecoveryMessage="Something went wrong on this page. Try again, or reload the page."
                                   RecoverLabel="Try again">
                @Body
            </RecoveryErrorBoundary>
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    private RecoveryErrorBoundary? _boundary;
    private string _path = string.Empty;

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        _path = CurrentPath();
        Navigation.LocationChanged += RecoverOnNavigation;
    }

    /// <inheritdoc />
    public void Dispose()
    {
        Navigation.LocationChanged -= RecoverOnNavigation;
    }

    private string CurrentPath() => new Uri(Navigation.Uri).AbsolutePath;

    /// <summary>A failed page must not hide the next one: leaves the failed state when the path changes, not on fragment or query changes.</summary>
    private void RecoverOnNavigation(object? sender, LocationChangedEventArgs args)
    {
        var path = CurrentPath();
        if (string.Equals(path, _path, StringComparison.Ordinal))
        {
            return;
        }

        _path = path;
        _boundary?.Recover();
    }
}
