@implements IDisposable

@if (_messages.Count > 0)
{
    <div id="error-summary" class="border border-danger rounded p-3 mb-3" role="alert" tabindex="-1" aria-labelledby="error-summary-title" @ref="_summary">
        <h2 id="error-summary-title" class="h5">There is a problem</h2>
        <ul class="mb-0">
            @foreach (var (fieldId, message) in _messages)
            {
                <li><a href="#@fieldId">@message</a></li>
            }
        </ul>
    </div>
}

@code {
    private ElementReference _summary;
    private List<(string FieldId, string Message)> _messages = [];
    private EditContext? _subscribed;

    /// <summary>The edit context whose validation messages are summarized.</summary>
    [Parameter, EditorRequired]
    public EditContext EditContext { get; set; } = default!;

    /// <summary>Maps each model property name to the element id of its input, in display order.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<KeyValuePair<string, string>> Fields { get; set; } = [];

    /// <summary>Moves focus to the summary when it is visible.</summary>
    public async Task FocusAsync()
    {
        if (_messages.Count > 0)
        {
            await _summary.FocusAsync();
        }
    }

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_subscribed, EditContext))
        {
            Unsubscribe();
            _subscribed = EditContext;
            _subscribed.OnValidationStateChanged += HandleValidationStateChanged;
        }

        _messages =
        [
            .. Fields.SelectMany(field => EditContext
                .GetValidationMessages(EditContext.Field(field.Key))
                .Select(message => (field.Value, message)))
        ];
    }

    /// <inheritdoc />
    public void Dispose()
    {
        Unsubscribe();
    }

    private void Unsubscribe()
    {
        if (_subscribed is not null)
        {
            _subscribed.OnValidationStateChanged -= HandleValidationStateChanged;
        }
    }

    private void HandleValidationStateChanged(object? sender, ValidationStateChangedEventArgs args)
    {
        OnParametersSet();
        _ = InvokeAsync(StateHasChanged);
    }
}
