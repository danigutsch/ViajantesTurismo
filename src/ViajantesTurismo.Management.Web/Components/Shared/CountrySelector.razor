@using PandaBear.BuildingBlocks
@using ViajantesTurismo.Management.Web.Services
@inherits InputBase<string>

<div class="position-relative" @onkeydown="HandleKeyDown">
    <button type="button" id="@Id" class="form-select text-start d-flex align-items-center"
            aria-expanded="@(_isOpen ? "true" : "false")" aria-describedby="@CurrentSelectionId"
            @ref="_toggleButton" @onclick="ToggleDropdown">
        @if (!string.IsNullOrEmpty(Value) && _selectedCountry != null)
        {
            <span class="fi fi-@_selectedCountry.Code.ToLowerInvariant() me-2" aria-hidden="true"></span>
            <span id="@CurrentSelectionId">@_selectedCountry.Name</span>
        }
        else
        {
            <span class="text-muted">-- Select Country --</span>
        }
    </button>

    @if (_isOpen)
    {
        <div class="country-dropdown-menu">
            <input type="text" aria-label="Search countries"
                   class="form-control form-control-sm mb-2"
                   placeholder="Search countries..."
                   @bind="_searchText"
                   @bind:event="oninput"
                   @onclick:stopPropagation="true"/>

            <div class="country-dropdown-list">
                @foreach (var country in FilteredCountries)
                {
                    <button type="button" class="country-dropdown-item" @onclick="() => SelectCountry(country)">
                        <span class="fi fi-@country.Code.ToLowerInvariant() me-2" aria-hidden="true"></span>
                        <span>@country.Name</span>
                    </button>
                }

                @if (!FilteredCountries.Any())
                {
                    <div class="text-muted p-2" role="status">No countries found</div>
                }
            </div>
        </div>
    }
</div>

@code {
    /// <summary>Gets or sets the nonce of the document's response, which the inline style block needs under the strict policy.</summary>
    [CascadingParameter(Name = ManagementWebSecurityHeaders.NonceCascadeName)]
    public string? CspNonce { get; set; }

    [Parameter] public string? Id { get; set; }

    [Parameter]
    public IReadOnlyList<CountryInfo>? Countries { get; set; }

    /// <summary>
    /// When <see langword="true"/>, the bound value is the ISO 3166-1 alpha-2 code (for example BR) instead of the country
    /// name, and only officially assigned codes are offered.
    /// </summary>
    [Parameter]
    public bool BindCode { get; set; }

    private bool _isOpen;
    private string _searchText = string.Empty;
    private CountryInfo? _selectedCountry;
    private ElementReference _toggleButton;

    private string? CurrentSelectionId => Id is not null && _selectedCountry is not null ? $"{Id}-selection" : null;

    private IEnumerable<CountryInfo> FilteredCountries =>
        (Countries ?? [])
        .Where(country => !BindCode || CountryCode.Create(country.Code).IsSuccess)
        .Where(country => string.IsNullOrEmpty(_searchText) ||
                          country.Name.Contains(_searchText, StringComparison.OrdinalIgnoreCase));

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        UpdateSelectedCountry();
    }

    private void UpdateSelectedCountry()
    {
        if (!string.IsNullOrEmpty(Value) && Countries != null)
        {
            if (BindCode)
            {
                _selectedCountry = Countries.FirstOrDefault(c => string.Equals(c.Code, Value, StringComparison.OrdinalIgnoreCase));
                return;
            }

            var normalizedValue = CountryService.NormalizeNationality(Value);
            _selectedCountry = Countries.FirstOrDefault(c => c.Name == normalizedValue);
        }
        else
        {
            _selectedCountry = null;
        }
    }

    private void ToggleDropdown()
    {
        _isOpen = !_isOpen;
        if (!_isOpen)
        {
            _searchText = string.Empty;
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs args)
    {
        if (_isOpen && args.Key == "Escape")
        {
            await CloseDropdown();
        }
    }

    private async Task SelectCountry(CountryInfo country)
    {
        CurrentValue = BindCode ? country.Code : country.Name;
        _selectedCountry = country;
        await CloseDropdown();
    }

    private async Task CloseDropdown()
    {
        _isOpen = false;
        _searchText = string.Empty;
        await _toggleButton.FocusAsync();
    }

    protected override bool TryParseValueFromString(string? value, out string result, out string validationErrorMessage)
    {
        result = value ?? string.Empty;
        validationErrorMessage = string.Empty;
        return true;
    }

}

<style nonce="@CspNonce">
    .country-dropdown-menu {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        z-index: 1050;
        background: white;
        border: 1px solid #dee2e6;
        border-radius: 0.375rem;
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
        margin-top: 0.25rem;
        padding: 0.5rem;
    }

    .country-dropdown-list {
        max-height: 300px;
        overflow-y: auto;
    }

    .country-dropdown-item {
        padding: 0.5rem;
        width: 100%;
        border: 0;
        border-radius: 0.25rem;
        color: inherit;
        background: transparent;
        text-align: start;
        display: flex;
        align-items: center;
    }

    .country-dropdown-item:hover {
        background-color: #f8f9fa;
    }

    .fi {
        width: 20px;
        height: 15px;
        background-size: contain;
        background-position: center;
        background-repeat: no-repeat;
        display: inline-block;
        flex-shrink: 0;
    }
</style>
