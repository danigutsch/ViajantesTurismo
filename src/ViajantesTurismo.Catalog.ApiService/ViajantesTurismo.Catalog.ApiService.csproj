<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
        <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
        <OpenApiGenerateDocuments>false</OpenApiGenerateDocuments>
        <OpenApiGenerateDocumentsOnBuild>false</OpenApiGenerateDocumentsOnBuild>
        <GenerateCatalogOpenApiArtifacts Condition="'$(RefreshCatalogOpenApiArtifacts)' == 'true'">true</GenerateCatalogOpenApiArtifacts>
        <OpenApiGenerateDocuments Condition="'$(GenerateCatalogOpenApiArtifacts)' == 'true'">true</OpenApiGenerateDocuments>
        <OpenApiGenerateDocumentsOnBuild Condition="'$(GenerateCatalogOpenApiArtifacts)' == 'true'">true</OpenApiGenerateDocumentsOnBuild>
        <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/../ViajantesTurismo.Catalog.Contracts.Http/OpenApi/.generated</OpenApiDocumentsDirectory>
        <!-- The co-hosted Branding module's boundary documents are generated from this host into Branding contracts. -->
        <GenerateBrandingOpenApiArtifacts Condition="'$(RefreshBrandingOpenApiArtifacts)' == 'true'">true</GenerateBrandingOpenApiArtifacts>
        <OpenApiGenerateDocuments Condition="'$(GenerateBrandingOpenApiArtifacts)' == 'true'">true</OpenApiGenerateDocuments>
        <OpenApiGenerateDocumentsOnBuild Condition="'$(GenerateBrandingOpenApiArtifacts)' == 'true'">true</OpenApiGenerateDocumentsOnBuild>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="ViajantesTurismo.Catalog.ApiServiceTests" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\ViajantesTurismo.Architecture.Analyzers\ViajantesTurismo.Architecture.Analyzers.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"
                          PrivateAssets="all"
                          IsAspireProjectResource="false" />
        <ProjectReference Include="..\ViajantesTurismo.Branding.AspNetCore\ViajantesTurismo.Branding.AspNetCore.csproj" />
        <ProjectReference Include="..\ViajantesTurismo.Catalog.Application\ViajantesTurismo.Catalog.Application.csproj" />
        <ProjectReference Include="..\ViajantesTurismo.Catalog.Contracts.Application\ViajantesTurismo.Catalog.Contracts.Application.csproj" />
        <ProjectReference Include="..\ViajantesTurismo.Catalog.Contracts.Http\ViajantesTurismo.Catalog.Contracts.Http.csproj" />
        <ProjectReference Include="..\ViajantesTurismo.Catalog.Infrastructure\ViajantesTurismo.Catalog.Infrastructure.csproj" />
        <ProjectReference Include="..\ViajantesTurismo.ServiceDefaults\ViajantesTurismo.ServiceDefaults.csproj" />
        <PackageReference Include="PandaBear.SharedKernel.HttpCaching.AspNetCore" />
        <PackageReference Include="PandaBear.SharedKernel.AspNetCore" />
        <PackageReference Include="PandaBear.SharedKernel.ApiVersioning.AspNetCore" />
        <PackageReference Include="PandaBear.SharedKernel.OpenApi" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
        <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" />
    </ItemGroup>

    <Target Name="CopyCatalogBoundaryOpenApiArtifacts" AfterTargets="GenerateOpenApiDocuments" Condition="'$(RefreshCatalogOpenApiArtifacts)' == 'true'">
        <ItemGroup>
            <CatalogOpenApiArtifact Include="catalog;public-catalog" />
            <GeneratedOpenApiArtifact Include="@(CatalogOpenApiArtifact)">
                <SourcePath>$(OpenApiDocumentsDirectory)/$(AssemblyName)_%(Identity).json</SourcePath>
                <TargetPath>$(MSBuildProjectDirectory)/../ViajantesTurismo.Catalog.Contracts.Http/OpenApi/%(Identity).openapi.json</TargetPath>
            </GeneratedOpenApiArtifact>
            <GeneratedOpenApiArtifact Include="v1">
                <!-- The ASP.NET Core generator writes the default v1 document to $(AssemblyName).json. -->
                <SourcePath>$(OpenApiDocumentsDirectory)/$(AssemblyName).json</SourcePath>
                <TargetPath>$(MSBuildProjectDirectory)/../ViajantesTurismo.Catalog.Contracts.Http/OpenApi/v1.openapi.json</TargetPath>
            </GeneratedOpenApiArtifact>
        </ItemGroup>

        <MakeDir Directories="$(MSBuildProjectDirectory)/../ViajantesTurismo.Catalog.Contracts.Http/OpenApi" />
        <Copy SourceFiles="@(GeneratedOpenApiArtifact->'%(SourcePath)')" DestinationFiles="@(GeneratedOpenApiArtifact->'%(TargetPath)')" SkipUnchangedFiles="true" />
    </Target>

    <!-- The co-hosted Branding documents belong beside the Branding contracts, not in Catalog's generated set. -->
    <Target Name="CopyBrandingBoundaryOpenApiArtifacts" AfterTargets="GenerateOpenApiDocuments" Condition="'$(OpenApiGenerateDocuments)' == 'true'">
        <ItemGroup>
            <BrandingOpenApiArtifact Include="branding;public-branding" />
            <GeneratedBrandingOpenApiArtifact Include="@(BrandingOpenApiArtifact)">
                <SourcePath>$(OpenApiDocumentsDirectory)/$(AssemblyName)_%(Identity).json</SourcePath>
                <GeneratedPath>$(MSBuildProjectDirectory)/../ViajantesTurismo.Branding.Contracts.Http/OpenApi/.generated/$(AssemblyName)_%(Identity).json</GeneratedPath>
                <TargetPath>$(MSBuildProjectDirectory)/../ViajantesTurismo.Branding.Contracts.Http/OpenApi/%(Identity).openapi.json</TargetPath>
            </GeneratedBrandingOpenApiArtifact>
        </ItemGroup>

        <MakeDir Directories="$(MSBuildProjectDirectory)/../ViajantesTurismo.Branding.Contracts.Http/OpenApi/.generated" />
        <!-- An up-to-date build skips generation; the documents were already moved by the run that produced them. -->
        <Copy Condition="Exists('%(GeneratedBrandingOpenApiArtifact.SourcePath)')" SourceFiles="%(GeneratedBrandingOpenApiArtifact.SourcePath)" DestinationFiles="%(GeneratedBrandingOpenApiArtifact.GeneratedPath)" SkipUnchangedFiles="true" />
        <Copy Condition="'$(RefreshBrandingOpenApiArtifacts)' == 'true' And Exists('%(GeneratedBrandingOpenApiArtifact.GeneratedPath)')" SourceFiles="%(GeneratedBrandingOpenApiArtifact.GeneratedPath)" DestinationFiles="%(GeneratedBrandingOpenApiArtifact.TargetPath)" SkipUnchangedFiles="true" />
        <Delete Files="@(GeneratedBrandingOpenApiArtifact->'%(SourcePath)')" />
    </Target>

</Project>
