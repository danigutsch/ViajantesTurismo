<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
        <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
        <OpenApiGenerateDocuments>false</OpenApiGenerateDocuments>
        <OpenApiGenerateDocumentsOnBuild>false</OpenApiGenerateDocumentsOnBuild>
        <GenerateCatalogOpenApiArtifacts Condition="'$(RefreshCatalogOpenApiArtifacts)' == 'true'">true</GenerateCatalogOpenApiArtifacts>
        <OpenApiGenerateDocuments Condition="'$(GenerateCatalogOpenApiArtifacts)' == 'true'">true</OpenApiGenerateDocuments>
        <OpenApiGenerateDocumentsOnBuild Condition="'$(GenerateCatalogOpenApiArtifacts)' == 'true'">true</OpenApiGenerateDocumentsOnBuild>
        <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/../ViajantesTurismo.Catalog.Contracts.Http/OpenApi/.generated</OpenApiDocumentsDirectory>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="ViajantesTurismo.Catalog.ApiServiceTests" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\ViajantesTurismo.Catalog.Application\ViajantesTurismo.Catalog.Application.csproj" />
        <ProjectReference Include="..\ViajantesTurismo.Catalog.Contracts.Application\ViajantesTurismo.Catalog.Contracts.Application.csproj" />
        <ProjectReference Include="..\ViajantesTurismo.Catalog.Contracts.Http\ViajantesTurismo.Catalog.Contracts.Http.csproj" />
        <ProjectReference Include="..\ViajantesTurismo.Catalog.Infrastructure\ViajantesTurismo.Catalog.Infrastructure.csproj" />
        <ProjectReference Include="..\ViajantesTurismo.ServiceDefaults\ViajantesTurismo.ServiceDefaults.csproj" />
        <ProjectReference Include="..\SharedKernel\SharedKernel.HttpCaching.AspNetCore\SharedKernel.HttpCaching.AspNetCore.csproj" />
        <ProjectReference Include="..\SharedKernel\SharedKernel.AspNetCore\SharedKernel.AspNetCore.csproj" />
        <ProjectReference Include="..\SharedKernel\SharedKernel.OpenApi\SharedKernel.OpenApi.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
        <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" />
    </ItemGroup>

    <Target Name="CopyCatalogBoundaryOpenApiArtifacts" AfterTargets="GenerateOpenApiDocuments" Condition="'$(RefreshCatalogOpenApiArtifacts)' == 'true'">
        <ItemGroup>
            <CatalogOpenApiArtifact Include="catalog;public-catalog" />
            <GeneratedOpenApiArtifact Include="@(CatalogOpenApiArtifact)">
                <SourcePath>$(OpenApiDocumentsDirectory)/$(AssemblyName)_%(Identity).json</SourcePath>
                <TargetPath>$(MSBuildProjectDirectory)/../ViajantesTurismo.Catalog.Contracts.Http/OpenApi/%(Identity).openapi.json</TargetPath>
            </GeneratedOpenApiArtifact>
        </ItemGroup>

        <MakeDir Directories="$(MSBuildProjectDirectory)/../ViajantesTurismo.Catalog.Contracts.Http/OpenApi" />
        <Copy
            SourceFiles="@(GeneratedOpenApiArtifact->'%(SourcePath)')"
            DestinationFiles="@(GeneratedOpenApiArtifact->'%(TargetPath)')"
            SkipUnchangedFiles="true" />
    </Target>

</Project>
