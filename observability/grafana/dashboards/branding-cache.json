{
  "annotations": {
    "list": []
  },
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "What this dashboard is for",
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "**Purpose:** Effectiveness and freshness of the public Branding cache.\n\n**Audience:** Developers of the public site and Branding module.\n\n**Decision supported:** Whether the cache serves hits, invalidations succeed, and instances run on the latest Branding revision.\n"
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Cache hit ratio",
      "description": "branding_cache_requests_total hits divided by all requests (ratio). Question: is the cache effective?",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "verify": "data",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "sum(rate(branding_cache_requests_total{outcome=\"hit\"}[$__rate_interval])) / clamp_min(sum(rate(branding_cache_requests_total[$__rate_interval])), 0.001)",
          "legendFormat": "hit ratio",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Cache requests by outcome",
      "description": "branding_cache_requests_total in requests/s by bounded outcome. Question: how are public requests served?",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "verify": "data",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "sum by (outcome) (rate(branding_cache_requests_total[$__rate_interval]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Invalidations by outcome",
      "description": "branding_cache_invalidations_total in invalidations/s by bounded outcome. Question: do invalidations succeed?",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "verify": "idle-ok",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "sum by (outcome) (rate(branding_cache_invalidations_total[$__rate_interval]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Source revision per instance",
      "description": "branding_settings_source_revision (revision number) per instance. Question: do all instances converge on the same revision?",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "verify": "data",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "max by (exported_instance) (branding_settings_source_revision)",
          "legendFormat": "{{exported_instance}}",
          "refId": "A"
        }
      ]
    }
  ],
