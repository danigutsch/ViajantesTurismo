{
  "annotations": {
    "list": []
  },
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "What this dashboard is for",
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "**Purpose:** Monitor Admin booking and tour commands dispatched through SharedKernel.Mediator.\n\n**Audience:** Developers and operators of the Admin API.\n\n**Decision supported:** Identify commands with exceptions or slow dispatch. The Failed mediator results panel on the Traces dashboard shows domain failures such as a booking returning 404.\n"
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Requests by outcome",
      "description": "mediator_requests_total in requests/s by mediator_outcome (success, cancelled, error). Success includes commands that return a failed Result. Question: do commands return, cancel, or throw an exception?",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "verify": "data",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "sum by (mediator_outcome) (rate(mediator_requests_total{otel_scope_name=\"SharedKernel.Mediator\"}[$__rate_interval]))",
          "legendFormat": "{{mediator_outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Request exception ratio",
      "description": "mediator_requests_total with outcome error divided by all dispatched requests (percent). Shows 0% when requests are active and no exceptions are observed. Question: what share of requests throws an exception?",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "verify": "idle-ok",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "(sum(rate(mediator_requests_total{otel_scope_name=\"SharedKernel.Mediator\",mediator_outcome=\"error\"}[$__rate_interval])) or vector(0)) / (sum(rate(mediator_requests_total{otel_scope_name=\"SharedKernel.Mediator\"}[$__rate_interval])) > 0)",
          "legendFormat": "exception ratio",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Requests by request name",
      "description": "mediator_requests_total in requests/s by mediator_request_name (a command type name). Question: which commands carry the traffic?",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "verify": "data",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "sum by (mediator_request_name) (rate(mediator_requests_total{otel_scope_name=\"SharedKernel.Mediator\"}[$__rate_interval]))",
          "legendFormat": "{{mediator_request_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "p95 request duration by request name",
      "description": "mediator_request_duration_milliseconds p95 in ms by mediator_request_name. Question: which command is slow?",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "verify": "data",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, mediator_request_name) (rate(mediator_request_duration_milliseconds_bucket{otel_scope_name=\"SharedKernel.Mediator\"}[$__rate_interval])))",
          "legendFormat": "{{mediator_request_name}}",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "1m",
  "schemaVersion": 41,
