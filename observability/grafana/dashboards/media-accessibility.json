  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "What this dashboard is for",
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "**Purpose:** Tracks AI-assisted image accessibility text: generation attempts and results, evaluation quality, publication blockers and the human review queue.\n\n**Audience:** Content editors and developers of the media workflow.\n\n**Decision supported:** Whether generation works, how long it takes, what blocks publication, and whether reviews are waiting too long.\n"
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Generation attempts and completions",
      "description": "catalog_media_accessibility_generation_attempts_total and catalog_media_accessibility_generation_completed_total in operations/s. Question: do attempts finish?",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "verify": "idle-ok",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "sum(rate(catalog_media_accessibility_generation_attempts_total[$__rate_interval]))",
          "legendFormat": "attempts",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "sum(rate(catalog_media_accessibility_generation_completed_total[$__rate_interval]))",
          "legendFormat": "completed",
          "refId": "B"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "p95 generation duration",
      "description": "histogram_quantile(0.95) of catalog_media_accessibility_generation_duration_seconds in seconds. Question: is generation slow?",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "verify": "idle-ok",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(catalog_media_accessibility_generation_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
