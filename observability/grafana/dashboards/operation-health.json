      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "sum by (sharedkernel_bff_session_ticket_operation) ((increase(sharedkernel_bff_session_ticket_failures_total[10m]) > 0) or (sharedkernel_bff_session_ticket_failures_total unless sharedkernel_bff_session_ticket_failures_total offset 10m))",
          "legendFormat": "{{sharedkernel_bff_session_ticket_operation}}",
          "refId": "A"
        }
      ]
