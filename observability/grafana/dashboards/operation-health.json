{
  "annotations": {
    "list": []
  },
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "What this dashboard is for",
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "**Purpose**\n\nTrack customer imports, Catalog media intake, malware scans, and Management Web session ticket failures.\n\n**Audience**\n\nOperators and developers supporting the management workflows.\n\n**Decision supported**\n\nDistinguish input rejections from dependency failures, find services with slow or failing scans, and see whether session failures came from protection or cache operations.\n"
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Customer import attempts by outcome",
      "description": "admin_customer_import_attempts_total in attempts per second. Are imports completing, being rejected, failing, or being canceled?",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "verify": "idle-ok",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "sum by (import_operation, import_outcome) (rate(admin_customer_import_attempts_total[$__rate_interval]))",
          "legendFormat": "{{import_operation}} · {{import_outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Customer import p95 by file size",
      "description": "admin_customer_import_duration_seconds in seconds. Which file size buckets take longer to process for successful imports and commits?",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "verify": "idle-ok",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, import_operation, import_size_bucket) (rate(admin_customer_import_duration_seconds_bucket{import_outcome=\"completed\"}[$__rate_interval])))",
          "legendFormat": "{{import_operation}} · {{import_size_bucket}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
