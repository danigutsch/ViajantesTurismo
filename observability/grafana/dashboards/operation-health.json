    {
      "id": 6,
      "type": "timeseries",
      "title": "Session ticket failures by operation",
      "description": "sharedkernel_bff_session_ticket_failures_total by operation in the last ten minutes. Are ticket-protection errors or cache failures disrupting Management Web sessions?",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "verify": "idle-ok",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
