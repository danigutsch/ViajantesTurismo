  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "What this dashboard is for",
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "**Purpose:** Follows Catalog work from integration event intake through idempotency, event-stream updates and projections to media object reconciliation.\n\n**Audience:** Developers and operators of the Catalog bounded context.\n\n**Decision supported:** Whether the public catalog is falling behind the Admin source of truth, and which stage (intake, dedupe, stream, projection, reconciliation) is failing.\n"
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Integration events by outcome",
      "description": "catalog_integration_event_total in events/s by bounded outcome (success, skipped, error). Question: are Admin events being handled?",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "verify": "data",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "sum by (catalog_outcome) (rate(catalog_integration_event_total[$__rate_interval]))",
          "legendFormat": "{{catalog_outcome}}",
          "refId": "A"
        }
      ]
    },
