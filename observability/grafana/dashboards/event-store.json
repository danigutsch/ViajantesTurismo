  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "What this dashboard is for",
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "**Purpose:** Latency and volume of event-stream appends, loads and projection checkpoints, plus optimistic-concurrency conflicts.\n\n**Audience:** Developers of event-sourced modules.\n\n**Decision supported:** Whether the event store is slow, contended or failing, independent of the Npgsql pool and server views.\n"
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "p95 append duration",
      "description": "histogram_quantile(0.95) of eventsourcing_postgresql_append_duration_milliseconds in milliseconds. Question: is append slower than expected?",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "verify": "data",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, exported_job) (rate(eventsourcing_postgresql_append_duration_milliseconds_bucket[$__rate_interval])))",
          "legendFormat": "{{exported_job}}",
          "refId": "A"
        }
      ]
    },
