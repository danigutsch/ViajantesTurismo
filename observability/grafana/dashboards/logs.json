{
  "annotations": {
    "list": []
  },
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "What this dashboard is for",
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "**Purpose:** Application logs by service and severity, with navigation to traces through trace ids. The Collector removes credential-like resource attributes only; log records carry no personal data by application contract, not by gateway enforcement.\n\n**Audience:** Developers and operators investigating a fault.\n\n**Decision supported:** Which service is logging errors, how often, and which trace to open next.\n"
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Log volume by severity",
      "description": "Log records per second by severity (records/s). Question: did logging volume or error share change?",
      "datasource": {
        "type": "loki",
        "uid": "Loki"
      },
      "verify": "data",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "Loki"
          },
          "expr": "sum by (detected_level) (count_over_time({service_name=~\".+\"} [$__auto]))",
          "legendFormat": "{{detected_level}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Error and critical logs by service",
      "description": "Error and critical log records by service (records per interval). Question: which service is logging errors?",
      "datasource": {
        "type": "loki",
        "uid": "Loki"
      },
      "verify": "idle-ok",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "Loki"
          },
          "expr": "sum by (service_name) (count_over_time({service_name=~\".+\"} | detected_level=~\"(?i)error|critical\" [$__auto]))",
          "legendFormat": "{{service_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "logs",
      "title": "Recent warnings and errors",
      "description": "Latest warning, error and critical log lines. Message templates are static by application contract; the gateway does not scrub log records.",
      "datasource": {
        "type": "loki",
        "uid": "Loki"
      },
      "verify": "idle-ok",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "Loki"
          },
          "expr": "{service_name=~\".+\"} | detected_level=~\"(?i)warn|warning|error|critical\"",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "logs",
      "title": "Recent logs",
      "description": "Latest log lines from all services. Use a record's trace id to open the trace in Tempo.",
      "datasource": {
        "type": "loki",
        "uid": "Loki"
      },
      "verify": "data",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "Loki"
          },
          "expr": "{service_name=~\".+\"}",
          "refId": "A"
        }
      ]
    }
  ],
