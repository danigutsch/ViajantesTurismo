{
  "annotations": {
    "list": []
  },
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "What this dashboard is for",
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "**Purpose:** Fast yes/no: is the local telemetry pipeline scraped and are the applications reporting?\n\n**Audience:** Developers starting the local stack.\n\n**Decision supported:** Whether to debug the stack (Collector or Prometheus down) or the application.\n"
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "OTel Collector scrape status",
      "description": "up (1 = scraped, 0 = down) per Prometheus scrape job. Question: is Prometheus reaching the Collector exporter and its self-telemetry?",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "verify": "data",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "up",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Reporting services",
      "description": "Count of distinct HTTP-serving services that exported request metrics in the last 5 minutes (services); workers without a web server are not counted. Question: are the applications sending telemetry through the gateway?",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "verify": "data",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "count(count by (exported_job) (http_server_request_duration_seconds_count))",
          "legendFormat": "services",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "1m",
