  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "What this dashboard is for",
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "**Purpose:** Request health for the Admin, Catalog and Management.Web hosts: rate, errors, latency, auth outcomes, rate limiting, unhandled exceptions, handled UI failures and outbound client calls.\n\n**Audience:** Developers and operators of the application hosts.\n\n**Decision supported:** Whether an incident is a server fault (5xx, unhandled exceptions), an access problem (auth, rate limits), a UI fault, or a dependency fault (client calls).\n"
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Requests per second by status class",
      "description": "http_server_request_duration_seconds_count rate in requests/s grouped by service and status class. Question: how much traffic does each service serve and how much fails?",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "verify": "data",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "sum by (exported_job, http_response_status_code) (rate(http_server_request_duration_seconds_count{exported_job=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{exported_job}} {{http_response_status_code}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "5xx ratio",
      "description": "Share of responses with status 5xx (ratio, 0 to 1). Question: are server errors above normal?",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "verify": "idle-ok",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "sum by (exported_job) (rate(http_server_request_duration_seconds_count{exported_job=~\"$service\",http_response_status_code=~\"5..\"}[$__rate_interval])) / clamp_min(sum by (exported_job) (rate(http_server_request_duration_seconds_count{exported_job=~\"$service\"}[$__rate_interval])), 0.001)",
          "legendFormat": "{{exported_job}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "p95 request latency",
      "description": "histogram_quantile(0.95) of http_server_request_duration_seconds in seconds. Question: are requests slower than expected?",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
