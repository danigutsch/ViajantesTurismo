    {
      "id": 6,
      "type": "table",
      "title": "Mediator spans",
      "description": "Tempo mediator.send and command spans with duration in ns. Which Admin commands dispatch slowly, throw, or cancel?",
      "datasource": {
        "type": "tempo",
        "uid": "Tempo"
      },
      "verify": "data",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 41
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": ["time", "name", "duration", "mediator.request.name", "mediator.outcome"]
            }
          }
        }
      ],
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "Tempo"
          },
          "queryType": "traceql",
          "query": "{ instrumentation:name = \"SharedKernel.Mediator\" && (name = \"mediator.send\" || span.sharedkernel.mediator.outcome != nil) } | select(name, span.sharedkernel.mediator.request.name, span.sharedkernel.mediator.outcome)",
