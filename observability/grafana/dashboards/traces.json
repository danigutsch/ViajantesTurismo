      "title": "What this dashboard is for",
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "**Purpose:** Trace search over sanitized spans (span events dropped, status descriptions cleared). Tempo here has no metrics generator, so views are searches, not rates.\n\n**Audience:** Developers investigating latency or failures.\n\n**Decision supported:** Which recent traces failed or were slow, so they can be opened for detail.\n"
      }
    },
    {
      "id": 2,
      "type": "table",
      "title": "Recent error traces",
      "description": "Traces containing a span with error status. Question: which requests failed?",
      "datasource": {
        "type": "tempo",
        "uid": "Tempo"
      },
      "verify": "idle-ok",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "Tempo"
          },
          "queryType": "traceql",
          "query": "{ status = error }",
          "limit": 20,
          "refId": "A"
        }
      ]
    },
