  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "What this dashboard is for",
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "**Purpose:** Shows whether the privacy-gateway Collector is receiving, sanitizing, and forwarding telemetry. The gateway is fail-closed (error_mode: propagate), so a rejected payload means lost telemetry rather than leaked data.\n\n**Audience:** Developers and operators of the telemetry pipeline.\n\n**Decision supported:** Whether missing telemetry is caused by gateway rejection or exporter failure, and whether privacy processors are failing.\n"
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Receiver accepted vs refused spans",
      "description": "otelcol_receiver_accepted_spans_total and otelcol_receiver_refused_spans_total in spans/s. Question: is the gateway accepting spans, and is any payload refused (for example by a failing privacy processor)?",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "verify": "data",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "sum(rate(otelcol_receiver_accepted_spans_total[$__rate_interval]))",
          "legendFormat": "accepted",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "sum(rate(otelcol_receiver_refused_spans_total[$__rate_interval])) or vector(0)",
          "legendFormat": "refused",
          "refId": "B"
        }
      ]
    },
